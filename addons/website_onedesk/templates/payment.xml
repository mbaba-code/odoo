<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ========================= -->
    <!-- PAYMENT TEST PAGE (MODE TEST) -->
    <!-- ========================= -->
    <template id="payment_test_page" name="Payment Test Page">
        <t t-call="website.layout">
            <div class="container mt-5 mb-5">
                <div class="row">
                    <div class="col-lg-6 mx-auto">
                        <!-- Test Mode Alert - TRÈS VISIBLE -->
                        <div class="alert alert-warning mb-4" style="border: 3px solid #ff9800; background-color: #fff3cd;">
                            <h4 class="alert-heading text-center mb-3" style="font-size: 24px; font-weight: bold;">
                                <i class="fa fa-flask"></i> 🧪 MODE TEST ACTIVÉ 🧪
                            </h4>
                            <hr/>
                            <p class="mb-2" style="font-size: 16px;">
                                <strong>⚠️ SIMULATION DE PAIEMENT</strong>
                            </p>
                            <ul class="mb-0">
                                <li>Aucune transaction bancaire réelle ne sera effectuée</li>
                                <li>Vous pouvez tester le workflow complet sans risque</li>
                                <li>Cliquez sur "Valider" pour simuler un paiement réussi</li>
                                <li>Cliquez sur "Refuser" pour simuler un échec</li>
                            </ul>
                        </div>

                        <!-- Payment Summary -->
                        <div class="card border-0 shadow-lg">
                            <div class="card-header bg-primary text-white">
                                <h4 class="mb-0">
                                    <i class="fa fa-credit-card"></i> Simulation de Paiement
                                </h4>
                            </div>
                            <div class="card-body">
                                <h5 class="mb-3">Résumé de votre souscription</h5>

                                <div class="mb-3">
                                    <strong>Plan:</strong>
                                    <span class="float-end" t-esc="plan.name"></span>
                                </div>

                                <div class="mb-3">
                                    <strong>Souscription:</strong>
                                    <span class="float-end" t-esc="subscription.subscription_id"></span>
                                </div>

                                <hr/>

                                <div class="mb-4">
                                    <h3 class="text-center mb-0">
                                        <strong>Prix mensuel:</strong>
                                        <span class="text-success" t-esc="'{:.2f}€'.format(amount)"></span>
                                    </h3>
                                    <p class="text-center text-muted small mb-0">Facturation mensuelle</p>
                                </div>

                                <hr/>

                                <p class="text-muted small mb-4">
                                    En mode TEST, vous pouvez simuler un paiement réussi ou échoué pour tester le workflow complet.
                                </p>

                                <!-- Test Actions -->
                                <div class="d-grid gap-2">
                                    <button type="button" class="btn btn-success btn-lg" onclick="simulatePayment('success')">
                                        <i class="fa fa-check-circle"></i> ✅ Valider le Paiement (TEST)
                                    </button>
                                    <button type="button" class="btn btn-danger" onclick="simulatePayment('fail')">
                                        <i class="fa fa-times-circle"></i> ❌ Simuler un Échec (TEST)
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="text-center mt-4">
                            <a href="/onedesk/subscription" class="btn btn-link">
                                <i class="fa fa-arrow-left"></i> Retour aux plans
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- JavaScript for Test Payment -->
            <script>
                function simulatePayment(action) {
                    const button = event.target;
                    button.disabled = true;
                    button.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Traitement...';

                    const formData = new FormData();
                    formData.append('subscription_id', <t t-esc="subscription.id"/>);
                    formData.append('action', action);

                    fetch('/onedesk/payment/test/simulate', {
                        method: 'POST',
                        body: formData
                    })
                    .then(response => response.json())
                    .then(data => {
                        console.log('Payment simulation response:', data);
                        if (data.status === 'success') {
                            window.location.href = data.redirect_url || '/onedesk/payment/success';
                        } else {
                            window.location.href = data.redirect_url || '/onedesk/payment/error';
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        alert('Une erreur s\'est produite: ' + error.message);
                        button.disabled = false;
                        button.innerHTML = action === 'success' ? '✅ Valider le Paiement (TEST)' : '❌ Simuler un Échec (TEST)';
                    });
                }
            </script>
        </t>
    </template>

    <!-- ========================= -->
    <!-- PAYMENT PAGE (MODE PROD) -->
    <!-- ========================= -->
    <template id="payment_page" name="Payment Page (Legacy)">
        <t t-call="website.layout">
            <div class="container mt-5 mb-5">
                <div class="row">
                    <div class="col-lg-6 mx-auto">
                        <!-- Production Mode Alert -->
                        <div class="alert alert-success mb-4" style="border: 2px solid #28a745;">
                            <h4 class="alert-heading text-center mb-2">
                                <i class="fa fa-lock"></i> 💳 PAIEMENT SÉCURISÉ
                            </h4>
                            <p class="text-center mb-0">
                                <small>Transaction bancaire sécurisée par SSL</small>
                            </p>
                        </div>

                        <!-- Payment Summary -->
                        <div class="card border-0 shadow-lg">
                            <div class="card-header bg-success text-white">
                                <h4 class="mb-0">
                                    <i class="fa fa-credit-card"></i> Paiement
                                </h4>
                            </div>
                            <div class="card-body">
                                <h5 class="mb-3">Résumé de votre souscription</h5>

                                <div class="mb-3">
                                    <strong>Plan:</strong>
                                    <span class="float-end" t-esc="plan.name"></span>
                                </div>

                                <div class="mb-3">
                                    <strong>Souscription:</strong>
                                    <span class="float-end" t-esc="subscription.subscription_id"></span>
                                </div>

                                <hr/>

                                <div class="mb-4">
                                    <h3 class="text-center mb-0">
                                        <strong>Prix mensuel:</strong>
                                        <span class="text-success" t-esc="'{:.2f}€'.format(amount)"></span>
                                    </h3>
                                    <p class="text-center text-muted small mb-0">Facturation mensuelle</p>
                                </div>

                                <hr/>

                                <div class="d-grid">
                                    <button type="button" class="btn btn-success btn-lg" onclick="initializePayment()">
                                        <i class="fa fa-credit-card"></i> Payer maintenant
                                    </button>
                                </div>

                                <p class="text-muted small text-center mt-3">
                                    <i class="fa fa-lock"></i> Paiement sécurisé par SSL
                                </p>

                                <!-- Payment Provider Integration Area -->
                                <div id="payment-provider-container" class="mt-4"></div>
                            </div>
                        </div>

                        <div class="text-center mt-4">
                            <a href="/onedesk/subscription" class="btn btn-link">
                                <i class="fa fa-arrow-left"></i> Retour aux plans
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ========================= -->
    <!-- PAYMENT PAGE PROD - WITH ODOO PAYMENT FORM -->
    <!-- ========================= -->
    <template id="payment_page_prod" name="Payment Page Production">
        <t t-call="website.layout">
            <div class="container mt-5 mb-5">
                <div class="row">
                    <div class="col-lg-8 mx-auto">
                        <!-- Production Mode Alert -->
                        <div class="alert alert-success mb-4" style="border: 2px solid #28a745;">
                            <h4 class="alert-heading text-center mb-2">
                                <i class="fa fa-lock"></i> 💳 PAIEMENT SÉCURISÉ
                            </h4>
                            <p class="text-center mb-0">
                                <small>Transaction bancaire sécurisée par SSL</small>
                            </p>
                        </div>

                        <div class="row">
                            <!-- Left Column: Payment Summary -->
                            <div class="col-md-5">
                                <div class="card border-0 shadow-sm mb-4">
                                    <div class="card-header bg-success text-white">
                                        <h5 class="mb-0">
                                            <i class="fa fa-file-text"></i> Résumé
                                        </h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="mb-3">
                                            <strong>Plan:</strong>
                                            <div class="text-muted" t-esc="plan.name"></div>
                                        </div>

                                        <div class="mb-3">
                                            <strong>Souscription:</strong>
                                            <div class="text-muted" t-esc="subscription.subscription_id"></div>
                                        </div>

                                        <hr/>

                                        <div class="mb-0">
                                            <h4 class="text-center mb-0">
                                                <strong>Prix mensuel:</strong>
                                            </h4>
                                            <h2 class="text-center text-success mb-1" t-esc="'{:.2f}€'.format(amount)"></h2>
                                            <p class="text-center text-muted small mb-0">Facturation mensuelle</p>
                                        </div>
                                    </div>
                                </div>

                                <div class="card border-0 bg-light">
                                    <div class="card-body">
                                        <h6 class="mb-2">
                                            <i class="fa fa-shield"></i> Paiement sécurisé
                                        </h6>
                                        <p class="small text-muted mb-0">
                                            Toutes les transactions sont sécurisées et cryptées.
                                            Vos informations bancaires sont protégées.
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <!-- Right Column: Payment Form -->
                            <div class="col-md-7">
                                <div class="card border-0 shadow-lg">
                                    <div class="card-header bg-primary text-white">
                                        <h5 class="mb-0">
                                            <i class="fa fa-credit-card"></i> Choisir un moyen de paiement
                                        </h5>
                                    </div>
                                    <div class="card-body">
                                        <!-- Odoo Payment Form -->
                                        <t t-call="payment.form">
                                            <t t-set="mode" t-value="'payment'"/>
                                            <t t-set="reference_prefix" t-value="reference_prefix"/>
                                            <t t-set="amount" t-value="amount"/>
                                            <t t-set="currency" t-value="currency"/>
                                            <t t-set="partner_id" t-value="partner_id"/>
                                            <t t-set="providers_sudo" t-value="providers_sudo"/>
                                            <t t-set="payment_methods_sudo" t-value="payment_methods_sudo"/>
                                            <t t-set="tokens_sudo" t-value="tokens_sudo"/>
                                            <t t-set="transaction_route" t-value="transaction_route"/>
                                            <t t-set="landing_route" t-value="landing_route"/>
                                            <t t-set="submit_button_label" t-value="'Payer maintenant'"/>
                                        </t>
                                    </div>
                                </div>

                                <div class="text-center mt-4">
                                    <a href="/onedesk/subscription" class="btn btn-link">
                                        <i class="fa fa-arrow-left"></i> Retour aux plans
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ========================= -->
    <!-- PAYMENT SUCCESS PAGE -->
    <!-- ========================= -->
    <template id="payment_success" name="Payment Success">
        <t t-call="website.layout">
            <div class="container mt-5 mb-5">
                <div class="row">
                    <div class="col-lg-6 mx-auto text-center">
                        <div class="card border-0 shadow-lg">
                            <div class="card-body p-5">
                                <div class="mb-4">
                                    <i class="fa fa-check-circle text-success" style="font-size: 80px;"></i>
                                </div>

                                <h1 class="text-success mb-3">Paiement Réussi !</h1>

                                <p class="lead mb-4">
                                    Votre paiement a été validé avec succès.
                                </p>

                                <div class="alert alert-success">
                                    <p class="mb-0">
                                        <i class="fa fa-envelope"></i>
                                        Un email de confirmation vous a été envoyé avec vos identifiants de connexion.
                                    </p>
                                </div>

                                <hr/>

                                <h5 class="mb-3">Prochaines étapes</h5>
                                <ol class="text-start">
                                    <li>Vérifiez votre boîte email</li>
                                    <li>Connectez-vous avec vos identifiants</li>
                                    <li>Configurez votre première propriété</li>
                                </ol>

                                <div class="d-grid gap-2 mt-4">
                                    <a href="/web/login" class="btn btn-primary btn-lg">
                                        <i class="fa fa-sign-in"></i> Se connecter maintenant
                                    </a>
                                    <a href="/" class="btn btn-outline-secondary">
                                        <i class="fa fa-home"></i> Retour à l'accueil
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ========================= -->
    <!-- PAYMENT ERROR PAGE -->
    <!-- ========================= -->
    <template id="payment_error" name="Payment Error">
        <t t-call="website.layout">
            <div class="container mt-5 mb-5">
                <div class="row">
                    <div class="col-lg-6 mx-auto text-center">
                        <div class="card border-0 shadow-lg">
                            <div class="card-body p-5">
                                <div class="mb-4">
                                    <i class="fa fa-times-circle text-danger" style="font-size: 80px;"></i>
                                </div>

                                <h1 class="text-danger mb-3">Erreur de Paiement</h1>

                                <p class="lead mb-4">
                                    Le paiement n'a pas pu être effectué.
                                </p>

                                <div class="alert alert-danger">
                                    <p class="mb-0">
                                        <i class="fa fa-exclamation-triangle"></i>
                                        Votre compte n'a pas été activé. Veuillez réessayer le paiement.
                                    </p>
                                </div>

                                <hr/>

                                <h5 class="mb-3">Que faire ?</h5>
                                <ul class="text-start">
                                    <li>Vérifiez vos informations de paiement</li>
                                    <li>Assurez-vous d'avoir les fonds suffisants</li>
                                    <li>Contactez notre support si le problème persiste</li>
                                </ul>

                                <div class="d-grid gap-2 mt-4">
                                    <a href="/onedesk/subscription" class="btn btn-primary btn-lg">
                                        <i class="fa fa-refresh"></i> Réessayer
                                    </a>
                                    <a href="mailto:support@onedesk.com" class="btn btn-outline-secondary">
                                        <i class="fa fa-envelope"></i> Contacter le support
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ========================= -->
    <!-- PAYMENT PENDING PAGE -->
    <!-- ========================= -->
    <template id="payment_pending" name="Payment Pending">
        <t t-call="website.layout">
            <div class="container mt-5 mb-5">
                <div class="row">
                    <div class="col-lg-6 mx-auto text-center">
                        <div class="card border-0 shadow-lg">
                            <div class="card-body p-5">
                                <div class="mb-4">
                                    <i class="fa fa-clock-o text-warning" style="font-size: 80px;"></i>
                                </div>

                                <h1 class="text-warning mb-3">Paiement en Attente</h1>

                                <p class="lead mb-4">
                                    Votre paiement est en cours de traitement.
                                </p>

                                <div class="alert alert-warning">
                                    <p class="mb-0">
                                        <i class="fa fa-info-circle"></i>
                                        Nous vous enverrons un email dès que le paiement sera validé.
                                    </p>
                                </div>

                                <hr/>

                                <h5 class="mb-3">Que se passe-t-il maintenant ?</h5>
                                <p class="text-muted">
                                    Votre paiement est en cours de validation auprès de votre banque.
                                    Cela peut prendre quelques minutes à quelques heures.
                                </p>

                                <p class="text-muted">
                                    Vous recevrez un email de confirmation dès que le paiement sera validé
                                    et votre compte sera automatiquement activé.
                                </p>

                                <div class="d-grid gap-2 mt-4">
                                    <a href="/" class="btn btn-primary btn-lg">
                                        <i class="fa fa-home"></i> Retour à l'accueil
                                    </a>
                                    <a href="mailto:support@onedesk.com" class="btn btn-outline-secondary">
                                        <i class="fa fa-envelope"></i> Contacter le support
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
