<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ========================= -->
    <!-- PAGE D'ACCUEIL / LISTING -->
    <!-- ========================= -->
    <template id="properties_list" name="Property Listing">
        <t t-call="website.layout">
            <div class="container mt-5">
                <div class="row">
                    <div class="col-lg-8">
                        <h1 class="mb-4">🏠 Nos Propriétés</h1>
                        <p class="lead text-muted">Décourez notre sélection de propriétés exceptionnelles</p>
                    </div>
                    <div class="col-lg-4 text-end">
                        <a href="/onedesk/properties" class="btn btn-primary">Toutes les propriétés</a>
                    </div>
                </div>

                <div class="row mt-5">
                    <t t-foreach="properties" t-as="property">
                        <div class="col-lg-4 col-md-6 mb-4">
                            <div class="card h-100 shadow-sm hover-shadow">
                                <!-- Image placeholder -->
                                <div style="height: 250px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); display: flex; align-items: center; justify-content: center;">
                                    <i class="fa fa-home fa-3x text-white"></i>
                                </div>

                                <div class="card-body">
                                    <h5 class="card-title" t-esc="property.name"></h5>
                                    <p class="card-text text-muted">
                                        <i class="fa fa-map-marker"></i>
                                        <t t-esc="property.address"></t>
                                    </p>

                                    <!-- Stats -->
                                    <div class="row text-center mt-3">
                                        <div class="col-6">
                                            <small class="text-muted">Unités</small>
                                            <div class="h6" t-esc="property.total_units"></div>
                                        </div>
                                        <div class="col-6">
                                            <small class="text-muted">Occupé</small>
                                            <div class="h6">
                                                <t t-esc="'{:.0f}%'.format(property.total_occupancy_percentage)"></t>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Type badge -->
                                    <div class="mt-3">
                                        <span class="badge bg-primary" t-esc="dict(property._fields['property_type'].selection).get(property.property_type, 'N/A')"></span>
                                    </div>
                                </div>

                                <div class="card-footer bg-white border-top-0">
                                    <a t-attf-href="/onedesk/property/{{ property.id }}" class="btn btn-sm btn-outline-primary w-100">
                                        Voir les détails →
                                    </a>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>

                <!-- Unités importées orphelines (sans propriété) -->
                <t t-if="orphaned_units">
                    <div class="row mt-5">
                        <div class="col-lg-12">
                            <h3 class="mb-4">📥 Unités Importées</h3>
                            <p class="text-muted">Listings synchronisés depuis nos partenaires</p>
                        </div>
                    </div>
                    <div class="row">
                        <t t-foreach="orphaned_units" t-as="unit">
                            <div class="col-lg-4 col-md-6 mb-4">
                                <div class="card h-100 shadow-sm hover-shadow">
                                    <!-- Image placeholder -->
                                    <div style="height: 250px; background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); display: flex; align-items: center; justify-content: center;">
                                        <i class="fa fa-list fa-3x text-white"></i>
                                    </div>

                                    <div class="card-body">
                                        <h5 class="card-title" t-esc="unit.name"></h5>
                                        <p class="card-text text-muted">
                                            <i class="fa fa-users"></i>
                                            Capacité: <t t-esc="unit.capacity"/> personnes
                                        </p>

                                        <!-- Stats -->
                                        <div class="row text-center mt-3">
                                            <div class="col-6">
                                                <small class="text-muted">Chambres</small>
                                                <div class="h6" t-esc="unit.bedrooms"></div>
                                            </div>
                                            <div class="col-6">
                                                <small class="text-muted">Tarif/nuit</small>
                                                <div class="h6" t-esc="'{}€'.format(int(unit.price_per_night))"></div>
                                            </div>
                                        </div>

                                        <!-- Badge importé -->
                                        <div class="mt-3">
                                            <span class="badge bg-success">✓ Importé</span>
                                        </div>
                                    </div>

                                    <div class="card-footer bg-white border-top-0">
                                        <a t-attf-href="/onedesk/unit/{{ unit.id }}" class="btn btn-sm btn-outline-primary w-100">
                                            Réserver →
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </t>

                <!-- Message si pas de propriétés ni unités -->
                <t t-if="not properties and not orphaned_units">
                    <div class="alert alert-info text-center mt-5">
                        <p>Aucune propriété disponible pour le moment.</p>
                    </div>
                </t>
            </div>
        </t>
    </template>

    <!-- ========================= -->
    <!-- PAGE DÉTAIL PROPRIÉTÉ -->
    <!-- ========================= -->
    <template id="property_detail" name="Property Detail">
        <t t-call="website.layout">
            <div class="container mt-5">
                <!-- Header -->
                <div class="row mb-5">
                    <div class="col-lg-8">
                        <h1 t-esc="property.name"></h1>
                        <p class="lead text-muted">
                            <i class="fa fa-map-marker"></i>
                            <t t-esc="property.address"></t>
                        </p>
                    </div>
                    <div class="col-lg-4 text-end">
                        <div class="card bg-light">
                            <div class="card-body">
                                <p class="mb-2"><strong>Revenu ce mois:</strong></p>
                                <h3 class="text-success" t-esc="'{}€'.format(int(property.total_revenue_month))"></h3>
                                <hr/>
                                <p class="mb-0"><strong>Taux occupation:</strong> <t t-esc="'{:.0f}%'.format(property.total_occupancy_percentage)"></t></p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Description -->
                <div class="row mb-5" t-if="property.description">
                    <div class="col-lg-12">
                        <h3>À propos</h3>
                        <p t-esc="property.description"></p>
                    </div>
                </div>

                <!-- Amenities -->
                <div class="row mb-5" t-if="property.amenities">
                    <div class="col-lg-12">
                        <h3>🎯 Équipements</h3>
                        <p t-esc="property.amenities"></p>
                    </div>
                </div>

                <!-- Units listing -->
                <div class="row">
                    <div class="col-lg-12">
                        <h3 class="mb-4">🏠 Unités disponibles</h3>
                    </div>
                </div>

                <div class="row">
                    <t t-foreach="units" t-as="unit">
                        <div class="col-lg-6 mb-4">
                            <div class="card shadow-sm">
                                <div style="height: 200px; background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); display: flex; align-items: center; justify-content: center;">
                                    <i class="fa fa-door-open fa-3x text-white"></i>
                                </div>

                                <div class="card-body">
                                    <h5 class="card-title" t-esc="unit.name"></h5>

                                    <div class="row text-center my-3">
                                        <div class="col-4">
                                            <small class="text-muted">Chambres</small>
                                            <div t-esc="unit.bedrooms"></div>
                                        </div>
                                        <div class="col-4">
                                            <small class="text-muted">Salles de bain</small>
                                            <div t-esc="unit.bathrooms"></div>
                                        </div>
                                        <div class="col-4">
                                            <small class="text-muted">Capacité</small>
                                            <div t-esc="unit.capacity"></div>
                                        </div>
                                    </div>

                                    <hr/>

                                    <div class="row my-3">
                                        <div class="col-6">
                                            <p><strong>À partir de:</strong></p>
                                            <h5 class="text-primary" t-esc="'{}€/nuit'.format(int(unit.price_per_night))"></h5>
                                        </div>
                                        <div class="col-6 text-end">
                                            <p><strong>Ce mois:</strong></p>
                                            <h5 class="text-success" t-esc="'{}€'.format(int(unit.revenue_this_month))"></h5>
                                        </div>
                                    </div>

                                    <t t-if="unit.cleaning_fee > 0">
                                        <p class="small text-muted">+ <t t-esc="'{:.0f}€'.format(unit.cleaning_fee)"></t> frais de nettoyage</p>
                                    </t>
                                </div>

                                <div class="card-footer bg-white border-top-0">
                                    <a t-attf-href="/onedesk/unit/{{ unit.id }}" class="btn btn-sm btn-primary w-100">
                                        Réserver maintenant →
                                    </a>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>

                <!-- Contact section -->
                <div class="row mt-5">
                    <div class="col-lg-12">
                        <div class="card bg-primary text-white">
                            <div class="card-body text-center">
                                <h5 class="card-title">Des questions?</h5>
                                <p class="mb-3">Contactez-nous pour plus d'informations sur cette propriété</p>
                                <a href="mailto:contact@onedesk.local" class="btn btn-light">📧 Nous contacter</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ========================= -->
    <!-- PAGE DÉTAIL UNITÉ -->
    <!-- ========================= -->
    <template id="unit_detail" name="Unit Detail">
        <t t-call="website.layout">
            <div class="container mt-5">
                <!-- Breadcrumb -->
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/onedesk/properties">Propriétés</a></li>
                        <li class="breadcrumb-item"><a t-attf-href="/onedesk/property/{{ property.id }}" t-esc="property.name"></a></li>
                        <li class="breadcrumb-item active" t-esc="unit.name"></li>
                    </ol>
                </nav>

                <div class="row">
                    <div class="col-lg-8">
                        <h1 t-esc="unit.name"></h1>
                        <p class="lead text-muted">
                            <t t-esc="property.name"></t> •
                            <t t-esc="unit.bedrooms"></t> chambre(s) •
                            <t t-esc="unit.bathrooms"></t> salle(s) de bain
                        </p>

                        <!-- Unit Info Card -->
                        <div class="card mt-4 mb-4">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-4">
                                        <h6 class="text-muted">Capacité</h6>
                                        <h4 t-esc="unit.capacity"></h4>
                                    </div>
                                    <div class="col-md-4">
                                        <h6 class="text-muted">Tarif par nuit</h6>
                                        <h4 class="text-primary" t-esc="'{}€'.format(int(unit.price_per_night))"></h4>
                                    </div>
                                    <div class="col-md-4">
                                        <h6 class="text-muted">Taux occupation</h6>
                                        <h4 class="text-success" t-esc="'{:.0f}%'.format(unit.occupancy_percentage)"></h4>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Booking Form -->
                        <div class="card mt-4 mb-4">
                            <div class="card-header bg-primary text-white">
                                <h5 class="mb-0">📅 Réservez maintenant</h5>
                            </div>
                            <div class="card-body">
                                <form id="booking_form">
                                    <div class="row mb-3">
                                        <div class="col-md-6">
                                            <label for="start_date" class="form-label">Date d'arrivée</label>
                                            <input type="date" id="start_date" name="start_date" class="form-control" required="required"/>
                                        </div>
                                        <div class="col-md-6">
                                            <label for="end_date" class="form-label">Date de départ</label>
                                            <input type="date" id="end_date" name="end_date" class="form-control" required="required"/>
                                        </div>
                                    </div>

                                    <!-- Price calculation (will be updated via JS) -->
                                    <div id="price_info" class="alert alert-info" style="display: none;">
                                        <p class="mb-1"><strong>Nuits:</strong> <span id="nights">0</span></p>
                                        <p class="mb-1"><strong>Prix par nuit:</strong> <span id="price_per_night">0</span>€</p>
                                        <hr/>
                                        <p class="mb-1"><strong>Prix total:</strong> <span id="total_price" class="h5">0</span>€</p>
                                    </div>

                                    <div class="row mb-3" t-if="not reservations">
                                        <div class="col-12">
                                            <p class="text-success">✅ Cette unité est disponible pour votre période!</p>
                                        </div>
                                    </div>

                                    <div class="row mb-3">
                                        <div class="col-md-6">
                                            <label for="name" class="form-label">Nom complet</label>
                                            <input type="text" id="name" name="name" class="form-control" required="required" placeholder="Jean Dupont"/>
                                        </div>
                                        <div class="col-md-6">
                                            <label for="email" class="form-label">Email</label>
                                            <input type="email" id="email" name="email" class="form-control" required="required" placeholder="jean@example.com"/>
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <label for="phone" class="form-label">Téléphone</label>
                                        <input type="tel" id="phone" name="phone" class="form-control" placeholder="+33 6 12 34 56 78"/>
                                    </div>

                                    <div class="mb-3">
                                        <label for="message" class="form-label">Messages/Demandes spéciales</label>
                                        <textarea id="message" name="message" class="form-control" rows="3" placeholder="Ex: Lit bébé, allergies, etc."></textarea>
                                    </div>

                                    <button type="submit" class="btn btn-primary btn-lg w-100">
                                        Demander une réservation
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>

                    <!-- Sidebar -->
                    <div class="col-lg-4">
                        <!-- Amenities -->
                        <div class="card mb-4" t-if="unit.maintenance_notes">
                            <div class="card-header">
                                <h6 class="mb-0">⚙️ À savoir</h6>
                            </div>
                            <div class="card-body">
                                <p t-esc="unit.maintenance_notes"></p>
                            </div>
                        </div>

                        <!-- Cancellation policy -->
                        <div class="card mb-4">
                            <div class="card-header">
                                <h6 class="mb-0">📋 Politique d'annulation</h6>
                            </div>
                            <div class="card-body">
                                <p t-esc="dict(unit._fields['cancellation_policy'].selection).get(unit.cancellation_policy, 'N/A')"></p>
                            </div>
                        </div>

                        <!-- Minimum stay -->
                        <div class="card" t-if="unit.minimum_stay > 1">
                            <div class="card-body">
                                <p><strong>Séjour minimum:</strong> <t t-esc="unit.minimum_stay"></t> nuit(s)</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <script>
                document.getElementById('start_date').addEventListener('change', checkAvailability);
                document.getElementById('end_date').addEventListener('change', checkAvailability);

                function checkAvailability() {
                    const startDate = document.getElementById('start_date').value;
                    const endDate = document.getElementById('end_date').value;

                    if (!startDate || !endDate) return;

                    fetch('/onedesk/unit/<t t-esc="unit.id"></t>/availability', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-CSRF-Token': document.querySelector('[name=csrf_token]').value,
                        },
                        body: JSON.stringify({
                            start_date: startDate,
                            end_date: endDate,
                        })
                    })
                    .then(r => r.json())
                    .then(data => {
                        if (data.available) {
                            document.getElementById('price_info').style.display = 'block';
                            document.getElementById('nights').textContent = data.nights;
                            document.getElementById('price_per_night').textContent = data.price_per_night.toFixed(2);
                            document.getElementById('total_price').textContent = data.total_with_cleaning.toFixed(2);
                        } else {
                            document.getElementById('price_info').innerHTML = '❌ ' + data.message;
                            document.getElementById('price_info').className = 'alert alert-danger';
                            document.getElementById('price_info').style.display = 'block';
                        }
                    });
                }

                document.getElementById('booking_form').addEventListener('submit', function(e) {
                    e.preventDefault();

                    fetch('/onedesk/booking', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-CSRF-Token': document.querySelector('[name=csrf_token]').value,
                        },
                        body: JSON.stringify({
                            unit_id: <t t-esc="unit.id"></t>,
                            name: document.getElementById('name').value,
                            email: document.getElementById('email').value,
                            phone: document.getElementById('phone').value,
                            start_date: document.getElementById('start_date').value,
                            end_date: document.getElementById('end_date').value,
                            message: document.getElementById('message').value,
                        })
                    })
                    .then(r => r.json())
                    .then(data => {
                        if (data.status === 'success') {
                            alert('✅ ' + data.message + '\nVous allez recevoir un email sous peu.');
                            document.getElementById('booking_form').reset();
                        } else {
                            alert('❌ Erreur: ' + data.message);
                        }
                    });
                });
            </script>
        </t>
    </template>

</odoo>
