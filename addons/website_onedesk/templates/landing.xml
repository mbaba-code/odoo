<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Landing Page OneDesk - Page d'accueil professionnelle -->
    <template id="landing_page" name="OneDesk Landing Page">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <!-- CSS Personnalisé -->
                <style>
                    /* Palette de couleurs professionnelle douce */
                    :root {
                        --primary-blue: #5B9BD5;
                        --secondary-slate: #8FA0B3;
                        --success-green: #70AD47;
                        --accent-orange: #E89A6A;
                        --accent-red: #E07A7A;
                        --accent-purple: #9B8FC9;
                        --accent-pink: #C98DB8;
                        --light-bg: #F8F9FA;
                        --dark-text: #2C3E50;
                    }

                    /* Hero Section */
                    .onedesk-hero {
                        background: linear-gradient(135deg, var(--primary-blue) 0%, var(--secondary-slate) 100%);
                        color: white;
                        padding: 100px 0 80px;
                        text-align: center;
                        position: relative;
                        overflow: hidden;
                    }

                    .onedesk-hero::before {
                        content: '';
                        position: absolute;
                        top: 0;
                        left: 0;
                        right: 0;
                        bottom: 0;
                        background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120"><path fill="%23ffffff" fill-opacity="0.1" d="M0,96L48,80C96,64,192,32,288,32C384,32,480,64,576,69.3C672,75,768,53,864,42.7C960,32,1056,32,1152,42.7L1200,48L1200,120L1152,120C1056,120,960,120,864,120C768,120,672,120,576,120C480,120,384,120,288,120C192,120,96,120,48,120L0,120Z"></path></svg>');
                        background-size: cover;
                        background-position: bottom;
                    }

                    .onedesk-hero h1 {
                        font-size: 3.5rem;
                        font-weight: 700;
                        margin-bottom: 1.5rem;
                        animation: fadeInDown 1s ease-out;
                    }

                    .onedesk-hero p.lead {
                        font-size: 1.5rem;
                        margin-bottom: 2rem;
                        opacity: 0.95;
                        animation: fadeInUp 1s ease-out 0.2s both;
                    }

                    .onedesk-hero .cta-buttons {
                        animation: fadeInUp 1s ease-out 0.4s both;
                    }

                    .btn-hero-primary {
                        background: white;
                        color: var(--primary-blue);
                        padding: 15px 40px;
                        font-size: 1.2rem;
                        font-weight: 600;
                        border-radius: 50px;
                        border: none;
                        box-shadow: 0 4px 15px rgba(0,0,0,0.2);
                        transition: all 0.3s ease;
                        text-decoration: none;
                        display: inline-block;
                        margin: 10px;
                    }

                    .btn-hero-primary:hover {
                        transform: translateY(-3px);
                        box-shadow: 0 6px 20px rgba(0,0,0,0.3);
                        color: var(--primary-blue);
                    }

                    .btn-hero-secondary {
                        background: transparent;
                        color: white;
                        padding: 15px 40px;
                        font-size: 1.2rem;
                        font-weight: 600;
                        border-radius: 50px;
                        border: 2px solid white;
                        transition: all 0.3s ease;
                        text-decoration: none;
                        display: inline-block;
                        margin: 10px;
                    }

                    .btn-hero-secondary:hover {
                        background: white;
                        color: var(--primary-blue);
                        transform: translateY(-3px);
                    }

                    /* Animations */
                    @keyframes fadeInDown {
                        from {
                            opacity: 0;
                            transform: translateY(-30px);
                        }
                        to {
                            opacity: 1;
                            transform: translateY(0);
                        }
                    }

                    @keyframes fadeInUp {
                        from {
                            opacity: 0;
                            transform: translateY(30px);
                        }
                        to {
                            opacity: 1;
                            transform: translateY(0);
                        }
                    }

                    @keyframes fadeIn {
                        from { opacity: 0; }
                        to { opacity: 1; }
                    }

                    /* Features Section */
                    .onedesk-features {
                        padding: 80px 0;
                        background: var(--light-bg);
                    }

                    .section-title {
                        text-align: center;
                        margin-bottom: 60px;
                    }

                    .section-title h2 {
                        font-size: 2.5rem;
                        color: var(--dark-text);
                        margin-bottom: 1rem;
                        font-weight: 700;
                    }

                    .section-title p {
                        font-size: 1.2rem;
                        color: #6c757d;
                    }

                    .feature-card {
                        background: white;
                        border-radius: 15px;
                        padding: 30px;
                        margin-bottom: 30px;
                        box-shadow: 0 5px 15px rgba(0,0,0,0.08);
                        transition: all 0.3s ease;
                        height: 100%;
                    }

                    .feature-card:hover {
                        transform: translateY(-10px);
                        box-shadow: 0 10px 30px rgba(0,0,0,0.15);
                    }

                    .feature-icon {
                        width: 70px;
                        height: 70px;
                        border-radius: 15px;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        margin-bottom: 20px;
                        font-size: 2rem;
                    }

                    .feature-card h3 {
                        font-size: 1.5rem;
                        margin-bottom: 15px;
                        color: var(--dark-text);
                        font-weight: 600;
                    }

                    .feature-card p {
                        color: #6c757d;
                        line-height: 1.6;
                    }

                    /* Dashboard Preview */
                    .onedesk-dashboard-preview {
                        padding: 80px 0;
                        background: white;
                    }

                    .dashboard-mockup {
                        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
                        border-radius: 20px;
                        padding: 40px;
                        box-shadow: 0 20px 60px rgba(0,0,0,0.15);
                        margin-top: 30px;
                    }

                    .dashboard-header-mock {
                        background: linear-gradient(135deg, var(--primary-blue) 0%, var(--secondary-slate) 100%);
                        border-radius: 10px;
                        padding: 20px;
                        color: white;
                        margin-bottom: 20px;
                    }

                    .kpi-grid {
                        display: grid;
                        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
                        gap: 15px;
                        margin-top: 20px;
                    }

                    .kpi-mock {
                        background: white;
                        border-radius: 10px;
                        padding: 20px;
                        border-left: 4px solid var(--success-green);
                    }

                    .kpi-mock.blue { border-left-color: var(--primary-blue); }
                    .kpi-mock.orange { border-left-color: var(--accent-orange); }
                    .kpi-mock.purple { border-left-color: var(--accent-purple); }

                    .kpi-mock h4 {
                        font-size: 0.9rem;
                        color: #6c757d;
                        margin-bottom: 10px;
                    }

                    .kpi-mock .value {
                        font-size: 2rem;
                        font-weight: 700;
                        color: var(--dark-text);
                    }

                    /* Pricing Preview */
                    .onedesk-pricing-preview {
                        padding: 80px 0;
                        background: var(--light-bg);
                    }

                    .pricing-card-preview {
                        background: white;
                        border-radius: 15px;
                        padding: 40px 30px;
                        text-align: center;
                        box-shadow: 0 5px 15px rgba(0,0,0,0.08);
                        transition: all 0.3s ease;
                        height: 100%;
                    }

                    .pricing-card-preview:hover {
                        transform: translateY(-10px);
                        box-shadow: 0 15px 40px rgba(0,0,0,0.15);
                    }

                    .pricing-card-preview.featured {
                        border: 3px solid var(--primary-blue);
                        position: relative;
                    }

                    .pricing-badge {
                        background: var(--success-green);
                        color: white;
                        padding: 5px 20px;
                        border-radius: 20px;
                        font-size: 0.9rem;
                        font-weight: 600;
                        display: inline-block;
                        margin-bottom: 15px;
                    }

                    .pricing-card-preview h3 {
                        font-size: 1.8rem;
                        color: var(--dark-text);
                        margin-bottom: 15px;
                    }

                    .price {
                        font-size: 3rem;
                        font-weight: 700;
                        color: var(--primary-blue);
                        margin: 20px 0;
                    }

                    .price small {
                        font-size: 1.2rem;
                        color: #6c757d;
                    }

                    .pricing-features {
                        text-align: left;
                        margin: 30px 0;
                    }

                    .pricing-features li {
                        padding: 10px 0;
                        border-bottom: 1px solid #f0f0f0;
                    }

                    .btn-pricing {
                        background: var(--primary-blue);
                        color: white;
                        padding: 12px 40px;
                        border-radius: 50px;
                        border: none;
                        font-weight: 600;
                        transition: all 0.3s ease;
                        text-decoration: none;
                        display: inline-block;
                        margin-top: 20px;
                    }

                    .btn-pricing:hover {
                        background: var(--secondary-slate);
                        transform: scale(1.05);
                        color: white;
                    }

                    /* CTA Section */
                    .onedesk-cta {
                        padding: 80px 0;
                        background: linear-gradient(135deg, var(--primary-blue) 0%, var(--secondary-slate) 100%);
                        color: white;
                        text-align: center;
                    }

                    .onedesk-cta h2 {
                        font-size: 2.5rem;
                        margin-bottom: 20px;
                        font-weight: 700;
                    }

                    .onedesk-cta p {
                        font-size: 1.3rem;
                        margin-bottom: 30px;
                        opacity: 0.95;
                    }

                    /* Responsive */
                    @media (max-width: 768px) {
                        .onedesk-hero h1 { font-size: 2.5rem; }
                        .onedesk-hero p.lead { font-size: 1.2rem; }
                        .btn-hero-primary, .btn-hero-secondary {
                            padding: 12px 30px;
                            font-size: 1rem;
                        }
                        .section-title h2 { font-size: 2rem; }
                        .kpi-grid { grid-template-columns: 1fr; }
                    }

                    /* Stats Section */
                    .onedesk-stats {
                        padding: 60px 0;
                        background: white;
                    }

                    .stat-item {
                        text-align: center;
                        padding: 20px;
                    }

                    .stat-number {
                        font-size: 3rem;
                        font-weight: 700;
                        color: var(--primary-blue);
                        margin-bottom: 10px;
                    }

                    .stat-label {
                        font-size: 1.1rem;
                        color: #6c757d;
                    }
                </style>

                <!-- Hero Section -->
                <section class="onedesk-hero">
                    <div class="container">
                        <h1>🏢 OneDesk</h1>
                        <p class="lead">
                            La plateforme tout-en-un pour gérer vos propriétés,<br/>
                            conciergeries et locations courte durée
                        </p>
                        <div class="cta-buttons">
                            <a href="/onedesk/subscription" class="btn-hero-primary">
                                🚀 Démarrer Gratuitement
                            </a>
                            <a href="#features" class="btn-hero-secondary">
                                📖 Découvrir les Fonctionnalités
                            </a>
                        </div>
                    </div>
                </section>

                <!-- Stats Section -->
                <section class="onedesk-stats">
                    <div class="container">
                        <div class="row">
                            <div class="col-md-3 col-6">
                                <div class="stat-item">
                                    <div class="stat-number">6</div>
                                    <div class="stat-label">Modules Intégrés</div>
                                </div>
                            </div>
                            <div class="col-md-3 col-6">
                                <div class="stat-item">
                                    <div class="stat-number">100%</div>
                                    <div class="stat-label">Cloud &amp; Sécurisé</div>
                                </div>
                            </div>
                            <div class="col-md-3 col-6">
                                <div class="stat-item">
                                    <div class="stat-number">24/7</div>
                                    <div class="stat-label">Accès Illimité</div>
                                </div>
                            </div>
                            <div class="col-md-3 col-6">
                                <div class="stat-item">
                                    <div class="stat-number">∞</div>
                                    <div class="stat-label">Propriétés &amp; Unités</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Features Section -->
                <section class="onedesk-features" id="features">
                    <div class="container">
                        <div class="section-title">
                            <h2>✨ Fonctionnalités Complètes</h2>
                            <p>Tout ce dont vous avez besoin pour gérer vos locations comme un pro</p>
                        </div>

                        <div class="row">
                            <!-- Feature 1: Properties -->
                            <div class="col-lg-4 col-md-6">
                                <div class="feature-card">
                                    <div class="feature-icon" style="background: linear-gradient(135deg, var(--primary-blue), var(--secondary-slate));">
                                        🏢
                                    </div>
                                    <h3>Gestion de Propriétés</h3>
                                    <p>
                                        Gérez tous vos biens immobiliers en un seul endroit. Adresses,
                                        photos, équipements, documents - tout est centralisé et accessible.
                                    </p>
                                </div>
                            </div>

                            <!-- Feature 2: Units -->
                            <div class="col-lg-4 col-md-6">
                                <div class="feature-card">
                                    <div class="feature-icon" style="background: linear-gradient(135deg, var(--success-green), #90C870);">
                                        🏠
                                    </div>
                                    <h3>Unités &amp; Chambres</h3>
                                    <p>
                                        Organisez vos appartements, chambres et studios. Tarification dynamique,
                                        disponibilité en temps réel, et gestion des équipements spécifiques.
                                    </p>
                                </div>
                            </div>

                            <!-- Feature 3: Reservations -->
                            <div class="col-lg-4 col-md-6">
                                <div class="feature-card">
                                    <div class="feature-icon" style="background: linear-gradient(135deg, var(--accent-orange), #F0B080);">
                                        📅
                                    </div>
                                    <h3>Réservations</h3>
                                    <p>
                                        Calendrier intelligent, gestion des arrivées/départs, synchronisation
                                        avec les plateformes de booking, et facturation automatique.
                                    </p>
                                </div>
                            </div>

                            <!-- Feature 4: Tasks -->
                            <div class="col-lg-4 col-md-6">
                                <div class="feature-card">
                                    <div class="feature-icon" style="background: linear-gradient(135deg, var(--accent-purple), #B5A8DB);">
                                        ✅
                                    </div>
                                    <h3>Tâches Automatiques</h3>
                                    <p>
                                        Création automatique des tâches de ménage, check-in/check-out.
                                        Assignation d'équipes, notifications email, et suivi en temps réel.
                                    </p>
                                </div>
                            </div>

                            <!-- Feature 5: Documents -->
                            <div class="col-lg-4 col-md-6">
                                <div class="feature-card">
                                    <div class="feature-icon" style="background: linear-gradient(135deg, var(--accent-red), #F09090);">
                                        📄
                                    </div>
                                    <h3>Gestion Documentaire</h3>
                                    <p>
                                        Stockez et organisez tous vos documents : contrats, factures,
                                        inventaires, photos. Recherche rapide et partage sécurisé.
                                    </p>
                                </div>
                            </div>

                            <!-- Feature 6: Dashboard -->
                            <div class="col-lg-4 col-md-6">
                                <div class="feature-card">
                                    <div class="feature-icon" style="background: linear-gradient(135deg, var(--accent-pink), #D9ADCC);">
                                        📊
                                    </div>
                                    <h3>Dashboard Analytics</h3>
                                    <p>
                                        Tableaux de bord puissants avec KPIs en temps réel. Revenus,
                                        taux d'occupation, performance par propriété. Export Excel/PDF.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Dashboard Preview -->
                <section class="onedesk-dashboard-preview">
                    <div class="container">
                        <div class="section-title">
                            <h2>📊 Dashboard Puissant &amp; Intuitif</h2>
                            <p>Visualisez toutes vos données en un coup d'œil</p>
                        </div>

                        <div class="dashboard-mockup">
                            <div class="dashboard-header-mock">
                                <h3 style="margin: 0; font-size: 1.5rem;">📊 Dashboard Admin Master</h3>
                                <p style="margin: 5px 0 0 0; opacity: 0.9;">Vue globale multi-tenant - Toutes les companies</p>
                            </div>
                            <div class="kpi-grid">
                                <div class="kpi-mock purple">
                                    <h4>COMPANIES</h4>
                                    <div class="value">12</div>
                                </div>
                                <div class="kpi-mock">
                                    <h4>REVENUS TOTAUX</h4>
                                    <div class="value">125K€</div>
                                </div>
                                <div class="kpi-mock blue">
                                    <h4>PROPRIÉTÉS</h4>
                                    <div class="value">45</div>
                                </div>
                                <div class="kpi-mock orange">
                                    <h4>RÉSERVATIONS</h4>
                                    <div class="value">187</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Pricing Preview -->
                <section class="onedesk-pricing-preview">
                    <div class="container">
                        <div class="section-title">
                            <h2>💎 Plans Tarifaires Flexibles</h2>
                            <p>Choisissez le plan qui correspond à vos besoins</p>
                        </div>

                        <div class="row">
                            <!-- Starter Plan -->
                            <div class="col-lg-4 col-md-6 mb-4">
                                <div class="pricing-card-preview">
                                    <h3>🌱 Starter</h3>
                                    <div class="price">
                                        49€
                                        <small>/mois</small>
                                    </div>
                                    <ul class="pricing-features list-unstyled">
                                        <li>✅ Jusqu'à 5 propriétés</li>
                                        <li>✅ 20 unités maximum</li>
                                        <li>✅ Réservations illimitées</li>
                                        <li>✅ Dashboard basique</li>
                                        <li>✅ Support email</li>
                                    </ul>
                                    <a href="/onedesk/subscription?plan=starter" class="btn-pricing">
                                        Choisir Starter
                                    </a>
                                </div>
                            </div>

                            <!-- Professional Plan (Featured) -->
                            <div class="col-lg-4 col-md-6 mb-4">
                                <div class="pricing-card-preview featured">
                                    <span class="pricing-badge">⭐ POPULAIRE</span>
                                    <h3>💼 Professional</h3>
                                    <div class="price">
                                        99€
                                        <small>/mois</small>
                                    </div>
                                    <ul class="pricing-features list-unstyled">
                                        <li>✅ Jusqu'à 20 propriétés</li>
                                        <li>✅ 100 unités maximum</li>
                                        <li>✅ Réservations illimitées</li>
                                        <li>✅ Dashboard avancé + Analytics</li>
                                        <li>✅ Tâches automatiques</li>
                                        <li>✅ Support prioritaire</li>
                                    </ul>
                                    <a href="/onedesk/subscription?plan=professional" class="btn-pricing">
                                        Choisir Professional
                                    </a>
                                </div>
                            </div>

                            <!-- Enterprise Plan -->
                            <div class="col-lg-4 col-md-6 mb-4">
                                <div class="pricing-card-preview">
                                    <h3>🏆 Enterprise</h3>
                                    <div class="price">
                                        199€
                                        <small>/mois</small>
                                    </div>
                                    <ul class="pricing-features list-unstyled">
                                        <li>✅ Propriétés illimitées</li>
                                        <li>✅ Unités illimitées</li>
                                        <li>✅ Tout illimité</li>
                                        <li>✅ Dashboard Master Admin</li>
                                        <li>✅ Multi-tenant</li>
                                        <li>✅ API &amp; Intégrations</li>
                                        <li>✅ Support dédié 24/7</li>
                                    </ul>
                                    <a href="/onedesk/subscription?plan=enterprise" class="btn-pricing">
                                        Choisir Enterprise
                                    </a>
                                </div>
                            </div>
                        </div>

                        <div class="text-center mt-4">
                            <a href="/onedesk/subscription/plans" class="btn-hero-primary" style="background: var(--primary-blue); color: white;">
                                📋 Voir Tous les Plans en Détail
                            </a>
                        </div>
                    </div>
                </section>

                <!-- CTA Final -->
                <section class="onedesk-cta">
                    <div class="container">
                        <h2>🚀 Prêt à Transformer Votre Gestion Locative ?</h2>
                        <p>
                            Rejoignez des centaines de gestionnaires qui font confiance à OneDesk<br/>
                            pour optimiser leurs opérations et maximiser leurs revenus.
                        </p>
                        <div class="cta-buttons">
                            <a href="/onedesk/subscription" class="btn-hero-primary">
                                ✨ Commencer Maintenant - C'est Gratuit
                            </a>
                            <a href="/onedesk/properties" class="btn-hero-secondary">
                                🏢 Voir les Propriétés Disponibles
                            </a>
                        </div>
                        <p style="margin-top: 30px; font-size: 0.9rem; opacity: 0.8;">
                            💳 Aucune carte bancaire requise · 📅 14 jours d'essai gratuit · ❌ Annulation à tout moment
                        </p>
                    </div>
                </section>

            </div>
        </t>
    </template>
</odoo>
