<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Page Website pour SaaS Landing -->
    <record id="website_page_saas_landing" model="website.page">
        <field name="name">SaaS Platform</field>
        <field name="url">/saas</field>
        <field name="website_published">True</field>
        <field name="is_published">True</field>
        <field name="view_id" ref="saas_landing_page"/>
    </record>

    <!-- Menu principal pour SaaS -->
    <record id="website_menu_saas" model="website.menu">
        <field name="name">Plateforme SaaS</field>
        <field name="url">/saas</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence">10</field>
    </record>
</odoo>
