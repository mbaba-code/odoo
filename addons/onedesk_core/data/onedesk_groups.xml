<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- USER GROUPS FOR ONEDESK MULTI-TENANT ACCESS CONTROL -->

    <!-- Group: Property Manager (Full access to his company data) -->
    <record id="group_onedesk_property_manager" model="res.groups">
        <field name="name">OneDesk / Property Manager</field>
        <field name="comment">Gestionnaire de propriétés OneDesk - Accès complet à ses données</field>
    </record>

    <!-- Group: OneDesk Staff (Limited access - can manage reservations, tasks) -->
    <record id="group_onedesk_staff" model="res.groups">
        <field name="name">OneDesk / Staff</field>
        <field name="comment">Personnel OneDesk - Accès limité aux réservations et tâches</field>
    </record>

    <!-- Group: OneDesk Viewer (Read-only access) -->
    <record id="group_onedesk_viewer" model="res.groups">
        <field name="name">OneDesk / Viewer</field>
        <field name="comment">Lecteur OneDesk - Accès en lecture seule</field>
    </record>

    <!-- Group: OneDesk Master Admin (Full system access + all clients) -->
    <record id="group_onedesk_master_admin" model="res.groups">
        <field name="name">OneDesk / Master Admin</field>
        <field name="comment">Administrateur maitre OneDesk - Accès complet au système et tous les clients</field>
    </record>

    <!-- Group: OneDesk Support (Can assist clients, view logs) -->
    <record id="group_onedesk_support" model="res.groups">
        <field name="name">OneDesk / Support Team</field>
        <field name="comment">Équipe support OneDesk - Accès aux logs et support clients</field>
    </record>

    <!-- GROUP MENUS FOR NAVIGATION -->

    <!-- Master Admin Menu -->
    <menuitem id="menu_onedesk_admin_root"
              name="Admin OneDesk"
              parent="base.menu_administration"
              groups="group_onedesk_master_admin"
              sequence="50"/>

    <menuitem id="menu_onedesk_admin_clients"
              name="Gestion des clients"
              parent="menu_onedesk_admin_root"
              groups="group_onedesk_master_admin"
              action="onedesk_core.action_onedesk_client"
              sequence="1"/>

    <menuitem id="menu_onedesk_admin_subscriptions"
              name="Abonnements"
              parent="menu_onedesk_admin_root"
              groups="group_onedesk_master_admin"
              action="onedesk_core.action_onedesk_subscription"
              sequence="2"/>

    <menuitem id="menu_onedesk_admin_plans"
              name="Plans de tarification"
              parent="menu_onedesk_admin_root"
              groups="group_onedesk_master_admin"
              action="onedesk_core.action_onedesk_subscription_plan"
              sequence="3"/>

    <menuitem id="menu_onedesk_admin_logs"
              name="Journaux d'audit"
              parent="menu_onedesk_admin_root"
              groups="group_onedesk_master_admin"
              action="onedesk_core.action_onedesk_audit_log"
              sequence="4"/>

    <menuitem id="menu_onedesk_support_root"
              name="Support OneDesk"
              parent="base.menu_administration"
              groups="group_onedesk_support"
              sequence="51"/>

    <menuitem id="menu_onedesk_support_logs"
              name="Journaux système"
              parent="menu_onedesk_support_root"
              groups="group_onedesk_support"
              action="onedesk_core.action_onedesk_system_log"
              sequence="1"/>

    <!-- ==================== MODEL ACCESS PERMISSIONS ==================== -->

    <!-- Master Admin - Full Access to All Models -->
    <record id="access_onedesk_client_admin" model="ir.model.access">
        <field name="name">OneDesk Client - Master Admin</field>
        <field name="model_id" ref="model_onedesk_client"/>
        <field name="group_id" ref="group_onedesk_master_admin"/>
        <field name="perm_read">True</field>
        <field name="perm_write">True</field>
        <field name="perm_create">True</field>
        <field name="perm_unlink">True</field>
    </record>

    <record id="access_onedesk_subscription_admin" model="ir.model.access">
        <field name="name">OneDesk Subscription - Master Admin</field>
        <field name="model_id" ref="model_onedesk_subscription"/>
        <field name="group_id" ref="group_onedesk_master_admin"/>
        <field name="perm_read">True</field>
        <field name="perm_write">True</field>
        <field name="perm_create">True</field>
        <field name="perm_unlink">True</field>
    </record>

    <record id="access_onedesk_plan_admin" model="ir.model.access">
        <field name="name">OneDesk Plan - Master Admin</field>
        <field name="model_id" ref="model_onedesk_subscription_plan"/>
        <field name="group_id" ref="group_onedesk_master_admin"/>
        <field name="perm_read">True</field>
        <field name="perm_write">True</field>
        <field name="perm_create">True</field>
        <field name="perm_unlink">True</field>
    </record>

    <record id="access_onedesk_audit_log_admin" model="ir.model.access">
        <field name="name">OneDesk Audit Log - Master Admin</field>
        <field name="model_id" ref="model_onedesk_audit_log"/>
        <field name="group_id" ref="group_onedesk_master_admin"/>
        <field name="perm_read">True</field>
        <field name="perm_write">True</field>
        <field name="perm_create">True</field>
        <field name="perm_unlink">False</field>
    </record>

    <record id="access_onedesk_system_log_admin" model="ir.model.access">
        <field name="name">OneDesk System Log - Master Admin</field>
        <field name="model_id" ref="model_onedesk_system_log"/>
        <field name="group_id" ref="group_onedesk_master_admin"/>
        <field name="perm_read">True</field>
        <field name="perm_write">True</field>
        <field name="perm_create">True</field>
        <field name="perm_unlink">False</field>
    </record>

    <!-- Support Team - Read Access -->
    <record id="access_onedesk_client_support" model="ir.model.access">
        <field name="name">OneDesk Client - Support</field>
        <field name="model_id" ref="model_onedesk_client"/>
        <field name="group_id" ref="group_onedesk_support"/>
        <field name="perm_read">True</field>
        <field name="perm_write">False</field>
        <field name="perm_create">False</field>
        <field name="perm_unlink">False</field>
    </record>

    <record id="access_onedesk_audit_log_support" model="ir.model.access">
        <field name="name">OneDesk Audit Log - Support</field>
        <field name="model_id" ref="model_onedesk_audit_log"/>
        <field name="group_id" ref="group_onedesk_support"/>
        <field name="perm_read">True</field>
        <field name="perm_write">False</field>
        <field name="perm_create">False</field>
        <field name="perm_unlink">False</field>
    </record>

    <record id="access_onedesk_system_log_support" model="ir.model.access">
        <field name="name">OneDesk System Log - Support</field>
        <field name="model_id" ref="model_onedesk_system_log"/>
        <field name="group_id" ref="group_onedesk_support"/>
        <field name="perm_read">True</field>
        <field name="perm_write">False</field>
        <field name="perm_create">False</field>
        <field name="perm_unlink">False</field>
    </record>

</odoo>
