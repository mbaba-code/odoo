<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Template Email de Bienvenue Client SaaS -->
        <record id="email_template_client_welcome" model="mail.template">
            <field name="name">SaaS Client - Email de Bienvenue</field>
            <field name="model_id" ref="model_saas_client"/>
            <field name="subject">Bienvenue sur {{ object.company_name }} - Votre plateforme est prête</field>
            <field name="email_from">noreply@basatechno.fr</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
<table border="0" cellpadding="0" cellspacing="0" style="padding-top: 16px; background-color: #FFFFFF; font-family:Verdana, Arial,sans-serif; color: #454748; width: 100%; border-collapse:separate;">
<tr><td align="center">
<table border="0" cellpadding="0" cellspacing="0" width="590" style="padding: 16px; background-color: #FFFFFF; color: #454748; border-collapse:separate;">
<tbody>
    <!-- HEADER -->
    <tr>
        <td align="center" style="min-width: 590px;">
            <table border="0" cellpadding="0" cellspacing="0" width="590" style="min-width: 590px; background-color: white; padding: 0px 8px 0px 8px; border-collapse:separate;">
                <tr><td valign="middle">
                    <span style="font-size: 10px;">Bienvenue sur OneDesk</span><br/>
                    <span style="font-size: 20px; font-weight: bold;">
                        <t t-out="object.company_name or ''">Votre Entreprise</t>
                    </span>
                </td></tr>
                <tr><td colspan="2" style="text-align:center;">
                  <hr width="100%" style="background-color:rgb(204,204,204);border:medium none;clear:both;display:block;font-size:0px;min-height:1px;line-height:0; margin: 16px 0px 16px 0px;"/>
                </td></tr>
            </table>
        </td>
    </tr>
    <!-- CONTENT -->
    <tr>
        <td align="center" style="min-width: 590px;">
            <table border="0" cellpadding="0" cellspacing="0" width="590" style="min-width: 590px; background-color: white; padding: 0px 8px 0px 8px; border-collapse:separate;">
                <tr><td valign="top" style="font-size: 13px;">
                    <div>
                        Bonjour <t t-if="object.contact_name"><t t-out="object.contact_name or ''">Client</t></t><t t-else="">cher client</t>,<br /><br />
                        Félicitations ! Votre plateforme Odoo est maintenant prête et opérationnelle.<br /><br />
                        <strong>Vos identifiants de connexion :</strong><br /><br />
                        <div style="background-color: #f9f9f9; padding: 15px; border-left: 4px solid #875A7B; margin: 16px 0;">
                            <strong>URL :</strong> <a t-att-href="object.url or ''" t-out="object.url or ''">https://votre-plateforme.com</a><br />
                            <strong>Identifiant :</strong> <t t-out="object.admin_login or ''">admin</t><br />
                            <strong>Mot de passe temporaire :</strong> <t t-out="ctx.get('admin_password', '[Voir dans le chatter]') or ''">********</t>
                        </div>
                        <div style="margin: 16px 0px 16px 0px;">
                            <a t-att-href="object.url or ''"
                                style="background-color: #875A7B; padding: 8px 16px 8px 16px; text-decoration: none; color: #FFFFFF; border-radius: 5px; font-size:13px;">
                                Accéder à ma plateforme
                            </a>
                        </div>
                        <div style="background-color: #fff3cd; border: 1px solid #ffc107; padding: 10px; border-radius: 4px; margin: 16px 0;">
                            <strong>⚠️ Important :</strong> Pour votre sécurité, changez votre mot de passe dès votre première connexion.
                        </div>
                        <t t-if="object.plan_id">
                            <strong>Plan souscrit :</strong> <t t-out="object.plan_id.name or ''">Plan</t><br />
                        </t>
                        <t t-if="object.is_trial">
                            <strong>Période d'essai :</strong> <t t-out="object.days_until_trial_end or 0">0</t> jours restants<br />
                        </t>
                        <br />
                        Si vous avez des questions, contactez-nous : <a href="mailto:support@basatechno.fr" style="color: #875A7B;">support@basatechno.fr</a>
                        <br /><br />
                        Excellente utilisation de votre nouvelle plateforme !<br />
                        <br />
                        Cordialement,<br />
                        <strong>L'équipe OneDesk</strong>
                    </div>
                </td></tr>
                <tr><td style="text-align:center;">
                  <hr width="100%" style="background-color:rgb(204,204,204);border:medium none;clear:both;display:block;font-size:0px;min-height:1px;line-height:0; margin: 16px 0px 16px 0px;"/>
                </td></tr>
            </table>
        </td>
    </tr>
    <!-- FOOTER -->
    <tr>
        <td align="center" style="min-width: 590px;">
            <table border="0" cellpadding="0" cellspacing="0" width="590" style="min-width: 590px; background-color: white; font-size: 11px; padding: 0px 8px 0px 8px; border-collapse:separate;">
                <tr><td valign="middle" align="left" style="opacity: 0.7;">
                    © 2025 OneDesk - Tous droits réservés
                </td></tr>
            </table>
        </td>
    </tr>
</tbody>
</table>
</td></tr>
</table>
            </field>
        </record>

    </data>
</odoo>
