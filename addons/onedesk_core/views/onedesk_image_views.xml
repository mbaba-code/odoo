<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- PROPERTY IMAGE VIEWS -->
    <record id="view_property_image_kanban" model="ir.ui.view">
        <field name="name">onedesk.property.image.kanban</field>
        <field name="model">onedesk.property.image</field>
        <field name="arch" type="xml">
            <kanban string="Photo Gallery">
                <field name="id"/>
                <field name="image" widget="binary"/>
                <field name="name"/>
                <field name="is_cover"/>
                <field name="sequence"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card">
                            <div class="oe_kanban_global_click">
                                <!-- Photo -->
                                <div style="height: 200px; margin-bottom: 10px; border-radius: 5px; overflow: hidden; background: #f0f0f0; display: flex; align-items: center; justify-content: center; position: relative;">
                                    <t t-if="record.image.raw_value">
                                        <img t-att-src="'data:image/*;base64,' + record.image.raw_value" style="width: 100%; height: 100%; object-fit: cover;" alt="Photo"/>
                                    </t>
                                    <t t-else="">
                                        <i class="fa fa-image fa-3x" style="color: #ccc;"></i>
                                    </t>
                                    <!-- Cover Badge -->
                                    <t t-if="record.is_cover.value">
                                        <div style="position: absolute; top: 5px; right: 5px; background: #28a745; color: white; padding: 5px 10px; border-radius: 3px; font-weight: bold;">
                                            📌 Couverture
                                        </div>
                                    </t>
                                </div>

                                <!-- Info -->
                                <h4 style="margin: 5px 0; font-weight: bold; font-size: 13px;">
                                    <field name="name"/>
                                </h4>

                                <div style="text-align: center; margin-top: 8px;">
                                    <button type="button" class="btn btn-sm btn-outline-primary" name="action_set_cover" string="📌 Marquer comme couverture"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_property_image_form" model="ir.ui.view">
        <field name="name">onedesk.property.image.form</field>
        <field name="model">onedesk.property.image</field>
        <field name="arch" type="xml">
            <form string="Property Photo">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="is_cover" widget="boolean"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="property_id"/>
                        </group>
                    </group>
                    <field name="image" widget="image"/>
                </sheet>
            </form>
        </field>
    </record>

