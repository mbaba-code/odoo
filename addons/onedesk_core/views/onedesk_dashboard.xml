<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Dashboard Form View -->
    <record id="view_onedesk_dashboard_form" model="ir.ui.view">
        <field name="name">OneDesk Dashboard</field>
        <field name="model">onedesk.dashboard</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form string="Tableau de bord" create="false" edit="true" delete="false">
                <sheet>
                    <h1 class="text-center mb-3">📊 Tableau de Bord OneDesk</h1>

                    <!-- Header Info -->
                    <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 15px; border-radius: 8px; margin-bottom: 20px; text-align: center;">
                        <p style="margin: 0; font-size: 14px;">Configuration et suivi en temps réel de votre plateforme de gestion locative</p>
                    </div>

                    <!-- Auto-Refresh Settings -->
                    <group string="🔄 Paramètres d'Auto-Rafraîchissement" colspan="4">
                        <field name="auto_refresh" widget="boolean" string="Activer l'Auto-Rafraîchissement"/>
                        <field name="refresh_interval" string="Intervalle de Rafraîchissement (secondes)"/>
                    </group>

                    <!-- Widget Visibility Settings -->
                    <group string="👁️ Visibilité des Widgets - Cochez les widgets à afficher" colspan="4">
                        <group col="2">
                            <field name="show_properties_kpi" widget="boolean" string="✅ Propriétés" onchange="_onWidgetVisibilityChange"/>
                            <field name="show_units_kpi" widget="boolean" string="✅ Unités" onchange="_onWidgetVisibilityChange"/>
                            <field name="show_reservations_today" widget="boolean" string="✅ Réservations" onchange="_onWidgetVisibilityChange"/>
                            <field name="show_tasks_urgent" widget="boolean" string="✅ Tâches" onchange="_onWidgetVisibilityChange"/>
                            <field name="show_financial" widget="boolean" string="✅ Financier" onchange="_onWidgetVisibilityChange"/>
                            <field name="show_occupancy_chart" widget="boolean" string="📊 Occupation" onchange="_onWidgetVisibilityChange"/>
                            <field name="show_revenue_chart" widget="boolean" string="💰 Revenus" onchange="_onWidgetVisibilityChange"/>
                        </group>
                    </group>

                    <!-- ==================== DASHBOARD METRICS ==================== -->

                    <!-- Properties KPI -->
                    <group string="🏠 Aperçu des Propriétés" colspan="4" data-widget="show_properties_kpi">
                        <div style="background: #f8f9fa; padding: 12px; border-radius: 6px; border-left: 4px solid #28a745; width: 100%;" colspan="4">
                            <p style="margin: 0; font-size: 13px;">
                                <strong>Total:</strong> <field name="total_properties" readonly="1" nolabel="1" class="oe_inline"/> |
                                <strong>Actives:</strong> <field name="active_properties" readonly="1" nolabel="1" class="oe_inline"/> |
                                <strong>Inactives:</strong> <field name="inactive_properties" readonly="1" nolabel="1" class="oe_inline"/>
                            </p>
                        </div>
                        <field name="properties_occupancy_rate" readonly="1" string="Taux d'Occupation (%)"/>
                        <field name="revenue_this_month" readonly="1" string="Revenus (Ce Mois)" widget="monetary"/>
                    </group>

                    <!-- Units KPI -->
                    <group string="🚪 Aperçu des Unités" colspan="4" data-widget="show_units_kpi">
                        <div style="background: #f8f9fa; padding: 12px; border-radius: 6px; border-left: 4px solid #17a2b8; width: 100%;" colspan="4">
                            <p style="margin: 0; font-size: 13px;">
                                <strong>Total:</strong> <field name="total_units" readonly="1" nolabel="1" class="oe_inline"/> |
                                <strong>Disponibles:</strong> <field name="available_units" readonly="1" nolabel="1" class="oe_inline"/> |
                                <strong>En Maintenance:</strong> <field name="maintenance_units" readonly="1" nolabel="1" class="oe_inline"/>
                            </p>
                        </div>
                        <field name="units_occupancy_rate" readonly="1" string="Taux d'Occupation (%)"/>
                    </group>

                    <!-- Reservations Today -->
                    <group string="📅 Réservations (Aujourd'hui)" colspan="4" data-widget="show_reservations_today">
                        <field name="reservations_today_checkin" readonly="1" string="Check-ins"/>
                        <field name="reservations_today_checkout" readonly="1" string="Check-outs"/>
                        <field name="reservations_pending_payment" readonly="1" string="Paiements en Attente"/>
                        <field name="reservations_pending_payment_amount" readonly="1" string="Montant en Attente" widget="monetary"/>
                        <field name="reservations_confirmed_month" readonly="1" string="Confirmées (Ce Mois)"/>
                    </group>

                    <!-- Urgent Tasks -->
                    <group string="✅ Aperçu des Tâches" colspan="4" data-widget="show_tasks_urgent">
                        <field name="tasks_overdue" readonly="1" string="🔴 Tâches en Retard"/>
                        <field name="tasks_due_today" readonly="1" string="📌 Tâches d'Aujourd'hui"/>
                        <field name="tasks_urgent_total" readonly="1" string="⚡ Tâches Urgentes"/>
                        <field name="tasks_in_progress" readonly="1" string="⏱️ En Cours"/>
                    </group>

                    <!-- Financial Summary -->
                    <group string="💰 Résumé Financier" colspan="4" data-widget="show_financial">
                        <field name="revenue_today" readonly="1" string="Revenus d'Aujourd'hui" widget="monetary"/>
                        <field name="revenue_this_week" readonly="1" string="Revenus (Cette Semaine)" widget="monetary"/>
                        <field name="outstanding_payments" readonly="1" string="Paiements Exceptionnels" widget="monetary"/>
                        <field name="occupancy_rate_week" readonly="1" string="Occupation (Cette Semaine) (%)"/>
                    </group>

                    <!-- Charts Placeholder -->
                    <group string="📊 Analytiques" colspan="4">
                        <div style="background: #e7f3ff; padding: 12px; border-radius: 6px; border-left: 4px solid #007bff; width: 100%;" colspan="4">
                            <p style="margin: 5px 0 0 0; font-size: 13px;"><strong>Graphiques &amp; Analyses Détaillées</strong></p>
                            <p style="margin: 5px 0 0 0; font-size: 12px; color: #555;">Les graphiques d'occupation et de revenus s'afficheront ici une fois configurés.</p>
                        </div>
                    </group>

                    <!-- Last Updated -->
                    <footer style="text-align: center; margin-top: 20px; padding-top: 15px; border-top: 1px solid #ddd;">
                        <p style="margin: 5px 0; font-size: 12px; color: #999;">
                            Métriques actualisées automatiquement toutes les <field name="refresh_interval" readonly="1" nolabel="1" class="oe_inline"/> secondes.
                        </p>
                        <p style="margin: 0; font-size: 12px; color: #999;">
                            Dernière actualisation: <span class="dashboard-update-time">À l'instant</span>
                        </p>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Dashboard List View -->
    <record id="view_onedesk_dashboard_list" model="ir.ui.view">
        <field name="name">OneDesk Dashboard List</field>
        <field name="model">onedesk.dashboard</field>
        <field name="priority">2</field>
        <field name="arch" type="xml">
            <list string="Tableaux de Bord">
                <field name="user_id"/>
                <field name="company_id"/>
                <field name="auto_refresh"/>
                <field name="refresh_interval"/>
                <field name="total_properties"/>
                <field name="total_units"/>
                <field name="properties_occupancy_rate"/>
                <field name="revenue_this_month"/>
            </list>
        </field>
    </record>

    <!-- Dashboard Kanban View -->
    <record id="view_onedesk_dashboard_kanban" model="ir.ui.view">
        <field name="name">OneDesk Dashboard Kanban</field>
        <field name="model">onedesk.dashboard</field>
        <field name="priority">3</field>
        <field name="arch" type="xml">
            <kanban string="Tableaux de Bord">
                <field name="user_id"/>
                <field name="company_id"/>
                <field name="total_properties"/>
                <field name="total_units"/>
                <field name="properties_occupancy_rate"/>
                <field name="revenue_this_month"/>
                <field name="reservations_confirmed_month"/>
                <field name="tasks_in_progress"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 20px; border-radius: 8px;">
                            <div class="oe_kanban_global_click">
                                <h3 style="margin: 0 0 15px 0; font-size: 18px;">
                                    <field name="user_id"/>
                                </h3>
                                <div style="font-size: 12px; background: rgba(255,255,255,0.2); padding: 10px; border-radius: 5px; margin-bottom: 10px;">
                                    <p style="margin: 5px 0;"><strong>🏢 Company:</strong> <field name="company_id"/></p>
                                </div>
                                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; font-size: 12px;">
                                    <div style="background: rgba(255,255,255,0.1); padding: 8px; border-radius: 4px;">
                                        <div style="opacity: 0.8;">🏠 Propriétés</div>
                                        <div style="font-size: 18px; font-weight: bold;"><field name="total_properties"/></div>
                                    </div>
                                    <div style="background: rgba(255,255,255,0.1); padding: 8px; border-radius: 4px;">
                                        <div style="opacity: 0.8;">🚪 Unités</div>
                                        <div style="font-size: 18px; font-weight: bold;"><field name="total_units"/></div>
                                    </div>
                                    <div style="background: rgba(255,255,255,0.1); padding: 8px; border-radius: 4px;">
                                        <div style="opacity: 0.8;">📊 Occupation</div>
                                        <div style="font-size: 18px; font-weight: bold;"><field name="properties_occupancy_rate"/>%</div>
                                    </div>
                                    <div style="background: rgba(255,255,255,0.1); padding: 8px; border-radius: 4px;">
                                        <div style="opacity: 0.8;">💰 Revenus</div>
                                        <div style="font-size: 18px; font-weight: bold;"><field name="revenue_this_month" widget="monetary"/></div>
                                    </div>
                                    <div style="background: rgba(255,255,255,0.1); padding: 8px; border-radius: 4px;">
                                        <div style="opacity: 0.8;">📅 Réservations</div>
                                        <div style="font-size: 18px; font-weight: bold;"><field name="reservations_confirmed_month"/></div>
                                    </div>
                                    <div style="background: rgba(255,255,255,0.1); padding: 8px; border-radius: 4px;">
                                        <div style="opacity: 0.8;">⏱️ Tâches</div>
                                        <div style="font-size: 18px; font-weight: bold;"><field name="tasks_in_progress"/></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Dashboard Graph View - Properties Metrics -->
    <record id="view_onedesk_dashboard_graph_properties" model="ir.ui.view">
        <field name="name">Dashboard - Propriétés (Graphique)</field>
        <field name="model">onedesk.dashboard</field>
        <field name="priority">4</field>
        <field name="arch" type="xml">
            <graph string="Métriques des Propriétés" type="bar">
                <field name="company_id" type="row"/>
                <field name="total_properties" type="measure"/>
                <field name="active_properties" type="measure"/>
                <field name="properties_occupancy_rate" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Dashboard Graph View - Financial Metrics -->
    <record id="view_onedesk_dashboard_graph_financial" model="ir.ui.view">
        <field name="name">Dashboard - Financier (Graphique)</field>
        <field name="model">onedesk.dashboard</field>
        <field name="priority">5</field>
        <field name="arch" type="xml">
            <graph string="Métriques Financières" type="bar">
                <field name="company_id" type="row"/>
                <field name="revenue_today" type="measure"/>
                <field name="revenue_this_week" type="measure"/>
                <field name="revenue_this_month" type="measure"/>
                <field name="outstanding_payments" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Dashboard Pivot View -->
    <record id="view_onedesk_dashboard_pivot" model="ir.ui.view">
        <field name="name">Dashboard - Analyse Pivot</field>
        <field name="model">onedesk.dashboard</field>
        <field name="priority">6</field>
        <field name="arch" type="xml">
            <pivot string="Analyse Pivot des Métriques">
                <field name="company_id" type="row"/>
                <field name="user_id" type="col"/>
                <field name="total_properties" type="measure"/>
                <field name="total_units" type="measure"/>
                <field name="revenue_this_month" type="measure"/>
                <field name="properties_occupancy_rate" type="measure"/>
            </pivot>
        </field>
    </record>

</odoo>
