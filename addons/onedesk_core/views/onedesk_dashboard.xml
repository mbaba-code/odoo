<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Dashboard Form View - Professional SaaS Style -->
    <record id="view_onedesk_dashboard_form" model="ir.ui.view">
        <field name="name">OneDesk Dashboard Professional</field>
        <field name="model">onedesk.dashboard</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form string="Tableau de Bord" create="true" edit="true" delete="false" class="onedesk-dashboard-form">
                <sheet class="o_dashboard_sheet">
                    <!-- ==================== HEADER SECTION ==================== -->
                    <div class="dashboard-header">
                        <div class="header-title">
                            <h1>📊 Tableau de Bord OneDesk</h1>
                            <p>Vue d'ensemble complète de votre activité locative</p>
                        </div>
                    </div>

                    <!-- ==================== PERIOD FILTER SECTION ==================== -->
                    <div class="dashboard-filters">
                        <group string="⏰ Sélectionnez la période d'analyse" colspan="4">
                            <field name="period_type" widget="radio" colspan="4" nolabel="1"/>
                            <group attrs="{'invisible': [('period_type', '!=', 'custom')]}" colspan="4">
                                <field name="date_from" string="De (From)"/>
                                <field name="date_to" string="À (To)"/>
                            </group>
                        </group>
                    </div>

                    <!-- ==================== KPI CARDS SECTION - TOP METRICS ==================== -->
                    <div class="dashboard-kpis">
                        <div class="kpi-row">
                            <div class="kpi-card kpi-properties">
                                <div class="kpi-value"><field name="total_properties" readonly="1" nolabel="1"/></div>
                                <div class="kpi-label">Propriétés</div>
                                <div class="kpi-subtext">
                                    <span><strong>Actives:</strong> <field name="active_properties" readonly="1" nolabel="1" class="oe_inline"/></span>
                                </div>
                            </div>

                            <div class="kpi-card kpi-units">
                                <div class="kpi-value"><field name="total_units" readonly="1" nolabel="1"/></div>
                                <div class="kpi-label">Unités</div>
                                <div class="kpi-subtext">
                                    <span><strong>Dispo:</strong> <field name="available_units" readonly="1" nolabel="1" class="oe_inline"/></span>
                                </div>
                            </div>

                            <div class="kpi-card kpi-revenue">
                                <div class="kpi-value currency"><field name="revenue_this_month" readonly="1" nolabel="1" widget="monetary"/></div>
                                <div class="kpi-label">Revenus Mois</div>
                                <div class="kpi-subtext">Cette période</div>
                            </div>

                            <div class="kpi-card kpi-occupancy">
                                <div class="kpi-value percent"><field name="properties_occupancy_rate" readonly="1" nolabel="1"/>%</div>
                                <div class="kpi-label">Occupation</div>
                                <div class="kpi-subtext">Taux moyen</div>
                            </div>

                            <div class="kpi-card kpi-reservations">
                                <div class="kpi-value"><field name="reservations_confirmed_month" readonly="1" nolabel="1"/></div>
                                <div class="kpi-label">Réservations</div>
                                <div class="kpi-subtext">Ce mois</div>
                            </div>
                        </div>
                    </div>

                    <!-- ==================== MAIN CONTENT SECTIONS ==================== -->

                    <!-- Section 1: Revenue Analytics -->
                    <div class="dashboard-section revenue-section" data-widget="show_financial">
                        <h2 class="section-title">💰 Analyse Financière</h2>
                        <group colspan="4">
                            <group col="2">
                                <field name="revenue_today" readonly="1" string="Aujourd'hui"/>
                                <field name="revenue_this_week" readonly="1" string="Cette Semaine"/>
                                <field name="outstanding_payments" readonly="1" string="Paiements en Attente" widget="monetary"/>
                            </group>
                        </group>
                    </div>

                    <!-- Section 2: Properties Details -->
                    <div class="dashboard-section properties-section" data-widget="show_properties_kpi">
                        <h2 class="section-title">🏠 Détails des Propriétés</h2>
                        <group colspan="4">
                            <group col="2">
                                <field name="active_properties" readonly="1" string="Actives"/>
                                <field name="inactive_properties" readonly="1" string="Inactives"/>
                                <field name="properties_occupancy_rate" readonly="1" string="Taux d'Occupation (%)"/>
                            </group>
                        </group>
                    </div>

                    <!-- Section 3: Units Details -->
                    <div class="dashboard-section units-section" data-widget="show_units_kpi">
                        <h2 class="section-title">🚪 Détails des Unités</h2>
                        <group colspan="4">
                            <group col="2">
                                <field name="available_units" readonly="1" string="Disponibles"/>
                                <field name="maintenance_units" readonly="1" string="En Maintenance"/>
                                <field name="units_occupancy_rate" readonly="1" string="Taux d'Occupation (%)"/>
                            </group>
                        </group>
                    </div>

                    <!-- Section 4: Reservations -->
                    <div class="dashboard-section reservations-section" data-widget="show_reservations_today">
                        <h2 class="section-title">📅 Réservations</h2>
                        <group colspan="4">
                            <group col="2">
                                <field name="reservations_today_checkin" readonly="1" string="Check-ins Aujourd'hui"/>
                                <field name="reservations_today_checkout" readonly="1" string="Check-outs Aujourd'hui"/>
                                <field name="reservations_pending_payment" readonly="1" string="En Attente de Paiement"/>
                                <field name="reservations_pending_payment_amount" readonly="1" string="Montant en Attente" widget="monetary"/>
                            </group>
                        </group>
                    </div>

                    <!-- Section 5: Tasks -->
                    <div class="dashboard-section tasks-section" data-widget="show_tasks_urgent">
                        <h2 class="section-title">✅ Gestion des Tâches</h2>
                        <group colspan="4">
                            <group col="2">
                                <field name="tasks_overdue" readonly="1" string="🔴 En Retard"/>
                                <field name="tasks_due_today" readonly="1" string="📌 Aujourd'hui"/>
                                <field name="tasks_urgent_total" readonly="1" string="⚡ Urgentes"/>
                                <field name="tasks_in_progress" readonly="1" string="⏱️ En Cours"/>
                            </group>
                        </group>
                    </div>

                    <!-- ==================== SETTINGS SECTION ==================== -->
                    <separator string="⚙️ Configuration Avancée"/>
                    <group colspan="4">
                        <group col="2">
                            <field name="auto_refresh" widget="boolean" string="Auto-Rafraîchissement"/>
                            <field name="refresh_interval" attrs="{'readonly': [('auto_refresh', '=', False)]}" string="Intervalle (secondes)"/>
                        </group>
                    </group>

                    <!-- Widget Visibility -->
                    <separator string="👁️ Visibilité des Sections"/>
                    <group colspan="4">
                        <group col="4">
                            <field name="show_properties_kpi" widget="boolean" nolabel="1" string="Propriétés"/>
                            <field name="show_units_kpi" widget="boolean" nolabel="1" string="Unités"/>
                            <field name="show_reservations_today" widget="boolean" nolabel="1" string="Réservations"/>
                            <field name="show_tasks_urgent" widget="boolean" nolabel="1" string="Tâches"/>
                            <field name="show_financial" widget="boolean" nolabel="1" string="Finances"/>
                            <field name="show_occupancy_chart" widget="boolean" nolabel="1" string="Occupation"/>
                            <field name="show_revenue_chart" widget="boolean" nolabel="1" string="Revenus"/>
                        </group>
                    </group>

                    <!-- ==================== CHARTS SECTION ==================== -->
                    <separator string="📈 Graphiques &amp; Analyses"/>

                    <!-- Revenue Chart -->
                    <div class="dashboard-section charts-section" data-widget="show_revenue_chart">
                        <h2 class="section-title">💰 Tendance des Revenus</h2>
                        <div id="revenue-chart-container" style="position: relative; height: 300px; padding: 15px;">
                            <canvas style="max-height: 300px;"></canvas>
                        </div>
                    </div>

                    <!-- Occupancy Chart -->
                    <div class="dashboard-section charts-section" data-widget="show_occupancy_chart">
                        <h2 class="section-title">📊 Taux d'Occupation par Propriété</h2>
                        <div id="occupancy-chart-container" style="position: relative; height: 300px; padding: 15px;">
                            <canvas style="max-height: 300px;"></canvas>
                        </div>
                    </div>

                    <!-- Reservations Chart -->
                    <div class="dashboard-section charts-section">
                        <h2 class="section-title">📅 Réservations par Statut</h2>
                        <div id="reservations-chart-container" style="position: relative; height: 300px; padding: 15px;">
                            <canvas style="max-height: 300px;"></canvas>
                        </div>
                    </div>

                    <!-- Footer -->
                    <footer class="dashboard-footer">
                        <div class="footer-info">
                            <p>Mises à jour automatiques toutes les <field name="refresh_interval" readonly="1" nolabel="1" class="oe_inline"/> secondes</p>
                            <p>Dernière actualisation: <span class="dashboard-update-time">À l'instant</span></p>
                        </div>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Dashboard List View -->
    <record id="view_onedesk_dashboard_list" model="ir.ui.view">
        <field name="name">OneDesk Dashboard List</field>
        <field name="model">onedesk.dashboard</field>
        <field name="priority">2</field>
        <field name="arch" type="xml">
            <list string="Tableaux de Bord">
                <field name="user_id"/>
                <field name="company_id"/>
                <field name="auto_refresh"/>
                <field name="refresh_interval"/>
                <field name="total_properties"/>
                <field name="total_units"/>
                <field name="properties_occupancy_rate"/>
                <field name="revenue_this_month"/>
            </list>
        </field>
    </record>

    <!-- Dashboard Kanban View -->
    <record id="view_onedesk_dashboard_kanban" model="ir.ui.view">
        <field name="name">OneDesk Dashboard Kanban</field>
        <field name="model">onedesk.dashboard</field>
        <field name="priority">3</field>
        <field name="arch" type="xml">
            <kanban string="Tableaux de Bord">
                <field name="user_id"/>
                <field name="company_id"/>
                <field name="total_properties"/>
                <field name="total_units"/>
                <field name="properties_occupancy_rate"/>
                <field name="revenue_this_month"/>
                <field name="reservations_confirmed_month"/>
                <field name="tasks_in_progress"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 20px; border-radius: 8px;">
                            <div class="oe_kanban_global_click">
                                <h3 style="margin: 0 0 15px 0; font-size: 18px;">
                                    <field name="user_id"/>
                                </h3>
                                <div style="font-size: 12px; background: rgba(255,255,255,0.2); padding: 10px; border-radius: 5px; margin-bottom: 10px;">
                                    <p style="margin: 5px 0;"><strong>🏢 Company:</strong> <field name="company_id"/></p>
                                </div>
                                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; font-size: 12px;">
                                    <div style="background: rgba(255,255,255,0.1); padding: 8px; border-radius: 4px;">
                                        <div style="opacity: 0.8;">🏠 Propriétés</div>
                                        <div style="font-size: 18px; font-weight: bold;"><field name="total_properties"/></div>
                                    </div>
                                    <div style="background: rgba(255,255,255,0.1); padding: 8px; border-radius: 4px;">
                                        <div style="opacity: 0.8;">🚪 Unités</div>
                                        <div style="font-size: 18px; font-weight: bold;"><field name="total_units"/></div>
                                    </div>
                                    <div style="background: rgba(255,255,255,0.1); padding: 8px; border-radius: 4px;">
                                        <div style="opacity: 0.8;">📊 Occupation</div>
                                        <div style="font-size: 18px; font-weight: bold;"><field name="properties_occupancy_rate"/>%</div>
                                    </div>
                                    <div style="background: rgba(255,255,255,0.1); padding: 8px; border-radius: 4px;">
                                        <div style="opacity: 0.8;">💰 Revenus</div>
                                        <div style="font-size: 18px; font-weight: bold;"><field name="revenue_this_month" widget="monetary"/></div>
                                    </div>
                                    <div style="background: rgba(255,255,255,0.1); padding: 8px; border-radius: 4px;">
                                        <div style="opacity: 0.8;">📅 Réservations</div>
                                        <div style="font-size: 18px; font-weight: bold;"><field name="reservations_confirmed_month"/></div>
                                    </div>
                                    <div style="background: rgba(255,255,255,0.1); padding: 8px; border-radius: 4px;">
                                        <div style="opacity: 0.8;">⏱️ Tâches</div>
                                        <div style="font-size: 18px; font-weight: bold;"><field name="tasks_in_progress"/></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Dashboard Graph View - Properties Metrics -->
    <record id="view_onedesk_dashboard_graph_properties" model="ir.ui.view">
        <field name="name">Dashboard - Propriétés (Graphique)</field>
        <field name="model">onedesk.dashboard</field>
        <field name="priority">4</field>
        <field name="arch" type="xml">
            <graph string="Métriques des Propriétés" type="bar">
                <field name="company_id" type="row"/>
                <field name="total_properties" type="measure"/>
                <field name="active_properties" type="measure"/>
                <field name="properties_occupancy_rate" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Dashboard Graph View - Financial Metrics -->
    <record id="view_onedesk_dashboard_graph_financial" model="ir.ui.view">
        <field name="name">Dashboard - Financier (Graphique)</field>
        <field name="model">onedesk.dashboard</field>
        <field name="priority">5</field>
        <field name="arch" type="xml">
            <graph string="Métriques Financières" type="bar">
                <field name="company_id" type="row"/>
                <field name="revenue_today" type="measure"/>
                <field name="revenue_this_week" type="measure"/>
                <field name="revenue_this_month" type="measure"/>
                <field name="outstanding_payments" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Dashboard Pivot View -->
    <record id="view_onedesk_dashboard_pivot" model="ir.ui.view">
        <field name="name">Dashboard - Analyse Pivot</field>
        <field name="model">onedesk.dashboard</field>
        <field name="priority">6</field>
        <field name="arch" type="xml">
            <pivot string="Analyse Pivot des Métriques">
                <field name="company_id" type="row"/>
                <field name="user_id" type="col"/>
                <field name="total_properties" type="measure"/>
                <field name="total_units" type="measure"/>
                <field name="revenue_this_month" type="measure"/>
                <field name="properties_occupancy_rate" type="measure"/>
            </pivot>
        </field>
    </record>

</odoo>
