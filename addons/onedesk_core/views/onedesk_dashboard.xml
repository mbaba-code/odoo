<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Dashboard Form View -->
    <record id="view_onedesk_dashboard_form" model="ir.ui.view">
        <field name="name">OneDesk Dashboard</field>
        <field name="model">onedesk.dashboard</field>
        <field name="arch" type="xml">
            <form string="Dashboard" create="false" edit="true" delete="false">
                <sheet>
                    <!-- Header: Refresh Configuration -->
                    <div class="alert alert-info" role="alert">
                        <strong>Dashboard Configuration</strong>
                        <p>Customize your dashboard widgets and auto-refresh settings.</p>
                    </div>

                    <!-- Auto-Refresh Settings -->
                    <group string="🔄 Auto-Refresh Settings">
                        <field name="auto_refresh" widget="boolean"/>
                        <field name="refresh_interval" attrs="{'readonly': [('auto_refresh', '=', False)]}"/>
                    </group>

                    <!-- Widget Visibility Settings -->
                    <group string="👁️ Widget Visibility">
                        <group col="2">
                            <field name="show_properties_kpi" widget="boolean" string="Show Properties Widget"/>
                            <field name="show_units_kpi" widget="boolean" string="Show Units Widget"/>
                            <field name="show_reservations_today" widget="boolean" string="Show Reservations Widget"/>
                            <field name="show_tasks_urgent" widget="boolean" string="Show Tasks Widget"/>
                            <field name="show_financial" widget="boolean" string="Show Financial Widget"/>
                            <field name="show_occupancy_chart" widget="boolean" string="Show Occupancy Chart"/>
                            <field name="show_revenue_chart" widget="boolean" string="Show Revenue Chart"/>
                        </group>
                    </group>

                    <!-- ==================== DASHBOARD METRICS ==================== -->

                    <!-- Properties KPI -->
                    <group string="🏠 Properties Overview" attrs="{'invisible': [('show_properties_kpi', '=', False)]}">
                        <div class="alert alert-info" colspan="4">
                            <p>
                                Total: <strong><field name="total_properties" readonly="1" nolabel="1" class="oe_inline"/></strong> |
                                Active: <strong><field name="active_properties" readonly="1" nolabel="1" class="oe_inline"/></strong> |
                                Inactive: <strong><field name="inactive_properties" readonly="1" nolabel="1" class="oe_inline"/></strong>
                            </p>
                        </div>
                        <field name="properties_occupancy_rate" readonly="1" string="Occupancy Rate (%)"/>
                        <field name="revenue_this_month" readonly="1" string="Revenue (This Month)" widget="monetary"/>
                    </group>

                    <!-- Units KPI -->
                    <group string="🚪 Units Overview" attrs="{'invisible': [('show_units_kpi', '=', False)]}">
                        <div class="alert alert-info" colspan="4">
                            <p>
                                Total: <strong><field name="total_units" readonly="1" nolabel="1" class="oe_inline"/></strong> |
                                Available: <strong><field name="available_units" readonly="1" nolabel="1" class="oe_inline"/></strong> |
                                Maintenance: <strong><field name="maintenance_units" readonly="1" nolabel="1" class="oe_inline"/></strong>
                            </p>
                        </div>
                        <field name="units_occupancy_rate" readonly="1" string="Occupancy Rate (%)"/>
                    </group>

                    <!-- Reservations Today -->
                    <group string="📅 Reservations (Today)" attrs="{'invisible': [('show_reservations_today', '=', False)]}">
                        <field name="reservations_today_checkin" readonly="1" string="Check-ins Today"/>
                        <field name="reservations_today_checkout" readonly="1" string="Check-outs Today"/>
                        <field name="reservations_pending_payment" readonly="1" string="Pending Payments"/>
                        <field name="reservations_pending_payment_amount" readonly="1" string="Amount Pending" widget="monetary"/>
                        <field name="reservations_confirmed_month" readonly="1" string="Confirmed (This Month)"/>
                    </group>

                    <!-- Urgent Tasks -->
                    <group string="✅ Tasks Overview" attrs="{'invisible': [('show_tasks_urgent', '=', False)]}">
                        <field name="tasks_overdue" readonly="1" string="🔴 Overdue Tasks"/>
                        <field name="tasks_due_today" readonly="1" string="📌 Due Today"/>
                        <field name="tasks_urgent_total" readonly="1" string="⚡ Urgent Tasks"/>
                        <field name="tasks_in_progress" readonly="1" string="⏱️ In Progress"/>
                    </group>

                    <!-- Financial Summary -->
                    <group string="💰 Financial Summary" attrs="{'invisible': [('show_financial', '=', False)]}">
                        <field name="revenue_today" readonly="1" string="Revenue Today" widget="monetary"/>
                        <field name="revenue_this_week" readonly="1" string="Revenue (This Week)" widget="monetary"/>
                        <field name="outstanding_payments" readonly="1" string="Outstanding Payments" widget="monetary"/>
                        <field name="occupancy_rate_week" readonly="1" string="Occupancy (This Week) (%)"/>
                    </group>

                    <!-- Charts Placeholder -->
                    <group string="📊 Analytics">
                        <div class="alert alert-info" colspan="4">
                            <p><strong>Charts &amp; Detailed Analytics</strong></p>
                            <p>Occupancy Chart and Revenue Chart will be displayed here when configured.</p>
                        </div>
                    </group>

                    <!-- Last Updated -->
                    <footer class="text-muted">
                        <p>Dashboard metrics are automatically refreshed every <field name="refresh_interval" readonly="1" nolabel="1" class="oe_inline"/> seconds.</p>
                        <p>Last updated: <span class="dashboard-update-time">Just now</span></p>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Dashboard List View -->
    <record id="view_onedesk_dashboard_list" model="ir.ui.view">
        <field name="name">OneDesk Dashboard List</field>
        <field name="model">onedesk.dashboard</field>
        <field name="arch" type="xml">
            <tree string="Dashboards">
                <field name="user_id"/>
                <field name="company_id"/>
                <field name="auto_refresh"/>
                <field name="refresh_interval"/>
            </tree>
        </field>
    </record>

</odoo>
