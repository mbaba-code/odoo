<odoo>
    <!-- ACTIONS FIRST (before menuitems that reference them) -->

    <record id="action_onedesk_property" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">onedesk.property</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="action_onedesk_unit" model="ir.actions.act_window">
        <field name="name">Units</field>
        <field name="res_model">onedesk.unit</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="action_onedesk_reservation" model="ir.actions.act_window">
        <field name="name">Reservations</field>
        <field name="res_model">onedesk.reservation</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="action_onedesk_task" model="ir.actions.act_window">
        <field name="name">Tasks</field>
        <field name="res_model">onedesk.task</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <!-- MENUS (now can reference the actions) -->

    <menuitem id="menu_onedesk_root"
              name="OneDesk"
              sequence="10"
              web_icon="base/static/img/icons/stock_icon.svg"/>

    <menuitem id="menu_onedesk_property"
              name="Properties"
              parent="menu_onedesk_root"
              action="action_onedesk_property"
              sequence="10"/>

    <menuitem id="menu_onedesk_unit"
              name="Units"
              parent="menu_onedesk_root"
              action="action_onedesk_unit"
              sequence="20"/>

    <menuitem id="menu_onedesk_reservation"
              name="Reservations"
              parent="menu_onedesk_root"
              action="action_onedesk_reservation"
              sequence="30"/>

    <menuitem id="menu_onedesk_task"
              name="Tasks"
              parent="menu_onedesk_root"
              action="action_onedesk_task"
              sequence="40"/>

</odoo>
