<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue Liste Bases de Données SaaS -->
    <record id="view_saas_database_tree" model="ir.ui.view">
        <field name="name">saas.database.tree</field>
        <field name="model">saas.database</field>
        <field name="arch" type="xml">
            <list decoration-success="state=='active'" decoration-muted="state=='terminated'">
                <field name="name"/>
                <field name="client_id"/>
                <field name="plan_id"/>
                <field name="state" widget="badge"/>
                <field name="total_size_gb"/>
                <field name="last_backup_date"/>
            </list>
        </field>
    </record>

    <!-- Vue Formulaire Bases de Données SaaS -->
    <record id="view_saas_database_form" model="ir.ui.view">
        <field name="name">saas.database.form</field>
        <field name="model">saas.database</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="active,suspended,terminated"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Informations">
                            <field name="client_id" readonly="1"/>
                            <field name="plan_id" readonly="1"/>
                        </group>
                        <group string="Stockage">
                            <field name="total_size_gb" readonly="1"/>
                            <field name="postgresql_size_mb" readonly="1"/>
                            <field name="filestore_size_mb" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Activité">
                            <field name="last_backup_date" readonly="1"/>
                            <field name="last_update_date" readonly="1"/>
                            <field name="last_connection_date" readonly="1"/>
                        </group>
                        <group string="Statistiques">
                            <field name="nb_tables" readonly="1"/>
                            <field name="nb_records_total" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action Bases de Données SaaS -->
    <record id="action_saas_database" model="ir.actions.act_window">
        <field name="name">Bases de Données</field>
        <field name="res_model">saas.database</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucune base de données provisionnée
            </p>
            <p>
                Les bases de données sont créées automatiquement lors du provisioning des clients.
            </p>
        </field>
    </record>

</odoo>
