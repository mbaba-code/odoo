<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ========== SIGNATURE FORM VIEW ========== -->
    <record id="view_document_signature_form" model="ir.ui.view">
        <field name="name">onedesk.document.signature.form</field>
        <field name="model">onedesk.document.signature</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="signer_name"/>
                            <field name="signer_email"/>
                        </group>
                        <group>
                            <field name="status" readonly="1"/>
                            <field name="signature_date" readonly="1"/>
                        </group>
                    </group>
                    <group string="Signature Électronique" invisible="not signature_image">
                        <field name="signature_image" widget="image" options="{'size': [300, 100]}"/>
                    </group>
                    <group string="Position de la Signature sur le PDF" col="4">
                        <field name="signature_page" placeholder="-1 = dernière page"/>
                        <field name="signature_x" placeholder="0 = auto (droite)"/>
                        <field name="signature_y" placeholder="0 = auto (bas)"/>
                        <div colspan="4" class="alert alert-info" role="alert">
                            <strong>💡 Comment positionner la signature :</strong><br/>
                            • Page : -1 = dernière page, 0 = première page, 1 = deuxième page, etc.<br/>
                            • X et Y : Laisser à 0 pour position automatique (bas à droite)<br/>
                            • X : Distance depuis la gauche en points (72 points = 1 pouce = 2.54cm)<br/>
                            • Y : Distance depuis le bas en points<br/>
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ========== SIGNATURE TREE VIEW ========== -->
    <record id="view_document_signature_tree" model="ir.ui.view">
        <field name="name">onedesk.document.signature.tree</field>
        <field name="model">onedesk.document.signature</field>
        <field name="arch" type="xml">
            <list create="true" delete="true" editable="bottom">
                <field name="signer_name"/>
                <field name="signer_email"/>
                <field name="status" readonly="1"/>
                <field name="signature_date" readonly="1"/>
            </list>
        </field>
    </record>

</odoo>
