<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        FIX RESPONSIVITÉ: Override du layout login/signup pour mobile

        Problèmes corrigés:
        - Padding container trop grand sur mobile
        - Carte trop petite (300px) sur mobile
        - Texte et boutons mal dimensionnés

        NOTE: Le CSS est chargé directement ici (pas dans assets_frontend)
        pour éviter conflits avec le website builder qui parse les box-shadows
    -->

    <!-- Override login layout pour meilleure responsivité -->
    <template id="onedesk_core.login_layout_responsive" inherit_id="web.login_layout" name="OneDesk - Login Layout Responsive">
        <!-- Remplacer le container avec des styles responsifs -->
        <xpath expr="//div[hasclass('container', 'py-5')]" position="replace">
            <!-- Charger le CSS responsive uniquement sur pages de login -->
            <link rel="stylesheet" type="text/css" href="/onedesk_core/static/src/css/auth_responsive.css"/>

            <div class="container py-3 py-md-5 px-2 px-md-3">
                <div t-attf-class="card border-0 mx-auto bg-100 {{login_card_classes}} o_database_list onedesk-login-card">
                    <div class="card-body p-3 p-md-4">
                        <div class="text-center pb-3 border-bottom mb-4">
                            <img t-attf-src="/web/binary/company_logo{{ '?dbname='+db if db else '' }}"
                                 alt="Logo"
                                 class="onedesk-login-logo"/>
                        </div>
                        <t t-out="0"/>
                        <div class="text-center small mt-4 pt-3 border-top" t-if="not disable_footer">
                            <!-- SÉCURITÉ: Lien database manager supprimé pour éviter exposition publique -->
                            <a href="https://www.odoo.com?utm_source=db&amp;utm_medium=auth" target="_blank" class="d-inline-block">Powered by <span>Odoo</span></a>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

</odoo>
