<odoo>
    <!-- Search view for filtering properties -->
    <record id="view_property_search" model="ir.ui.view">
        <field name="name">onedesk.property.search</field>
        <field name="model">onedesk.property</field>
        <field name="arch" type="xml">
            <search string="Properties">
                <field name="name" string="Property Name"/>
                <field name="address" string="Address"/>
                <field name="company_id" string="Company"/>
                <separator/>
                <filter string="My Company" name="my_company" domain="[('company_id', '=', user.company_id.id)]"/>
                <filter string="All Companies" name="all_companies" domain="[(1, '=', 1)]"/>
            </search>
        </field>
    </record>

    <!-- Liste des propriétés -->
    <record id="view_property_list" model="ir.ui.view">
        <field name="name">onedesk.property.list</field>
        <field name="model">onedesk.property</field>
        <field name="arch" type="xml">
            <list string="Properties">
                <field name="name"/>
                <field name="property_type"/>
                <field name="address"/>
                <field name="total_units"/>
                <field name="total_revenue_month"/>
                <field name="total_occupancy_percentage"/>
            </list>
        </field>
    </record>

    <!-- Formulaire -->
    <record id="view_property_form" model="ir.ui.view">
        <field name="name">onedesk.property.form</field>
        <field name="model">onedesk.property</field>
        <field name="arch" type="xml">
            <form string="Property">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nom de la propriété"/>
                        </h1>
                    </div>
                    <notebook>
                        <page string="📋 Informations générales" name="general">
                            <group>
                                <group>
                                    <field name="property_type"/>
                                    <field name="address"/>
                                    <field name="user_id"/>
                                </group>
                                <group>
                                    <field name="total_units"/>
                                    <field name="total_revenue_month"/>
                                    <field name="total_occupancy_percentage"/>
                                </group>
                            </group>
                            <field name="description" placeholder="Description de la propriété..." nolabel="1"/>
                        </page>
                        <page string="🏘️ Propriétaire" name="owner">
                            <group>
                                <field name="owner_name"/>
                                <field name="owner_phone"/>
                                <field name="owner_email"/>
                            </group>
                        </page>
                        <page string="✨ Équipements" name="amenities">
                            <field name="amenities" placeholder="WiFi, Piscine, Parking, Climatisation, etc." nolabel="1"/>
                        </page>
                        <page string="📸 Photos" name="photos">
                            <separator string="Photo de couverture (depuis la galerie)"/>
                            <group>
                                <field name="cover_image" widget="image" options="{'size': [300, 300]}"/>
                            </group>
                            <p style="font-size: 11px; color: #999; margin-top: -10px;">
                                💡 Cette photo est automatiquement extraite de votre galerie (celle marquée 📌 comme couverture)
                            </p>

                            <separator string="🖼️ Galerie complète de photos (Mode Grille)"/>
                            <field name="image_ids" mode="kanban">
                                <kanban>
                                    <field name="id"/>
                                    <field name="image" widget="binary"/>
                                    <field name="name"/>
                                    <field name="is_cover"/>
                                    <templates>
                                        <t t-name="card">
                                            <div class="oe_kanban_card">
                                                <div class="oe_kanban_global_click" style="position: relative;">
                                                    <!-- Photo -->
                                                    <div style="height: 180px; margin-bottom: 8px; border-radius: 5px; overflow: hidden; background: #f0f0f0; display: flex; align-items: center; justify-content: center;">
                                                        <t t-if="record.image.raw_value">
                                                            <img t-att-src="'data:image/*;base64,' + record.image.raw_value" style="width: 100%; height: 100%; object-fit: cover;" alt="Photo"/>
                                                        </t>
                                                        <t t-else="">
                                                            <i class="fa fa-image fa-3x" style="color: #ccc;" title="Pas de photo"></i>
                                                        </t>
                                                        <!-- Cover Badge -->
                                                        <t t-if="record.is_cover.value">
                                                            <div style="position: absolute; top: 5px; right: 5px; background: #28a745; color: white; padding: 4px 8px; border-radius: 3px; font-size: 11px; font-weight: bold;">
                                                                📌
                                                            </div>
                                                        </t>
                                                    </div>
                                                    <!-- Name -->
                                                    <h5 style="margin: 0; font-size: 12px; font-weight: bold; text-align: center;">
                                                        <field name="name"/>
                                                    </h5>
                                                </div>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>

                            <separator string="Ajouter une nouvelle photo"/>
                            <field name="image_ids">
                                <list string="Photos" editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="is_cover" widget="boolean"/>
                                    <field name="name"/>
                                    <field name="image" widget="image" optional="hide"/>
                                </list>
                            </field>
                            <p style="margin-top: 10px; font-size: 12px; color: #999;">
                                💡 <strong>Astuce:</strong> Grille: vue d'ensemble des photos | Table: ajouter/modifier photos, cochez "📌" pour sélectionner la couverture
                            </p>
                        </page>
                        <page string="🏠 Unités" name="units">
                            <field name="unit_ids" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Kanban Grid View -->
    <record id="view_property_kanban" model="ir.ui.view">
        <field name="name">onedesk.property.kanban</field>
        <field name="model">onedesk.property</field>
        <field name="arch" type="xml">
            <kanban string="Properties Grid">
                <field name="id"/>
                <field name="name"/>
                <field name="cover_image_id"/>
                <field name="property_type"/>
                <field name="total_units"/>
                <field name="total_revenue_month"/>
                <field name="total_occupancy_percentage"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card">
                            <div class="oe_kanban_global_click">
                                <!-- Image -->
                                <div style="height: 200px; margin-bottom: 10px; border-radius: 5px; overflow: hidden; background: #f0f0f0; display: flex; align-items: center; justify-content: center;">
                                    <t t-if="record.cover_image_id.value">
                                        <img t-att-src="'/web/image/onedesk.property.image/' + record.cover_image_id.value + '/image'" style="width: 100%; height: 100%; object-fit: cover;" alt="Property photo"/>
                                    </t>
                                    <t t-else="">
                                        <i class="fa fa-image fa-3x" style="color: #ccc;" title="Pas de photo"></i>
                                    </t>
                                </div>

                                <!-- Info -->
                                <h3 style="margin: 5px 0; font-weight: bold;">
                                    <field name="name"/>
                                </h3>

                                <div style="font-size: 12px; color: #666; margin-bottom: 8px;">
                                    <span class="badge badge-light">
                                        <field name="property_type"/>
                                    </span>
                                </div>

                                <hr style="margin: 8px 0;"/>

                                <!-- Stats -->
                                <div style="font-size: 11px;">
                                    <div style="margin-bottom: 4px;">
                                        <strong>🏠 Unités:</strong>
                                        <span style="float: right;">
                                            <field name="total_units"/>
                                        </span>
                                    </div>
                                    <div style="margin-bottom: 4px;">
                                        <strong>💰 Revenus:</strong>
                                        <span style="float: right; color: #28a745;">
                                            <field name="total_revenue_month" widget="monetary"/>
                                        </span>
                                    </div>
                                    <div>
                                        <strong>📈 Occupation:</strong>
                                        <span style="float: right;">
                                            <field name="total_occupancy_percentage"/>%
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action pour ouvrir la vue -->
    <record id="action_onedesk_property" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">onedesk.property</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <!-- Sous-menu Propriétés -->
    <menuitem id="menu_onedesk_property" name="Properties"
              parent="menu_onedesk_root"
              action="action_onedesk_property"/>

    <record id="view_property_calendar" model="ir.ui.view">
    <field name="name">property.calendar</field>
    <field name="model">onedesk.property</field>
    <field name="arch" type="xml">
        <calendar string="Calendrier des propriétés" date_start="date_start" date_stop="date_stop" color="user_id">
            <field name="name"/>
        </calendar>
    </field>
</record>

</odoo>
