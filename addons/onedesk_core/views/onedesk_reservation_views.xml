<odoo>
    <!-- Search view for filtering reservations -->
    <record id="view_reservation_search" model="ir.ui.view">
        <field name="name">onedesk.reservation.search</field>
        <field name="model">onedesk.reservation</field>
        <field name="arch" type="xml">
            <search string="Reservations">
                <field name="name" string="Reservation"/>
                <field name="unit_id" string="Unit"/>
                <field name="partner_id" string="Customer"/>
                <field name="company_id" string="Company"/>
                <separator/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                <separator/>
                <!-- Filtres Chronologie -->
                <filter string="Cette Semaine" name="week"
                    domain="[('start_date', '&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d')),
                             ('start_date', '&lt;=', (context_today() + datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <filter string="Ce Mois" name="month"
                    domain="[('start_date', '&gt;=', (context_today() - datetime.timedelta(days=30)).strftime('%Y-%m-%d')),
                             ('start_date', '&lt;=', (context_today() + datetime.timedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <filter string="À Venir" name="upcoming"
                    domain="[('start_date', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <!-- Filtres Accès Rapide -->
                <filter string="Arrivées Aujourd'hui" name="checkin_today"
                    domain="[('start_date', '&gt;=', context_today().strftime('%Y-%m-%d')),
                             ('start_date', '&lt;', (context_today() + datetime.timedelta(days=1)).strftime('%Y-%m-%d')),
                             ('status', 'in', ['paid', 'checked_in'])]"/>
                <filter string="Départs Aujourd'hui" name="checkout_today"
                    domain="[('end_date', '&gt;=', context_today().strftime('%Y-%m-%d')),
                             ('end_date', '&lt;', (context_today() + datetime.timedelta(days=1)).strftime('%Y-%m-%d')),
                             ('status', 'in', ['checked_in', 'completed'])]"/>
            </search>
        </field>
    </record>

    <!-- Vue liste -->
    <record id="view_reservation_list" model="ir.ui.view">
        <field name="name">onedesk.reservation.list</field>
        <field name="model">onedesk.reservation</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="unit_id"/>
                <field name="partner_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="number_of_nights"/>
                <field name="total_price" widget="monetary"/>
                <field name="status" widget="badge"/>
                <field name="payment_status" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Vue formulaire -->
    <record id="view_reservation_form" model="ir.ui.view">
        <field name="name">onedesk.reservation.form</field>
        <field name="model">onedesk.reservation</field>
        <field name="arch" type="xml">
            <form string="Reservation">
                <header>
                    <!-- Boutons sans states -->
                    <button name="action_generate_payment_link" type="object"
                            string="💳 Générer Lien Paiement"
                            class="oe_highlight"/>
                    <button name="action_check_payment_status" type="object"
                            string="✓ Vérifier Statut Paiement"
                            class="oe_link"/>
                    <field name="payment_status" widget="statusbar" options="{'clickable': False}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" class="oe_inline"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="unit_id" required="1"/>
                            <field name="partner_id" required="1"/>
                        </group>
                        <group>
                            <field name="start_date" required="1"/>
                            <field name="end_date" required="1"/>
                        </group>
                    </group>

                    <!-- Section Tarification -->
                    <separator string="💰 Tarification"/>
                    <group>
                        <group>
                            <field name="number_of_nights" readonly="1"/>
                            <field name="price_per_night" readonly="1" widget="monetary"/>
                        </group>
                        <group>
                            <field name="total_price" readonly="1" widget="monetary" nolabel="1"/>
                        </group>
                    </group>

                    <!-- Override Prix -->
                    <group>
                        <group>
                            <field name="override_price_per_night" widget="monetary"
                                   help="Remplissez pour appliquer un prix différent du prix calculé automatiquement"/>
                        </group>
                        <group>
                            <field name="override_reason" placeholder="Ex: Remise client, Prix spécial, Correction erreur"/>
                        </group>
                    </group>

                    <!-- Section Paiement -->
                    <separator string="💳 Paiement"/>
                    <group>
                        <field name="payment_link" widget="url" readonly="1"
                               help="Lien pour que le client paie cette réservation"/>
                        <field name="amount_paid" readonly="1" widget="monetary"/>
                    </group>

                    <!-- Transactions de paiement -->
                    <separator string="📊 Transactions de paiement"/>
                    <field name="transaction_ids" readonly="1" nolabel="1">
                        <list>
                            <field name="reference"/>
                            <field name="provider_code"/>
                            <field name="amount"/>
                            <field name="state"/>
                            <field name="last_state_change"/>
                        </list>
                    </field>

                    <!-- Status Workflow -->
                    <separator string="📊 Statut de la réservation"/>
                    <field name="status" widget="statusbar" options="{'clickable': True}"/>

                    <!-- Notes Client & Interne -->
                    <separator string="📝 Notes et demandes spéciales"/>
                    <group>
                        <group>
                            <field name="guest_notes" placeholder="Notes du client (allergies, préférences)..." nolabel="1"/>
                        </group>
                        <group>
                            <field name="internal_notes" placeholder="Notes internes pour l'équipe..." nolabel="1"/>
                        </group>
                    </group>

                    <!-- Invoice & Documents -->
                    <separator string="📄 Factures et documents"/>
                    <group>
                        <field name="invoice_id" readonly="1"/>
                        <field name="special_requests" placeholder="Demandes spéciales (lit bébé, etc.)..."/>
                    </group>

                    <!-- Section Photos d'inspection -->
                    <notebook>
                        <page string="📸 Galerie complète d'inspection">
                            <!-- Bouton pour copier les images de l'unité automatiquement -->
                            <button type="object" name="action_copy_unit_images" string="📋 Copier photos de l'unité"
                                    class="btn btn-primary" icon="fa-copy"/>
                            <button type="action" name="onedesk_core.action_onedesk_image_upload_wizard"
                                    string="📤 Ajouter des photos" class="btn btn-success" icon="fa-upload"
                                    context="{'default_reservation_id': id}" style="margin-left: 10px;"/>
                            <p style="margin-top: 10px; font-size: 12px; color: #666;">
                                💡 <strong>Astuce rapide:</strong> Cliquez sur ce bouton pour copier automatiquement toutes les photos de l'unité en tant que photos de check-in. Ou utilisez "Ajouter des photos" pour uploader de nouvelles photos de check-in/check-out/dégâts directement.
                            </p>

                            <separator string="📸 Galerie de photos"/>
                            <field name="image_ids" mode="kanban">
                                <kanban>
                                    <field name="id"/>
                                    <field name="image" widget="binary"/>
                                    <field name="name"/>
                                    <field name="image_type"/>
                                    <templates>
                                        <t t-name="card">
                                            <div class="oe_kanban_card">
                                                <div class="oe_kanban_global_click" style="position: relative;">
                                                    <!-- Photo -->
                                                    <div style="height: 180px; margin-bottom: 8px; border-radius: 5px; overflow: hidden; background: #f0f0f0; display: flex; align-items: center; justify-content: center;">
                                                        <t t-if="record.image.raw_value">
                                                            <img t-att-src="'data:image/*;base64,' + record.image.raw_value" style="width: 100%; height: 100%; object-fit: cover;" alt="Photo"/>
                                                        </t>
                                                        <t t-else="">
                                                            <i class="fa fa-image fa-3x" style="color: #ccc;" title="Pas de photo"></i>
                                                        </t>
                                                    </div>
                                                    <!-- Type badge -->
                                                    <div style="font-size: 11px; margin-bottom: 4px; padding: 2px 6px; background: #f0f0f0; border-radius: 3px;">
                                                        <field name="image_type"/>
                                                    </div>
                                                    <!-- Name -->
                                                    <h5 style="margin: 0; font-size: 12px; font-weight: bold; text-align: center;">
                                                        <field name="name"/>
                                                    </h5>
                                                </div>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>

                            <separator string="Gérer les photos"/>
                            <p style="margin-bottom: 10px; font-size: 12px; color: #666;">
                                💡 Utilisez les boutons ci-dessus pour gérer vos photos d'inspection:
                                <br/>• 📋 Copier photos de l'unité (rapide pour check-in)
                                <br/>• 📤 Ajouter des photos (pour check-out ou dégâts)
                            </p>
                        </page>
                        <page string="Événement calendrier">
                            <field name="calendar_event_id" readonly="1"/>
                        </page>
                        <page string="Intégration">
                            <field name="external_id" readonly="1"/>
                            <field name="integration_id" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Kanban Grid View -->
    <record id="view_reservation_kanban" model="ir.ui.view">
        <field name="name">onedesk.reservation.kanban</field>
        <field name="model">onedesk.reservation</field>
        <field name="arch" type="xml">
            <kanban string="Reservations Grid">
                <field name="id"/>
                <field name="name"/>
                <field name="cover_image_id"/>
                <field name="partner_id"/>
                <field name="unit_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="number_of_nights"/>
                <field name="status"/>
                <field name="total_price"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card">
                            <div class="oe_kanban_global_click">
                                <!-- Photo -->
                                <div style="height: 180px; margin-bottom: 10px; border-radius: 5px; overflow: hidden; background: #f0f0f0; display: flex; align-items: center; justify-content: center;">
                                    <t t-if="record.cover_image_id.value">
                                        <img t-att-src="'/web/image/onedesk.reservation.image/' + record.cover_image_id.value + '/image'" style="width: 100%; height: 100%; object-fit: cover;" alt="Photo"/>
                                    </t>
                                    <t t-else="">
                                        <i class="fa fa-camera fa-3x" style="color: #ccc;" title="Pas de photo"></i>
                                    </t>
                                </div>

                                <!-- Reservation Info -->
                                <h4 style="margin: 5px 0; font-weight: bold;">
                                    <field name="name"/>
                                </h4>

                                <div style="font-size: 12px; color: #666; margin-bottom: 8px;">
                                    <strong>👤</strong>
                                    <field name="partner_id"/>
                                </div>

                                <div style="font-size: 11px; color: #999; margin-bottom: 8px;">
                                    <field name="unit_id"/>
                                </div>

                                <hr style="margin: 8px 0;"/>

                                <!-- Dates & Status -->
                                <div style="font-size: 10px;">
                                    <div style="margin-bottom: 4px;">
                                        <strong>📅 Dates:</strong>
                                        <span style="float: right;">
                                            <field name="number_of_nights"/>n
                                        </span>
                                    </div>
                                    <div style="margin-bottom: 4px;">
                                        <strong>💰 Total:</strong>
                                        <span style="float: right; color: #17a2b8;">
                                            <field name="total_price" widget="monetary"/>
                                        </span>
                                    </div>
                                    <div>
                                        <t t-if="record.status.value in ['paid', 'checked_in', 'completed']">
                                            <span class="badge bg-success">
                                                <field name="status"/>
                                            </span>
                                        </t>
                                        <t t-elif="record.status.value == 'pending_payment'">
                                            <span class="badge bg-warning">
                                                <field name="status"/>
                                            </span>
                                        </t>
                                        <t t-elif="record.status.value == 'cancelled'">
                                            <span class="badge bg-danger">
                                                <field name="status"/>
                                            </span>
                                        </t>
                                        <t t-else="">
                                            <span class="badge bg-info">
                                                <field name="status"/>
                                            </span>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Vue calendrier -->
    <record id="view_reservation_calendar" model="ir.ui.view">
        <field name="name">onedesk.reservation.calendar</field>
        <field name="model">onedesk.reservation</field>
        <field name="arch" type="xml">
            <calendar string="Reservations" date_start="start_date" date_stop="end_date">
                <field name="name"/>
                <field name="unit_id"/>
                <field name="partner_id"/>
            </calendar>
        </field>
    </record>

    <!-- Action pour ouvrir les réservations -->
    <record id="action_reservations" model="ir.actions.act_window">
        <field name="name">Reservations</field>
        <field name="res_model">onedesk.reservation</field>
        <field name="view_mode">kanban,list,form,calendar</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Créez une nouvelle réservation.
            </p>
        </field>
    </record>

    <!-- Reservations Calendar View - Professional Schedule -->
    <record id="view_onedesk_reservation_calendar" model="ir.ui.view">
        <field name="name">OneDesk Reservations Calendar</field>
        <field name="model">onedesk.reservation</field>
        <field name="priority">25</field>
        <field name="arch" type="xml">
            <calendar string="📅 Calendrier des Réservations" date_start="start_date" date_stop="end_date" color="status" mode="month" event_open_popup="true">
                <field name="unit_id"/>
                <field name="partner_id"/>
                <field name="status"/>
                <field name="total_price"/>
                <field name="payment_status"/>
            </calendar>
        </field>
    </record>

    <!-- Reservations Calendar Action -->
    <record id="action_reservation_calendar" model="ir.actions.act_window">
        <field name="name">Calendrier des Réservations</field>
        <field name="res_model">onedesk.reservation</field>
        <field name="view_mode">calendar,list,form,kanban</field>
        <field name="context">{'default_status': 'confirmed'}</field>
        <field name="view_ids" eval="[
            (5, 0),
            (0, 0, {'view_mode': 'calendar', 'view_id': ref('view_onedesk_reservation_calendar')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_reservation_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_reservation_form')}),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_reservation_kanban')})
        ]"/>
    </record>

    <!-- Graph View for Analytics -->
    <record id="view_reservation_graph" model="ir.ui.view">
        <field name="name">onedesk.reservation.graph</field>
        <field name="model">onedesk.reservation</field>
        <field name="arch" type="xml">
            <graph string="Réservations" type="bar">
                <field name="unit_id" type="row"/>
                <field name="total_price" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Pivot View for Analysis -->
    <record id="view_reservation_pivot" model="ir.ui.view">
        <field name="name">onedesk.reservation.pivot</field>
        <field name="model">onedesk.reservation</field>
        <field name="arch" type="xml">
            <pivot string="Réservations">
                <field name="start_date" type="row" interval="month"/>
                <field name="unit_id" type="column"/>
                <field name="total_price" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- ==================== ACTIONS PAR STATUT ==================== -->

    <!-- Réservations En Attente -->
    <record id="action_reservations_pending" model="ir.actions.act_window">
        <field name="name">Réservations En Attente</field>
        <field name="res_model">onedesk.reservation</field>
        <field name="view_mode">kanban,list,form,calendar</field>
        <field name="domain">[('status', '=', 'pending_payment')]</field>
        <field name="context">{'default_status': 'pending_payment'}</field>
    </record>

    <!-- Réservations Confirmées -->
    <record id="action_reservations_confirmed" model="ir.actions.act_window">
        <field name="name">Réservations Confirmées</field>
        <field name="res_model">onedesk.reservation</field>
        <field name="view_mode">kanban,list,form,calendar</field>
        <field name="domain">[('status', '=', 'paid')]</field>
        <field name="context">{'default_status': 'paid'}</field>
    </record>

    <!-- Réservations Enregistrées (Check-in) -->
    <record id="action_reservations_checkedin" model="ir.actions.act_window">
        <field name="name">Réservations Enregistrées</field>
        <field name="res_model">onedesk.reservation</field>
        <field name="view_mode">kanban,list,form,calendar</field>
        <field name="domain">[('status', '=', 'checked_in')]</field>
        <field name="context">{'default_status': 'checked_in'}</field>
    </record>

    <!-- Réservations Complétées -->
    <record id="action_reservations_completed" model="ir.actions.act_window">
        <field name="name">Réservations Complétées</field>
        <field name="res_model">onedesk.reservation</field>
        <field name="view_mode">kanban,list,form,calendar</field>
        <field name="domain">[('status', '=', 'completed')]</field>
        <field name="context">{'default_status': 'completed'}</field>
    </record>

    <!-- Réservations Annulées -->
    <record id="action_reservations_cancelled" model="ir.actions.act_window">
        <field name="name">Réservations Annulées</field>
        <field name="res_model">onedesk.reservation</field>
        <field name="view_mode">kanban,list,form,calendar</field>
        <field name="domain">[('status', '=', 'cancelled')]</field>
        <field name="context">{'default_status': 'cancelled'}</field>
    </record>

</odoo>
