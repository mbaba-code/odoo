<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Actions pour métriques et alertes (définies avant les vues qui les référencent) -->
    <record id="action_saas_metric_from_client" model="ir.actions.act_window">
        <field name="name">Métriques</field>
        <field name="res_model">saas.metric</field>
        <field name="view_mode">graph,list</field>
        <field name="domain">[('client_id', '=', active_id)]</field>
        <field name="context">{'default_client_id': active_id}</field>
    </record>

    <record id="action_saas_alert_from_client" model="ir.actions.act_window">
        <field name="name">Alertes</field>
        <field name="res_model">saas.alert</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('client_id', '=', active_id)]</field>
        <field name="context">{'default_client_id': active_id}</field>
    </record>

    <!-- Vue Liste Clients SaaS -->
    <record id="view_saas_client_tree" model="ir.ui.view">
        <field name="name">saas.client.tree</field>
        <field name="model">saas.client</field>
        <field name="arch" type="xml">
            <list string="Clients SaaS" decoration-success="database_state=='active'"
                  decoration-danger="database_state=='error'" decoration-warning="database_state=='suspended'"
                  decoration-muted="database_state=='terminated'">
                <field name="name"/>
                <field name="company_name"/>
                <field name="email"/>
                <field name="plan_id"/>
                <field name="subscription_state" widget="badge"
                       decoration-success="subscription_state=='active'"
                       decoration-info="subscription_state=='trial'"
                       decoration-warning="subscription_state=='past_due'"
                       decoration-danger="subscription_state in ['suspended', 'cancelled']"/>
                <field name="database_state" widget="badge"
                       decoration-success="database_state=='active'"
                       decoration-warning="database_state=='provisioning'"
                       decoration-danger="database_state=='error'"/>
                <field name="url" widget="url"/>
                <field name="nb_users"/>
                <field name="storage_used_gb" widget="float"/>
                <field name="trial_end_date"/>
                <field name="created_date"/>
            </list>
        </field>
    </record>

    <!-- Vue Formulaire Clients SaaS -->
    <record id="view_saas_client_form" model="ir.ui.view">
        <field name="name">saas.client.form</field>
        <field name="model">saas.client</field>
        <field name="arch" type="xml">
            <form string="Client SaaS">
                <header>
                    <!-- Boutons d'action selon l'état -->
                    <button name="action_provision_database" type="object" string="Provisionner"
                            class="oe_highlight" invisible="database_state != 'draft'"/>
                    <button name="action_suspend" type="object" string="Suspendre"
                            invisible="database_state not in ['active']"/>
                    <button name="action_activate" type="object" string="Réactiver"
                            invisible="database_state != 'suspended'"/>
                    <button name="action_reset_and_reprovision" type="object" string="Reset &amp; Reprovisionner"
                            confirm="ATTENTION: Cette action va supprimer complètement la base de données et recommencer. Continuer?"
                            invisible="database_state not in ['draft', 'error']"/>
                    <button name="action_terminate" type="object" string="Terminer"
                            confirm="ATTENTION: Cette action est irréversible. La base sera terminée. Continuer?"
                            invisible="database_state in ['draft', 'terminated']"/>

                    <field name="database_state" widget="statusbar"
                           statusbar_visible="draft,provisioning,active"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options="{'terminology': 'archive'}"/>
                        </button>
                        <button name="%(action_saas_metric_from_client)d" type="action"
                                class="oe_stat_button" icon="fa-line-chart">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Métriques</span>
                            </div>
                        </button>
                        <button name="%(action_saas_alert_from_client)d" type="action"
                                class="oe_stat_button" icon="fa-exclamation-triangle"
                                invisible="not alert_ids">
                            <field name="alert_ids" widget="statinfo" string="Alertes"/>
                        </button>
                    </div>

                    <!-- Afficher erreur si existe -->
                    <div class="alert alert-danger" role="alert" invisible="not database_error">
                        <strong>Erreur de provisioning:</strong>
                        <field name="database_error"/>
                    </div>

                    <!-- Afficher quotas dépassés -->
                    <div class="alert alert-warning" role="alert"
                         invisible="not quota_users_exceeded and not quota_storage_exceeded and not quota_api_exceeded">
                        <strong>⚠️ Quotas dépassés:</strong>
                        <ul class="mb-0">
                            <li invisible="not quota_users_exceeded">
                                Utilisateurs: <field name="nb_users"/> / <field name="plan_id" readonly="1" string=""/> max
                            </li>
                            <li invisible="not quota_storage_exceeded">
                                Stockage: <field name="storage_used_gb"/> GB utilisés
                            </li>
                            <li invisible="not quota_api_exceeded">
                                API Calls: <field name="api_calls_today"/> appels aujourd'hui
                            </li>
                        </ul>
                    </div>

                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="Nom du contact"/></h1>
                        <h2><field name="company_name" placeholder="Nom de la société"/></h2>
                    </div>

                    <group>
                        <group string="Informations Client">
                            <field name="email" widget="email"/>
                            <field name="phone" widget="phone"/>
                            <field name="plan_id" options="{'no_create': True}"/>
                            <field name="subscription_billing"/>
                        </group>
                        <group string="État &amp; Abonnement">
                            <field name="subscription_state"/>
                            <field name="is_trial" invisible="1"/>
                            <field name="trial_start_date" invisible="not is_trial"/>
                            <field name="trial_end_date" invisible="not is_trial"/>
                            <field name="days_until_trial_end" invisible="not is_trial"/>
                            <field name="subscription_start_date" invisible="subscription_state not in ['active', 'past_due']"/>
                            <field name="next_billing_date" invisible="subscription_state not in ['active', 'past_due']"/>
                            <field name="cancelled_date" invisible="subscription_state != 'cancelled'"/>
                        </group>
                    </group>

                    <group>
                        <group string="Base de Données">
                            <field name="database_name" readonly="1"/>
                            <field name="database_id" readonly="1"/>
                            <field name="subdomain"/>
                            <field name="custom_domain"/>
                            <field name="url" widget="url"/>
                        </group>
                        <group string="Accès Admin Client">
                            <field name="admin_login" readonly="1"/>
                            <field name="admin_password_temp" password="True" readonly="1"
                                   invisible="not admin_password_temp"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Métriques d'Utilisation">
                            <group>
                                <group string="Utilisateurs">
                                    <field name="nb_users"/>
                                    <field name="nb_active_users"/>
                                    <field name="last_login"/>
                                </group>
                                <group string="Ressources">
                                    <field name="storage_used_gb"/>
                                    <field name="api_calls_today"/>
                                </group>
                            </group>
                            <group>
                                <group string="Quotas Dépassés">
                                    <field name="quota_users_exceeded"/>
                                    <field name="quota_storage_exceeded"/>
                                    <field name="quota_api_exceeded"/>
                                </group>
                            </group>
                        </page>
                        <page string="Facturation">
                            <group>
                                <field name="total_revenue" widget="float" string="Revenu Total (€)"/>
                            </group>
                        </page>
                        <page string="Historique Métriques" name="metrics">
                            <field name="metric_ids">
                                <list>
                                    <field name="recorded_at"/>
                                    <field name="metric_type"/>
                                    <field name="value"/>
                                    <field name="unit"/>
                                </list>
                            </field>
                        </page>
                        <page string="Alertes" name="alerts" invisible="not alert_ids">
                            <field name="alert_ids">
                                <list decoration-warning="severity=='warning'" decoration-danger="severity in ['error', 'critical']">
                                    <field name="created_at"/>
                                    <field name="alert_type"/>
                                    <field name="severity" widget="badge"/>
                                    <field name="message"/>
                                    <field name="resolved" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Vue Kanban Clients SaaS -->
    <record id="view_saas_client_kanban" model="ir.ui.view">
        <field name="name">saas.client.kanban</field>
        <field name="model">saas.client</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="database_state">
                <field name="name"/>
                <field name="company_name"/>
                <field name="plan_id"/>
                <field name="database_state"/>
                <field name="subscription_state"/>
                <field name="url"/>
                <field name="nb_users"/>
                <field name="storage_used_gb"/>
                <field name="quota_users_exceeded"/>
                <field name="quota_storage_exceeded"/>
                <progressbar field="database_state" colors='{"active": "success", "error": "danger", "suspended": "warning", "provisioning": "info"}'/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top mb-2">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title"><field name="company_name"/></strong>
                                    <div class="text-muted"><field name="name"/></div>
                                </div>
                                <span class="float-end">
                                    <span class="badge badge-pill" t-att-class="{'badge-success': record.subscription_state.raw_value == 'active', 'badge-info': record.subscription_state.raw_value == 'trial', 'badge-danger': record.subscription_state.raw_value == 'cancelled'}">
                                        <field name="subscription_state"/>
                                    </span>
                                </span>
                            </div>
                            <div class="o_kanban_record_body">
                                <div><i class="fa fa-cube" title="Plan"/> <field name="plan_id"/></div>
                                <div><i class="fa fa-users" title="Utilisateurs"/> <field name="nb_users"/> utilisateurs</div>
                                <div><i class="fa fa-database" title="Stockage"/> <field name="storage_used_gb"/> GB</div>
                                <div t-if="record.url.raw_value">
                                    <i class="fa fa-external-link" title="URL"/> <field name="url" widget="url"/>
                                </div>
                                <div t-if="record.quota_users_exceeded.raw_value or record.quota_storage_exceeded.raw_value" class="text-danger mt-2">
                                    <i class="fa fa-exclamation-triangle" title="Attention"/> Quotas dépassés
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Vue Recherche/Filtres -->
    <record id="view_saas_client_search" model="ir.ui.view">
        <field name="name">saas.client.search</field>
        <field name="model">saas.client</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="company_name"/>
                <field name="email"/>
            </search>
        </field>
    </record>

    <!-- Action Clients SaaS -->
    <record id="action_saas_client" model="ir.actions.act_window">
        <field name="name">Clients SaaS</field>
        <field name="res_model">saas.client</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_active_db': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez votre premier client SaaS!
            </p>
            <p>
                Les clients SaaS disposent chacun de leur propre base de données Odoo indépendante.
            </p>
        </field>
    </record>

</odoo>
