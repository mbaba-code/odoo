<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ========================================
         RESERVATIONS DASHBOARD - SEARCH VIEW
         ======================================== -->
    <record id="view_dashboard_reservations_search" model="ir.ui.view">
        <field name="name">onedesk.dashboard.reservations.search</field>
        <field name="model">onedesk.dashboard.reservations</field>
        <field name="arch" type="xml">
            <search string="Reservations Dashboard Filters">
                <field name="user_id" string="User"/>
                <field name="company_id" string="Company"/>
                <separator/>
                <filter string="Today" name="today" domain="[('period_type', '=', 'today')]"/>
                <filter string="This Week" name="week" domain="[('period_type', '=', 'week')]"/>
                <filter string="This Month" name="month" domain="[('period_type', '=', 'month')]"/>
                <filter string="This Year" name="year" domain="[('period_type', '=', 'year')]"/>
            </search>
        </field>
    </record>

    <!-- ========================================
         RESERVATIONS DASHBOARD - KANBAN VIEW
         ======================================== -->
    <record id="view_dashboard_reservations_kanban" model="ir.ui.view">
        <field name="name">onedesk.dashboard.reservations.kanban</field>
        <field name="model">onedesk.dashboard.reservations</field>
        <field name="arch" type="xml">
            <kanban string="Reservations Dashboard" default_group_by="period_type">
                <field name="id"/>
                <field name="user_id"/>
                <field name="company_id"/>
                <field name="period_type"/>
                <field name="total_reservations"/>
                <field name="active_reservations"/>
                <field name="occupancy_rate"/>
                <field name="total_nights"/>
                <field name="reservation_growth"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card">
                            <div class="oe_kanban_global_click">
                                <!-- Header -->
                                <div style="background: linear-gradient(135deg, #17a2b8 0%, #138496 100%); color: white; padding: 12px; border-radius: 4px 4px 0 0; margin: -4px -4px 8px -4px;">
                                    <h4 style="margin: 0; font-weight: bold;">
                                        <field name="user_id"/>
                                    </h4>
                                    <div style="font-size: 11px; opacity: 0.9;">
                                        <field name="company_id"/>
                                    </div>
                                </div>

                                <!-- Main Metrics -->
                                <div style="padding: 10px;">
                                    <!-- Total Reservations -->
                                    <div style="margin-bottom: 12px; padding: 8px; background: #e7f3ff; border-left: 4px solid #17a2b8; border-radius: 2px;">
                                        <div style="font-size: 10px; color: #666; margin-bottom: 2px;">📋 Total Reservations</div>
                                        <div style="font-size: 16px; font-weight: bold; color: #17a2b8;">
                                            <field name="total_reservations"/>
                                        </div>
                                    </div>

                                    <!-- Active Reservations -->
                                    <div style="margin-bottom: 12px; padding: 8px; background: #f0f9ff; border-left: 4px solid #0066cc; border-radius: 2px;">
                                        <div style="font-size: 10px; color: #666; margin-bottom: 2px;">✅ Active</div>
                                        <div style="font-size: 14px; font-weight: bold; color: #0066cc;">
                                            <field name="active_reservations"/> active
                                        </div>
                                    </div>

                                    <!-- Occupancy Rate -->
                                    <div style="margin-bottom: 12px; padding: 8px; background: #f0fff4; border-left: 4px solid #28a745; border-radius: 2px;">
                                        <div style="font-size: 10px; color: #666; margin-bottom: 2px;">📊 Occupancy Rate</div>
                                        <div style="font-size: 14px; font-weight: bold; color: #28a745;">
                                            <field name="occupancy_rate"/>%
                                        </div>
                                    </div>

                                    <!-- Total Nights -->
                                    <div style="margin-bottom: 12px; padding: 8px; background: #fff9f0; border-left: 4px solid #ffc107; border-radius: 2px;">
                                        <div style="font-size: 10px; color: #666; margin-bottom: 2px;">🌙 Total Nights</div>
                                        <div style="font-size: 14px; font-weight: bold; color: #ffc107;">
                                            <field name="total_nights"/> nights
                                        </div>
                                    </div>

                                    <!-- Growth Rate -->
                                    <div style="margin-bottom: 12px; padding: 8px; border-left: 4px solid #28a745; border-radius: 2px;" t-attf-style="background: #{{'f0fff4' if record.reservation_growth.value >= 0 else 'fff0f0'}}">
                                        <div style="font-size: 10px; color: #666; margin-bottom: 2px;">📈 Growth</div>
                                        <div t-attf-style="font-size: 14px; font-weight: bold; color: #{{'28a745' if record.reservation_growth.value >= 0 else 'dc3545'}}">
                                            <field name="reservation_growth"/>%
                                        </div>
                                    </div>

                                    <!-- Period -->
                                    <div style="padding: 8px; background: #f9f9f9; border-left: 4px solid #999; border-radius: 2px;">
                                        <div style="font-size: 10px; color: #666; margin-bottom: 2px;">📅 Period</div>
                                        <div style="font-size: 12px; font-weight: bold; color: #333;">
                                            <field name="period_type"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ========================================
         RESERVATIONS DASHBOARD - LIST VIEW
         ======================================== -->
    <record id="view_dashboard_reservations_list" model="ir.ui.view">
        <field name="name">onedesk.dashboard.reservations.list</field>
        <field name="model">onedesk.dashboard.reservations</field>
        <field name="arch" type="xml">
            <list string="Reservations Dashboard">
                <field name="user_id"/>
                <field name="company_id"/>
                <field name="period_type"/>
                <field name="total_reservations"/>
                <field name="active_reservations"/>
                <field name="pending_reservations"/>
                <field name="cancelled_reservations"/>
                <field name="total_nights"/>
                <field name="occupancy_rate"/>
                <field name="average_stay"/>
                <field name="reservation_growth"/>
            </list>
        </field>
    </record>

    <!-- ========================================
         RESERVATIONS DASHBOARD - CALENDAR VIEW
         ======================================== -->
    <record id="view_dashboard_reservations_calendar" model="ir.ui.view">
        <field name="name">onedesk.dashboard.reservations.calendar</field>
        <field name="model">onedesk.dashboard.reservations</field>
        <field name="arch" type="xml">
            <calendar string="Reservations Timeline" date_start="date_from" date_stop="date_to" mode="month" color="period_type">
                <field name="user_id"/>
                <field name="total_reservations"/>
                <field name="occupancy_rate"/>
                <field name="period_type"/>
            </calendar>
        </field>
    </record>

    <!-- ========================================
         RESERVATIONS DASHBOARD - FORM VIEW
         ======================================== -->
    <record id="view_dashboard_reservations_form" model="ir.ui.view">
        <field name="name">onedesk.dashboard.reservations.form</field>
        <field name="model">onedesk.dashboard.reservations</field>
        <field name="arch" type="xml">
            <form string="Reservations Dashboard" create="true">
                <!-- Header with gradient -->
                <div style="background: linear-gradient(135deg, #17a2b8 0%, #138496 100%); color: white; padding: 20px; margin: -16px -16px 16px -16px; border-radius: 4px 4px 0 0;">
                    <h2 style="margin: 0;">📋 Reservations Dashboard</h2>
                    <p style="margin: 5px 0 0 0; opacity: 0.9; font-size: 13px;">Track reservations, occupancy, and booking trends</p>
                </div>

                <!-- Basic Info -->
                <group>
                    <group>
                        <field name="user_id"/>
                        <field name="company_id"/>
                    </group>
                    <group>
                        <field name="period_type"/>
                    </group>
                </group>

                <!-- Period Configuration -->
                <group string="📅 Period Configuration" name="period_config">
                    <group>
                        <field name="date_from"/>
                    </group>
                    <group>
                        <field name="date_to"/>
                    </group>
                </group>

                <separator string="📋 Reservation Metrics"/>
                <group>
                    <group>
                        <field name="total_reservations" readonly="1"/>
                        <field name="active_reservations" readonly="1"/>
                    </group>
                    <group>
                        <field name="pending_reservations" readonly="1"/>
                        <field name="cancelled_reservations" readonly="1"/>
                    </group>
                </group>

                <separator string="🛏️ Occupancy Metrics"/>
                <group>
                    <group>
                        <field name="total_nights" readonly="1"/>
                        <field name="occupancy_rate" readonly="1"/>
                    </group>
                    <group>
                        <field name="average_stay" readonly="1"/>
                    </group>
                </group>

                <separator string="📈 Comparison Metrics"/>
                <group>
                    <group>
                        <field name="previous_period_reservations" readonly="1"/>
                        <field name="reservation_growth" readonly="1"/>
                    </group>
                </group>
            </form>
        </field>
    </record>

    <!-- ========================================
         RESERVATIONS DASHBOARD - GRAPH VIEW
         ======================================== -->
    <record id="view_dashboard_reservations_graph" model="ir.ui.view">
        <field name="name">onedesk.dashboard.reservations.graph</field>
        <field name="model">onedesk.dashboard.reservations</field>
        <field name="arch" type="xml">
            <graph string="Reservations Analytics" type="bar">
                <field name="user_id" type="row"/>
                <field name="total_reservations" type="measure"/>
                <field name="total_nights" type="measure"/>
                <field name="occupancy_rate" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ========================================
         RESERVATIONS DASHBOARD - ACTION
         ======================================== -->
    <record id="action_dashboard_reservations" model="ir.actions.act_window">
        <field name="name">Reservations Dashboard</field>
        <field name="res_model">onedesk.dashboard.reservations</field>
        <field name="view_mode">form,kanban,list,calendar,graph</field>
        <field name="context">{'default_user_id': uid, 'default_company_id': company_id}</field>
        <field name="domain">[('user_id', '=', uid)]</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                View your reservations performance dashboard.
            </p>
        </field>
    </record>

</odoo>
