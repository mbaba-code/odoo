<odoo>
    <record id="view_unit_list" model="ir.ui.view">
        <field name="name">onedesk.unit.list</field>
        <field name="model">onedesk.unit</field>
        <field name="arch" type="xml">
            <list string="Units">
                <field name="name"/>
                <field name="property_id"/>
                <field name="price_per_night"/>
                <field name="available"/>
            </list>
        </field>
    </record>

    <record id="view_unit_form" model="ir.ui.view">
        <field name="name">onedesk.unit.form</field>
        <field name="model">onedesk.unit</field>
        <field name="arch" type="xml">
            <form string="Unit">
                <sheet>
                    <h1>
                        <field name="name" class="oe_inline"/>
                    </h1>

                    <!-- SECTION: INFO DE BASE -->
                    <group>
                        <group>
                            <field name="property_id"/>
                            <field name="available"/>
                        </group>
                        <group>
                            <field name="price_per_night" widget="monetary"/>
                        </group>
                    </group>

                    <!-- SECTION: CARACTÉRISTIQUES UNITÉ -->
                    <separator string="🏠 Caractéristiques de l'unité"/>
                    <group>
                        <group>
                            <field name="capacity"/>
                            <field name="bedrooms"/>
                            <field name="bathrooms"/>
                        </group>
                        <group>
                            <field name="minimum_stay"/>
                            <field name="cleaning_required"/>
                            <field name="cleaning_fee" widget="monetary"/>
                            <field name="cleaning_duration_hours"/>
                        </group>
                    </group>

                    <!-- SECTION: PHOTO -->
                    <separator string="📸 Photo de couverture (depuis la galerie)"/>
                    <group>
                        <field name="cover_image" widget="image" options="{'size': [300, 300]}"/>
                    </group>
                    <p style="font-size: 11px; color: #999; margin-top: -10px;">
                        💡 Cette photo est automatiquement extraite de votre galerie (celle marquée 📌 comme couverture)
                    </p>

                    <!-- SECTION: GALERIE DE PHOTOS -->
                    <separator string="🖼️ Galerie complète de photos (Mode Grille)"/>
                    <field name="image_ids" mode="kanban">
                        <kanban>
                            <field name="id"/>
                            <field name="image" widget="binary"/>
                            <field name="name"/>
                            <field name="is_cover"/>
                            <templates>
                                <t t-name="card">
                                    <div class="oe_kanban_card">
                                        <div class="oe_kanban_global_click" style="position: relative;">
                                            <!-- Photo -->
                                            <div style="height: 180px; margin-bottom: 8px; border-radius: 5px; overflow: hidden; background: #f0f0f0; display: flex; align-items: center; justify-content: center;">
                                                <t t-if="record.image.raw_value">
                                                    <img t-att-src="'data:image/*;base64,' + record.image.raw_value" style="width: 100%; height: 100%; object-fit: cover;" alt="Photo"/>
                                                </t>
                                                <t t-else="">
                                                    <i class="fa fa-image fa-3x" style="color: #ccc;"></i>
                                                </t>
                                                <!-- Cover Badge -->
                                                <t t-if="record.is_cover.value">
                                                    <div style="position: absolute; top: 5px; right: 5px; background: #28a745; color: white; padding: 4px 8px; border-radius: 3px; font-size: 11px; font-weight: bold;">
                                                        📌
                                                    </div>
                                                </t>
                                            </div>
                                            <!-- Name -->
                                            <h5 style="margin: 0; font-size: 12px; font-weight: bold; text-align: center;">
                                                <field name="name"/>
                                            </h5>
                                        </div>
                                    </div>
                                </t>
                            </templates>
                        </kanban>
                    </field>

                    <separator string="Ajouter une nouvelle photo"/>
                    <field name="image_ids">
                        <list string="Photos" editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="is_cover" widget="boolean"/>
                            <field name="name"/>
                            <field name="image" widget="image" optional="hide"/>
                        </list>
                    </field>
                    <p style="margin-top: 10px; font-size: 12px; color: #999;">
                        💡 <strong>Astuce:</strong> Grille: vue d'ensemble des photos | Table: ajouter/modifier photos, cochez "📌" pour sélectionner la couverture
                    </p>

                    <!-- SECTION: POLITIQUES -->
                    <separator string="📋 Politiques"/>
                    <group>
                        <field name="cancellation_policy"/>
                        <field name="maintenance_notes" placeholder="Ex: Problèmes connus, maintenance récente..."/>
                    </group>

                    <!-- SECTION: INTÉGRATION -->
                    <separator string="🔗 Intégration externe"/>
                    <group>
                        <group>
                            <field name="external_listing_id"/>
                            <field name="integration_id"/>
                        </group>
                    </group>

                    <!-- Tarification saisonnière -->
                    <separator string="💰 Tarification Saisonnière"/>
                    <field name="seasonal_price_ids" nolabel="1">
                        <list string="Tarifs saisonniers" editable="bottom">
                            <field name="name"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="price_per_night"/>
                            <field name="active" optional="hide"/>
                        </list>
                    </field>
                    <p style="margin-top: 10px; font-size: 12px; color: #999;">
                        💡 Ajouter des périodes saisonnières pour appliquer des tarifs différents (ex: 120€/nuit en été, 50€/nuit en hiver)
                    </p>
                </sheet>
            </form>
        </field>
    </record>

    <!-- KANBAN VIEW - DASHBOARD -->
    <record id="view_unit_kanban" model="ir.ui.view">
        <field name="name">onedesk.unit.kanban</field>
        <field name="model">onedesk.unit</field>
        <field name="arch" type="xml">
            <kanban string="Units Dashboard">
                <field name="name"/>
                <field name="cover_image" widget="binary"/>
                <field name="property_id"/>
                <field name="revenue_this_month"/>
                <field name="occupancy_percentage"/>
                <field name="upcoming_reservations_count"/>
                <field name="revenue_this_year"/>
                <field name="price_per_night"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card">
                            <div class="oe_kanban_global_click">
                                <!-- Image -->
                                <div style="height: 150px; margin-bottom: 10px; border-radius: 5px; overflow: hidden; background: #f0f0f0; display: flex; align-items: center; justify-content: center;">
                                    <t t-if="record.cover_image.raw_value">
                                        <img t-att-src="'data:image/*;base64,' + record.cover_image.raw_value" style="width: 100%; height: 100%; object-fit: cover;" alt="Unit photo"/>
                                    </t>
                                    <t t-else="">
                                        <i class="fa fa-home fa-3x" style="color: #ccc;"></i>
                                    </t>
                                </div>

                                <h3><field name="name"/></h3>
                                <div class="text-muted" style="font-size: 12px; margin-bottom: 10px;"><field name="property_id"/></div>

                                <hr/>

                                <!-- Stats -->
                                <div style="margin-top: 10px;">
                                    <div style="margin-bottom: 8px;">
                                        <strong>💰 Revenus ce mois:</strong>
                                        <span style="float: right; color: #28a745; font-weight: bold;">
                                            <field name="revenue_this_month" widget="monetary"/>
                                        </span>
                                    </div>

                                    <div style="margin-bottom: 8px;">
                                        <strong>📈 Occupation:</strong>
                                        <span style="float: right; font-weight: bold;">
                                            <field name="occupancy_percentage"/>%
                                        </span>
                                    </div>

                                    <div style="margin-bottom: 8px;">
                                        <strong>📅 7 prochains j.:</strong>
                                        <span style="float: right; font-weight: bold;">
                                            <field name="upcoming_reservations_count"/>
                                        </span>
                                    </div>

                                    <div>
                                        <strong>💵 Revenus année:</strong>
                                        <span style="float: right; color: #17a2b8; font-weight: bold;">
                                            <field name="revenue_this_year" widget="monetary"/>
                                        </span>
                                    </div>
                                </div>

                                <hr/>
                                <div style="font-size: 11px; color: #999;">
                                    Prix défaut: <field name="price_per_night"/> €/nuit
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_onedesk_unit" model="ir.actions.act_window">
        <field name="name">Units</field>
        <field name="res_model">onedesk.unit</field>
        <field name="view_mode">list,form,kanban</field>
    </record>

    <menuitem id="menu_onedesk_unit" name="Units"
              parent="menu_onedesk_root"
              action="action_onedesk_unit"/>
</odoo>
