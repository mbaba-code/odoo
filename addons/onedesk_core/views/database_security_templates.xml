<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Page de blocage pour l'accès au database manager -->
    <template id="database_manager_blocked" name="Database Manager - Accès Bloqué">
        <t t-call="web.login_layout">
            <div class="container mt-5">
                <div class="row justify-content-center">
                    <div class="col-md-8 col-lg-6">
                        <div class="card shadow-sm border-danger">
                            <div class="card-header bg-danger text-white">
                                <h3 class="mb-0">
                                    <i class="fa fa-ban"/> Accès Refusé
                                </h3>
                            </div>
                            <div class="card-body">
                                <div class="alert alert-danger" role="alert">
                                    <h4 class="alert-heading">
                                        <i class="fa fa-exclamation-triangle"/> <t t-esc="reason or 'Accès non autorisé'"/>
                                    </h4>
                                    <hr/>
                                    <p class="mb-0">
                                        <t t-esc="message or 'Vous n\'avez pas les permissions nécessaires pour accéder à cette page.'"/>
                                    </p>
                                </div>

                                <div class="mt-4">
                                    <h5>🔒 Sécurité SaaS</h5>
                                    <p class="text-muted">
                                        Pour des raisons de sécurité, le gestionnaire de bases de données
                                        est réservé aux super administrateurs.
                                    </p>
                                    <ul class="text-muted">
                                        <li>Les bases de données sont provisionnées automatiquement</li>
                                        <li>Chaque client dispose d'une base isolée et sécurisée</li>
                                        <li>Les opérations sensibles sont auditées</li>
                                    </ul>
                                </div>

                                <div class="mt-4 text-center">
                                    <a href="/web" class="btn btn-primary">
                                        <i class="fa fa-home"/> Retour à l'accueil
                                    </a>
                                </div>
                            </div>
                            <div class="card-footer text-muted text-center">
                                <small>
                                    <i class="fa fa-shield"/> Cet accès a été enregistré dans les logs de sécurité
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
