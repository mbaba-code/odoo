<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Dashboard SaaS - Vue Kanban personnalisée -->
    <record id="view_saas_dashboard_kanban" model="ir.ui.view">
        <field name="name">saas.dashboard.kanban</field>
        <field name="model">saas.client</field>
        <field name="arch" type="xml">
            <kanban class="o_saas_dashboard" create="false" edit="false">
                <field name="id"/>
                <field name="database_state"/>
                <field name="subscription_state"/>
                <templates>
                    <t t-name="card">
                        <div class="container o_saas_dashboard">
                            <!-- Row 1: KPIs Principaux -->
                            <div class="row">
                                <div class="col-lg-3 col-md-6 col-sm-12">
                                    <div class="card bg-primary text-white mb-3">
                                        <div class="card-body">
                                            <h6 class="card-title">
                                                <i class="fa fa-users" title="Clients"/> Clients Actifs
                                            </h6>
                                            <h2 class="mb-0">
                                                <t t-esc="record.__count"/>
                                            </h2>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-3 col-md-6 col-sm-12">
                                    <div class="card bg-success text-white mb-3">
                                        <div class="card-body">
                                            <h6 class="card-title">
                                                <i class="fa fa-database" title="Bases de données"/> Bases Actives
                                            </h6>
                                            <h2 class="mb-0">
                                                <t t-esc="record.__count"/>
                                            </h2>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-3 col-md-6 col-sm-12">
                                    <div class="card bg-info text-white mb-3">
                                        <div class="card-body">
                                            <h6 class="card-title">
                                                <i class="fa fa-clock-o" title="Date"/> Essais en Cours
                                            </h6>
                                            <h2 class="mb-0">-</h2>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-3 col-md-6 col-sm-12">
                                    <div class="card bg-warning text-white mb-3">
                                        <div class="card-body">
                                            <h6 class="card-title">
                                                <i class="fa fa-exclamation-triangle" title="Alertes"/> Alertes
                                            </h6>
                                            <h2 class="mb-0">-</h2>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Row 2: Actions Rapides -->
                            <div class="row">
                                <div class="col-12">
                                    <div class="card mb-3">
                                        <div class="card-header">
                                            <h5><i class="fa fa-bolt" title="Actions"/> Actions Rapides</h5>
                                        </div>
                                        <div class="card-body">
                                            <a role="button" class="btn btn-primary mr-2"
                                               name="%(action_saas_client)d" type="action">
                                                <i class="fa fa-plus" title="Créer"/> Nouveau Client
                                            </a>
                                            <a role="button" class="btn btn-info mr-2"
                                               name="%(action_saas_plan)d" type="action">
                                                <i class="fa fa-cube" title="Plans"/> Gérer les Plans
                                            </a>
                                            <a role="button" class="btn btn-warning mr-2"
                                               name="%(action_saas_alert)d" type="action">
                                                <i class="fa fa-bell" title="Notifications"/> Voir les Alertes
                                            </a>
                                            <a role="button" class="btn btn-success"
                                               name="%(action_saas_metric)d" type="action">
                                                <i class="fa fa-line-chart" title="Graphiques"/> Métriques
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Row 3: Alertes Récentes -->
                            <div class="row">
                                <div class="col-lg-6 col-md-12">
                                    <div class="card mb-3">
                                        <div class="card-header">
                                            <h5><i class="fa fa-exclamation-circle" title="Alertes"/> Alertes Non Résolues</h5>
                                        </div>
                                        <div class="card-body">
                                            <p class="text-muted">Cliquez sur "Voir les Alertes" pour gérer les alertes</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-12">
                                    <div class="card mb-3">
                                        <div class="card-header">
                                            <h5><i class="fa fa-clock-o" title="Date"/> Essais Arrivant à Expiration</h5>
                                        </div>
                                        <div class="card-body">
                                            <p class="text-muted">Cliquez sur "En Essai" dans le menu pour voir les clients en période d'essai</p>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Row 4: Statistiques Plans -->
                            <div class="row">
                                <div class="col-12">
                                    <div class="card mb-3">
                                        <div class="card-header">
                                            <h5><i class="fa fa-pie-chart" title="Statistiques"/> Répartition par Plan</h5>
                                        </div>
                                        <div class="card-body">
                                            <p class="text-muted">Consultez les Plans SaaS pour voir la répartition détaillée</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- NOTE: action_saas_dashboard a été déplacée dans saas_menu.xml
         pour résoudre un problème d'ordre de chargement -->

</odoo>
