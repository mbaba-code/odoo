<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue formulaire du wizard d'import -->
    <record id="view_contact_importer_form" model="ir.ui.view">
        <field name="name">onedesk.contact.importer.form</field>
        <field name="model">onedesk.contact.importer</field>
        <field name="arch" type="xml">
            <form string="Importateur de Contacts Conciergeries">
                <header>
                    <button name="action_import_contacts"
                            string="🚀 LANCER L'IMPORT"
                            type="object"
                            class="oe_highlight"
                            invisible="state in ['importing', 'done']"/>
                    <button name="action_view_imported_contacts"
                            string="📋 Voir les Contacts Importés"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'done'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,importing,done"/>
                </header>

                <sheet>
                    <!-- Avertissement RGPD -->
                    <div class="alert alert-warning" role="alert" style="margin-bottom: 20px;">
                        <h4>⚠️ Avertissement Légal - RGPD</h4>
                        <p>
                            <strong>Cet outil utilise l'API publique Sirene de l'INSEE (données légales).</strong>
                        </p>
                        <ul>
                            <li>✅ Les données d'entreprises (SIREN, raison sociale, adresse) sont publiques</li>
                            <li>⚠️ Pour le marketing par email, vous DEVEZ obtenir le consentement (RGPD)</li>
                            <li>📧 Marketing B2B autorisé uniquement avec consentement explicite</li>
                            <li>🔒 Ne spammez pas - respectez la loi anti-spam</li>
                        </ul>
                    </div>

                    <group>
                        <group string="🔍 Critères de Recherche">
                            <field name="search_keyword" placeholder="Ex: conciergerie, gestion locative..."/>
                            <field name="department" placeholder="Ex: 75 (Paris), 13 (Marseille)..."/>
                            <field name="max_results"/>
                            <field name="active_only"/>
                        </group>

                        <group string="📊 Résultats" invisible="state == 'draft'">
                            <field name="import_count" invisible="state != 'done'"/>
                            <field name="error_message" invisible="state != 'error'"/>
                        </group>
                    </group>

                    <!-- État d'import -->
                    <div invisible="state != 'importing'" style="text-align: center; padding: 20px;">
                        <h3>⏳ Import en cours...</h3>
                        <p>Veuillez patienter pendant l'import des contacts depuis l'API Sirene.</p>
                    </div>

                    <!-- Succès -->
                    <div invisible="state != 'done'" class="alert alert-success" role="alert" style="margin-top: 20px;">
                        <h4>✅ Import Terminé avec Succès !</h4>
                        <p>
                            <field name="import_count"/> contact(s) ont été importés dans votre base Odoo.
                        </p>
                        <p>
                            <strong>Prochaines étapes :</strong>
                        </p>
                        <ol>
                            <li>Cliquez sur "Voir les Contacts Importés" pour consulter la liste</li>
                            <li>Complétez manuellement les emails/téléphones si disponibles</li>
                            <li>Obtenez le consentement RGPD avant tout envoi marketing</li>
                            <li>Créez vos campagnes marketing via le module Email Marketing d'Odoo</li>
                        </ol>
                    </div>

                    <!-- Erreur -->
                    <div invisible="state != 'error'" class="alert alert-danger" role="alert" style="margin-top: 20px;">
                        <h4>❌ Erreur lors de l'Import</h4>
                        <p><field name="error_message" readonly="1"/></p>
                        <p>
                            <strong>Solutions possibles :</strong>
                        </p>
                        <ul>
                            <li>Vérifiez votre connexion Internet</li>
                            <li>Vérifiez que l'API Sirene est accessible</li>
                            <li>Configurez votre clé API Sirene (gratuite sur api.insee.fr)</li>
                            <li>Contactez votre administrateur système</li>
                        </ul>
                    </div>

                    <!-- Instructions -->
                    <notebook>
                        <page string="📖 Instructions">
                            <group>
                                <field name="id" invisible="1"/>
                            </group>
                            <div style="padding: 10px;">
                                <h3>Comment utiliser cet outil ?</h3>

                                <h4>1. Configuration de l'API Sirene (OBLIGATOIRE en production)</h4>
                                <p>
                                    L'API Sirene de l'INSEE est <strong>gratuite</strong> mais nécessite une clé API :
                                </p>
                                <ul>
                                    <li>🔗 Rendez-vous sur : <a href="https://api.insee.fr/catalogue/" target="_blank">https://api.insee.fr/catalogue/</a></li>
                                    <li>📝 Créez un compte (gratuit)</li>
                                    <li>🔑 Obtenez votre clé API</li>
                                    <li>⚙️ Configurez la clé dans le fichier <code>contact_importer.py</code></li>
                                </ul>

                                <h4>2. Recherche de Conciergeries</h4>
                                <ul>
                                    <li><strong>Mot-clé :</strong> Entrez "conciergerie", "gestion locative", "property management", etc.</li>
                                    <li><strong>Département :</strong> Filtrez par département (75=Paris, 13=Marseille, etc.) ou laissez vide pour toute la France</li>
                                    <li><strong>Max résultats :</strong> Limitez le nombre d'imports (100 par défaut)</li>
                                    <li><strong>Actives uniquement :</strong> Importez seulement les entreprises en activité</li>
                                </ul>

                                <h4>3. Import dans Odoo</h4>
                                <p>
                                    Les contacts sont automatiquement créés dans le module <strong>Contacts</strong> natif d'Odoo avec :
                                </p>
                                <ul>
                                    <li>✅ Nom de l'entreprise</li>
                                    <li>✅ SIRET (référence)</li>
                                    <li>✅ SIREN</li>
                                    <li>✅ Adresse complète</li>
                                    <li>✅ Code postal et ville</li>
                                    <li>✅ Pays (France)</li>
                                </ul>

                                <h4>4. Compléter les Informations</h4>
                                <p>
                                    L'API Sirene ne fournit <strong>pas</strong> les emails et téléphones. Vous devrez :
                                </p>
                                <ul>
                                    <li>🔍 Rechercher manuellement sur Internet</li>
                                    <li>📞 Appeler pour obtenir les coordonnées</li>
                                    <li>🌐 Consulter le site web de l'entreprise</li>
                                    <li>📧 Demander le consentement RGPD pour le marketing</li>
                                </ul>

                                <h4>5. Marketing par Email</h4>
                                <p>
                                    Une fois les emails collectés et le consentement obtenu :
                                </p>
                                <ul>
                                    <li>📧 Utilisez le module <strong>Email Marketing</strong> d'Odoo</li>
                                    <li>🎯 Créez des segments de contacts</li>
                                    <li>✉️ Concevez vos campagnes</li>
                                    <li>📊 Analysez les résultats (taux d'ouverture, clics, etc.)</li>
                                </ul>

                                <h4>⚖️ Conformité RGPD - IMPORTANT</h4>
                                <div class="alert alert-danger">
                                    <ul>
                                        <li>❌ <strong>N'envoyez JAMAIS d'emails marketing sans consentement</strong></li>
                                        <li>✅ Utilisez le double opt-in pour confirmer le consentement</li>
                                        <li>✅ Incluez toujours un lien de désinscription</li>
                                        <li>✅ Respectez les demandes de suppression de données</li>
                                        <li>✅ Documentez vos bases légales de traitement</li>
                                        <li>⚠️ Amendes RGPD : jusqu'à 4% du CA ou 20M€</li>
                                    </ul>
                                </div>
                            </div>
                        </page>

                        <page string="🔧 Configuration API">
                            <div style="padding: 10px;">
                                <h3>🔒 Configuration Sécurisée de l'API Sirene</h3>

                                <div class="alert alert-info" style="margin: 15px 0;">
                                    <strong>✨ NOUVEAU : Configuration sécurisée !</strong>
                                    <p>Votre clé API est maintenant stockée dans les paramètres système Odoo au lieu d'être dans le code source.</p>
                                </div>

                                <p>
                                    <strong>Mode actuel :</strong>
                                    <span style="background: #ffe066; padding: 3px 8px; border-radius: 3px;">MODE DÉMO</span>
                                    (3 contacts fictifs - Aucune clé API configurée)
                                </p>

                                <h4>📋 Activation en 3 étapes :</h4>

                                <h5>Étape 1 : Obtenir votre clé API gratuite</h5>
                                <ol>
                                    <li>Allez sur <a href="https://api.insee.fr/catalogue/" target="_blank">api.insee.fr/catalogue</a></li>
                                    <li>Créez un compte (gratuit)</li>
                                    <li>Abonnez-vous à l'API "Sirene V3"</li>
                                    <li>Copiez votre clé API</li>
                                </ol>

                                <h5>Étape 2 : Configurer dans Odoo (MÉTHODE SÉCURISÉE)</h5>
                                <ol>
                                    <li>Activez le mode développeur : <strong>Paramètres → Activer le mode développeur</strong></li>
                                    <li>Allez dans : <strong>Paramètres → Technique → Paramètres Système</strong></li>
                                    <li>Cliquez sur <strong>"Créer"</strong></li>
                                    <li>Remplissez :
                                        <ul>
                                            <li><strong>Clé :</strong> <code>onedesk.sirene_api_key</code></li>
                                            <li><strong>Valeur :</strong> Collez votre clé API</li>
                                        </ul>
                                    </li>
                                    <li>Sauvegardez</li>
                                </ol>

                                <h5>Étape 3 : Tester</h5>
                                <p>Revenez sur cet écran et cliquez sur "🚀 LANCER L'IMPORT". Si configuré correctement, vous verrez dans les logs :</p>
                                <pre style="background: #f5f5f5; padding: 10px; border-radius: 5px; font-size: 12px;">
Appel API Sirene avec clé authentifiée...
API Sirene: 127 résultats trouvés
                                </pre>

                                <h4>✅ Avantages de cette méthode :</h4>
                                <ul>
                                    <li>✅ Clé API <strong>PAS dans le code source</strong></li>
                                    <li>✅ Clé API <strong>PAS dans Git/GitHub</strong></li>
                                    <li>✅ Configuration facile via l'interface</li>
                                    <li>✅ Une seule clé pour toute l'installation</li>
                                    <li>✅ Changement de clé sans modifier le code</li>
                                </ul>

                                <h4>🔍 Vérification du mode actif</h4>
                                <table style="width: 100%; border-collapse: collapse; margin: 10px 0;">
                                    <tr style="background: #f9f9f9;">
                                        <th style="padding: 8px; border: 1px solid #ddd; text-align: left;">Mode</th>
                                        <th style="padding: 8px; border: 1px solid #ddd; text-align: left;">Log visible</th>
                                    </tr>
                                    <tr>
                                        <td style="padding: 8px; border: 1px solid #ddd;"><strong>MODE DÉMO</strong></td>
                                        <td style="padding: 8px; border: 1px solid #ddd;"><code>Mode DÉMO activé - Aucune clé API Sirene configurée</code></td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 8px; border: 1px solid #ddd;"><strong>MODE PRODUCTION</strong></td>
                                        <td style="padding: 8px; border: 1px solid #ddd;"><code>Appel API Sirene avec clé authentifiée...</code></td>
                                    </tr>
                                </table>

                                <h4>❌ Erreurs possibles</h4>
                                <ul>
                                    <li><strong>401 Unauthorized :</strong> Clé API invalide → Vérifiez votre clé</li>
                                    <li><strong>429 Too Many Requests :</strong> Limite atteinte → Attendez quelques minutes</li>
                                    <li><strong>Erreur de connexion :</strong> Problème réseau → Vérifiez Internet</li>
                                </ul>

                                <div class="alert alert-warning" style="margin-top: 15px;">
                                    <strong>📖 Documentation complète :</strong>
                                    <p>Consultez le fichier <code>API_SIRENE_CONFIG.md</code> dans le module onedesk_core pour plus de détails.</p>
                                </div>
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action pour ouvrir le wizard -->
    <record id="action_contact_importer" model="ir.actions.act_window">
        <field name="name">🚀 Import Contacts Conciergeries</field>
        <field name="res_model">onedesk.contact.importer</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_contact_importer_form"/>
    </record>

    <!-- Menu pour accéder au wizard -->
    <menuitem id="menu_contact_importer"
              name="🚀 Import Conciergeries"
              parent="menu_onedesk_team"
              action="action_contact_importer"
              sequence="20"/>

    <!-- ========================================== -->
    <!-- VUES NATIVES ODOO - CONTACTS IMPORTÉS     -->
    <!-- Support Studio complet pour personnalisation -->
    <!-- ========================================== -->

    <!-- Vue Tree (Liste) des contacts importés -->
    <record id="view_imported_contacts_tree" model="ir.ui.view">
        <field name="name">res.partner.imported.tree</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <tree string="Contacts Conciergeries Importés"
                  create="true"
                  edit="true"
                  delete="true"
                  decoration-success="active == True"
                  decoration-muted="active == False">
                <field name="name" string="Nom Entreprise"/>
                <field name="ref" string="SIRET" optional="show"/>
                <field name="company_registry" string="SIREN" optional="show"/>
                <field name="street" optional="hide"/>
                <field name="zip" string="Code Postal" optional="show"/>
                <field name="city" string="Ville" optional="show"/>
                <field name="phone" optional="show"/>
                <field name="email" optional="show"/>
                <field name="active" optional="show"/>
                <field name="create_date" string="Date Import" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </tree>
        </field>
    </record>

    <!-- Vue Form (Formulaire) des contacts importés -->
    <record id="view_imported_contacts_form" model="ir.ui.view">
        <field name="name">res.partner.imported.form</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form string="Contact Conciergerie">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options='{"terminology": "archive"}'/>
                        </button>
                    </div>

                    <field name="image_1920" widget="image" class="oe_avatar"/>

                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nom de l'entreprise"/>
                        </h1>
                        <field name="category_id" widget="many2many_tags"
                               options="{'color_field': 'color', 'no_create_edit': True}"
                               placeholder="Tags..."/>
                    </div>

                    <group>
                        <group string="📋 Informations Légales">
                            <field name="ref" string="SIRET"/>
                            <field name="company_registry" string="SIREN"/>
                            <field name="vat" string="TVA Intracommunautaire"/>
                            <field name="is_company" invisible="1"/>
                        </group>

                        <group string="📍 Adresse">
                            <field name="street" placeholder="Rue..."/>
                            <field name="street2" placeholder="Complément d'adresse..."/>
                            <div class="o_address_format">
                                <field name="zip" placeholder="Code Postal" class="o_address_zip"/>
                                <field name="city" placeholder="Ville" class="o_address_city"/>
                            </div>
                            <field name="state_id" placeholder="Département/Région" options="{'no_create': True}"/>
                            <field name="country_id" placeholder="Pays" options="{'no_create': True}"/>
                        </group>
                    </group>

                    <group>
                        <group string="📞 Contact">
                            <field name="phone" widget="phone" placeholder="+33 1 23 45 67 89"/>
                            <field name="mobile" widget="phone" placeholder="+33 6 12 34 56 78"/>
                            <field name="email" widget="email" placeholder="contact@example.com"/>
                            <field name="website" widget="url" placeholder="https://www.example.com"/>
                        </group>

                        <group string="🏢 Organisation">
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                            <field name="user_id" string="Commercial"/>
                            <field name="parent_id" string="Entreprise Mère" domain="[('is_company', '=', True)]"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="📝 Notes &amp; Commentaires" name="internal_notes">
                            <field name="comment" placeholder="Notes internes sur ce contact...&#10;&#10;⚠️ RGPD: Vérifiez le consentement avant envoi marketing"/>
                        </page>

                        <page string="📊 Ventes &amp; Achats" name="sales">
                            <group>
                                <group string="Ventes">
                                    <field name="customer_rank" invisible="1"/>
                                </group>
                                <group string="Achats">
                                    <field name="supplier_rank" invisible="1"/>
                                </group>
                            </group>
                        </page>

                        <page string="📧 Marketing" name="marketing">
                            <group>
                                <group string="Consentement Marketing (RGPD)">
                                    <label for="comment" string="⚠️ Important"/>
                                    <div class="alert alert-warning">
                                        <p>Avant tout envoi marketing :</p>
                                        <ul>
                                            <li>✅ Obtenez le consentement explicite</li>
                                            <li>✅ Documentez la date et la méthode de consentement</li>
                                            <li>✅ Incluez toujours un lien de désinscription</li>
                                        </ul>
                                    </div>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Vue Search (Recherche) avec filtres intelligents -->
    <record id="view_imported_contacts_search" model="ir.ui.view">
        <field name="name">res.partner.imported.search</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search string="Rechercher Conciergeries">
                <!-- Champs de recherche -->
                <field name="name" string="Nom" filter_domain="[('name', 'ilike', self)]"/>
                <field name="ref" string="SIRET" filter_domain="[('ref', 'ilike', self)]"/>
                <field name="company_registry" string="SIREN" filter_domain="[('company_registry', 'ilike', self)]"/>
                <field name="city" string="Ville"/>
                <field name="zip" string="Code Postal"/>
                <field name="email"/>
                <field name="phone"/>

                <!-- Filtres prédéfinis -->
                <filter string="📧 Avec Email" name="filter_has_email" domain="[('email', '!=', False)]"/>
                <filter string="📞 Avec Téléphone" name="filter_has_phone" domain="['|', ('phone', '!=', False), ('mobile', '!=', False)]"/>
                <filter string="✅ Actifs" name="filter_active" domain="[('active', '=', True)]"/>
                <filter string="🗄️ Archivés" name="filter_inactive" domain="[('active', '=', False)]"/>

                <separator/>
                <filter string="🏢 Entreprises" name="filter_companies" domain="[('is_company', '=', True)]"/>

                <separator/>
                <filter string="📅 Importés cette semaine" name="filter_this_week"
                        domain="[('create_date', '&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <filter string="📅 Importés ce mois" name="filter_this_month"
                        domain="[('create_date', '&gt;=', (context_today().replace(day=1)).strftime('%Y-%m-%d'))]"/>

                <!-- Groupements -->
                <group expand="0" string="Grouper Par">
                    <filter string="Ville" name="group_city" context="{'group_by': 'city'}"/>
                    <filter string="Code Postal" name="group_zip" context="{'group_by': 'zip'}"/>
                    <filter string="Pays" name="group_country" context="{'group_by': 'country_id'}"/>
                    <filter string="Date Import" name="group_create_date" context="{'group_by': 'create_date'}"/>
                    <filter string="Commercial" name="group_user" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Vue Kanban pour visualisation rapide -->
    <record id="view_imported_contacts_kanban" model="ir.ui.view">
        <field name="name">res.partner.imported.kanban</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <kanban class="o_res_partner_kanban">
                <field name="id"/>
                <field name="name"/>
                <field name="city"/>
                <field name="country_id"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="mobile"/>
                <field name="image_1920"/>
                <field name="active"/>

                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill">
                            <div class="o_kanban_image_fill_left d-none d-md-block"
                                 t-attf-style="background-image: url('#{kanban_image('res.partner', 'image_1920', record.id.raw_value)}')">
                                <img class="o_kanban_image_inner_pic"
                                     t-att-alt="record.name.value"
                                     t-att-src="kanban_image('res.partner', 'image_1920', record.id.raw_value)"/>
                            </div>

                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>

                                <ul>
                                    <li t-if="record.city.raw_value and record.country_id.raw_value">
                                        <i class="fa fa-map-marker"/>
                                        <field name="city"/> (<field name="country_id"/>)
                                    </li>
                                    <li t-if="record.email.raw_value">
                                        <i class="fa fa-envelope"/>
                                        <a t-att-href="'mailto:' + record.email.raw_value">
                                            <field name="email"/>
                                        </a>
                                    </li>
                                    <li t-if="record.phone.raw_value">
                                        <i class="fa fa-phone"/>
                                        <field name="phone"/>
                                    </li>
                                    <li t-if="!record.phone.raw_value and record.mobile.raw_value">
                                        <i class="fa fa-mobile"/>
                                        <field name="mobile"/>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action pour voir les contacts importés (avec toutes les vues natives) -->
    <record id="action_view_imported_contacts" model="ir.actions.act_window">
        <field name="name">Contacts Conciergeries</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[('is_company', '=', True), ('comment', 'ilike', 'Importé depuis API Sirene')]</field>
        <field name="context">{
            'default_is_company': True,
            'search_default_filter_active': 1
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucun contact importé pour le moment
            </p>
            <p>
                Utilisez le bouton <b>"🚀 Import Conciergeries"</b> dans le menu pour importer des contacts depuis l'API Sirene.
            </p>
        </field>
    </record>

    <!-- Menu pour voir tous les contacts importés -->
    <menuitem id="menu_view_imported_contacts"
              name="📋 Contacts Importés"
              parent="menu_onedesk_team"
              action="action_view_imported_contacts"
              sequence="21"/>

</odoo>
