<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- LIST VIEW -->
    <record id="view_seasonal_price_list" model="ir.ui.view">
        <field name="name">onedesk.seasonal_price.list</field>
        <field name="model">onedesk.seasonal_price</field>
        <field name="arch" type="xml">
            <list string="Tarifs saisonniers" editable="bottom">
                <field name="unit_id"/>
                <field name="name"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="price_per_night" widget="monetary"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_seasonal_price_form" model="ir.ui.view">
        <field name="name">onedesk.seasonal_price.form</field>
        <field name="model">onedesk.seasonal_price</field>
        <field name="arch" type="xml">
            <form string="Tarif saisonnier">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" class="oe_inline" placeholder="Ex: Été 2024, Noël, Weekend"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="unit_id" required="1"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="date_start" required="1"/>
                            <field name="date_end" required="1"/>
                            <field name="price_per_night" widget="monetary" required="1"/>
                        </group>
                    </group>

                    <div class="alert alert-info" role="alert">
                        <strong>💡 Astuce:</strong> Définissez des périodes qui se chevauchent - le système calculera la moyenne pondérée.
                        <br/>Par exemple: 1-31 Jul à 120€/nuit, 15-25 Jul à 150€/nuit → 15-25 Jul sera à 150€
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- SEARCH -->
    <record id="view_seasonal_price_search" model="ir.ui.view">
        <field name="name">onedesk.seasonal_price.search</field>
        <field name="model">onedesk.seasonal_price</field>
        <field name="arch" type="xml">
            <search string="Rechercher">
                <field name="unit_id"/>
                <field name="name"/>
                <filter name="active" string="Actifs" domain="[('active', '=', True)]"/>
                <filter name="inactive" string="Inactifs" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_onedesk_seasonal_price" model="ir.actions.act_window">
        <field name="name">Tarifs saisonniers</field>
        <field name="res_model">onedesk.seasonal_price</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Créez un tarif saisonnier pour gérer les prix par période
            </p>
        </field>
    </record>

    <!-- MENU -->
    <menuitem id="menu_onedesk_seasonal_price"
              name="Tarifs saisonniers"
              parent="menu_onedesk_root"
              action="action_onedesk_seasonal_price"
              sequence="15"/>
</odoo>
