<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- WIZARD: Upload Multiple Images -->

    <!-- Form View -->
    <record id="view_onedesk_image_upload_wizard_form" model="ir.ui.view">
        <field name="name">onedesk.image.upload.wizard.form</field>
        <field name="model">onedesk.image.upload.wizard</field>
        <field name="arch" type="xml">
            <form string="Upload Multiple Photos">
                <sheet>
                    <!-- Message simplifié -->
                    <div class="alert alert-success" role="alert">
                        <strong>📸 Sélectionnez les photos à ajouter</strong>
                        <br/>Les photos seront ajoutées automatiquement avec la numérotation séquentielle.
                    </div>

                    <!-- Field caché pour le show_document_selector -->
                    <field name="show_document_selector" invisible="1"/>
                    <field name="document_type" invisible="1"/>
                    <field name="property_id" invisible="1"/>
                    <field name="unit_id" invisible="1"/>
                    <field name="reservation_id" invisible="1"/>
                    <field name="image_type" invisible="1"/>
                    <field name="note_prefix" invisible="1"/>

                    <!-- Upload images -->
                    <separator string="📸 Sélectionnez les photos"/>
                    <p style="color: #666; font-size: 12px;">
                        Cliquez ci-dessous pour sélectionner une ou plusieurs photos. Vous pouvez en sélectionner autant que vous voulez!
                    </p>
                    <field name="images" widget="many2many_binary" required="1"
                           options="{'url': '/web/content/ir.attachment/datas'}">
                    </field>

                    <p style="color: #999; font-size: 11px; margin-top: 10px;">
                        ✅ Formats supportés: JPG, PNG
                        <br/>✅ Taille max par photo: 5 MB
                    </p>
                </sheet>

                <footer>
                    <button name="action_upload_images" type="object" string="📤 Upload Photos" class="btn-primary"/>
                    <button string="❌ Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action pour ouvrir le wizard -->
    <record id="action_onedesk_image_upload_wizard" model="ir.actions.act_window">
        <field name="name">Upload Multiple Photos</field>
        <field name="res_model">onedesk.image.upload.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
