<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ========================================
         SALES DASHBOARD - SEARCH VIEW
         ======================================== -->
    <record id="view_dashboard_sales_search" model="ir.ui.view">
        <field name="name">onedesk.dashboard.sales.search</field>
        <field name="model">onedesk.dashboard.sales</field>
        <field name="arch" type="xml">
            <search string="Sales Dashboard Filters">
                <field name="user_id" string="User"/>
                <field name="company_id" string="Company"/>
                <separator/>
                <filter string="Today" name="today" domain="[('period_type', '=', 'today')]"/>
                <filter string="This Week" name="week" domain="[('period_type', '=', 'week')]"/>
                <filter string="This Month" name="month" domain="[('period_type', '=', 'month')]"/>
                <filter string="This Year" name="year" domain="[('period_type', '=', 'year')]"/>
            </search>
        </field>
    </record>

    <!-- ========================================
         SALES DASHBOARD - KANBAN VIEW
         ======================================== -->
    <record id="view_dashboard_sales_kanban" model="ir.ui.view">
        <field name="name">onedesk.dashboard.sales.kanban</field>
        <field name="model">onedesk.dashboard.sales</field>
        <field name="arch" type="xml">
            <kanban string="Sales Dashboard" default_group_by="period_type">
                <field name="id"/>
                <field name="user_id"/>
                <field name="company_id"/>
                <field name="period_type"/>
                <field name="total_revenue"/>
                <field name="revenue_count"/>
                <field name="revenue_growth"/>
                <field name="top_property_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card">
                            <div class="oe_kanban_global_click">
                                <!-- Header -->
                                <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 12px; border-radius: 4px 4px 0 0; margin: -4px -4px 8px -4px;">
                                    <h4 style="margin: 0; font-weight: bold;">
                                        <field name="user_id"/>
                                    </h4>
                                    <div style="font-size: 11px; opacity: 0.9;">
                                        <field name="company_id"/>
                                    </div>
                                </div>

                                <!-- Main Metrics -->
                                <div style="padding: 10px;">
                                    <!-- Total Revenue -->
                                    <div style="margin-bottom: 12px; padding: 8px; background: #f8f9ff; border-left: 4px solid #667eea; border-radius: 2px;">
                                        <div style="font-size: 10px; color: #666; margin-bottom: 2px;">💰 Total Revenue</div>
                                        <div style="font-size: 16px; font-weight: bold; color: #667eea;">
                                            <field name="total_revenue" widget="monetary"/>
                                        </div>
                                    </div>

                                    <!-- Transaction Count -->
                                    <div style="margin-bottom: 12px; padding: 8px; background: #f0f7ff; border-left: 4px solid #0066cc; border-radius: 2px;">
                                        <div style="font-size: 10px; color: #666; margin-bottom: 2px;">📊 Transactions</div>
                                        <div style="font-size: 14px; font-weight: bold; color: #0066cc;">
                                            <field name="revenue_count"/> transactions
                                        </div>
                                    </div>

                                    <!-- Growth Rate -->
                                    <div style="margin-bottom: 12px; padding: 8px; border-left: 4px solid #28a745; border-radius: 2px;" t-attf-style="background: #{{'f0fff4' if record.revenue_growth.value >= 0 else 'fff0f0'}}">
                                        <div style="font-size: 10px; color: #666; margin-bottom: 2px;">📈 Growth Rate</div>
                                        <div t-attf-style="font-size: 14px; font-weight: bold; color: #{{'28a745' if record.revenue_growth.value >= 0 else 'dc3545'}}">
                                            <field name="revenue_growth"/>%
                                        </div>
                                    </div>

                                    <!-- Period -->
                                    <div style="margin-bottom: 12px; padding: 8px; background: #f9f9f9; border-left: 4px solid #999; border-radius: 2px;">
                                        <div style="font-size: 10px; color: #666; margin-bottom: 2px;">📅 Period</div>
                                        <div style="font-size: 12px; font-weight: bold; color: #333;">
                                            <field name="period_type"/>
                                        </div>
                                    </div>

                                    <!-- Top Property -->
                                    <t t-if="record.top_property_id.value">
                                        <div style="padding: 8px; background: #fffef0; border-left: 4px solid #ffc107; border-radius: 2px;">
                                            <div style="font-size: 10px; color: #666; margin-bottom: 2px;">⭐ Top Property</div>
                                            <div style="font-size: 11px; font-weight: bold; color: #333; margin-bottom: 2px;">
                                                <field name="top_property_id"/>
                                            </div>
                                            <div style="font-size: 10px; color: #ffc107;">
                                                <field name="top_property_revenue" widget="monetary"/>
                                            </div>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ========================================
         SALES DASHBOARD - LIST VIEW
         ======================================== -->
    <record id="view_dashboard_sales_list" model="ir.ui.view">
        <field name="name">onedesk.dashboard.sales.list</field>
        <field name="model">onedesk.dashboard.sales</field>
        <field name="arch" type="xml">
            <list string="Sales Dashboard">
                <field name="user_id"/>
                <field name="company_id"/>
                <field name="period_type"/>
                <field name="total_revenue" widget="monetary"/>
                <field name="revenue_count"/>
                <field name="average_transaction" widget="monetary"/>
                <field name="revenue_growth"/>
                <field name="top_property_id"/>
                <field name="top_property_revenue" widget="monetary"/>
            </list>
        </field>
    </record>

    <!-- ========================================
         SALES DASHBOARD - CALENDAR VIEW
         ======================================== -->
    <record id="view_dashboard_sales_calendar" model="ir.ui.view">
        <field name="name">onedesk.dashboard.sales.calendar</field>
        <field name="model">onedesk.dashboard.sales</field>
        <field name="arch" type="xml">
            <calendar string="Sales Timeline" date_start="date_from" date_stop="date_to" mode="month" color="period_type">
                <field name="user_id"/>
                <field name="total_revenue"/>
                <field name="revenue_count"/>
                <field name="period_type"/>
            </calendar>
        </field>
    </record>

    <!-- ========================================
         SALES DASHBOARD - FORM VIEW
         ======================================== -->
    <record id="view_dashboard_sales_form" model="ir.ui.view">
        <field name="name">onedesk.dashboard.sales.form</field>
        <field name="model">onedesk.dashboard.sales</field>
        <field name="arch" type="xml">
            <form string="Sales Dashboard" create="true">
                <!-- Header with gradient -->
                <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 20px; margin: -16px -16px 16px -16px; border-radius: 4px 4px 0 0;">
                    <h2 style="margin: 0;">📊 Sales Dashboard</h2>
                    <p style="margin: 5px 0 0 0; opacity: 0.9; font-size: 13px;">Track revenue, transactions, and top performers</p>
                </div>

                <!-- Basic Info -->
                <group>
                    <group>
                        <field name="user_id"/>
                        <field name="company_id"/>
                    </group>
                    <group>
                        <field name="period_type"/>
                    </group>
                </group>

                <!-- Period Configuration -->
                <group string="📅 Period Configuration" name="period_config">
                    <group>
                        <field name="date_from"/>
                    </group>
                    <group>
                        <field name="date_to"/>
                    </group>
                </group>

                <separator string="💰 Revenue Metrics"/>
                <group>
                    <group>
                        <field name="total_revenue" readonly="1" widget="monetary"/>
                        <field name="revenue_count" readonly="1"/>
                    </group>
                    <group>
                        <field name="average_transaction" readonly="1" widget="monetary"/>
                        <field name="revenue_growth" readonly="1"/>
                    </group>
                </group>

                <separator string="📈 Comparison Metrics"/>
                <group>
                    <group>
                        <field name="previous_period_revenue" readonly="1" widget="monetary"/>
                    </group>
                    <group>
                    </group>
                </group>

                <separator string="⭐ Top Performer"/>
                <group>
                    <group>
                        <field name="top_property_id" readonly="1"/>
                        <field name="top_property_revenue" readonly="1" widget="monetary"/>
                    </group>
                </group>
            </form>
        </field>
    </record>

    <!-- ========================================
         SALES DASHBOARD - GRAPH VIEW
         ======================================== -->
    <record id="view_dashboard_sales_graph" model="ir.ui.view">
        <field name="name">onedesk.dashboard.sales.graph</field>
        <field name="model">onedesk.dashboard.sales</field>
        <field name="arch" type="xml">
            <graph string="Sales Analytics" type="bar">
                <field name="user_id" type="row"/>
                <field name="total_revenue" type="measure"/>
                <field name="revenue_count" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ========================================
         SALES DASHBOARD - ACTION
         ======================================== -->
    <record id="action_dashboard_sales" model="ir.actions.act_window">
        <field name="name">Sales Dashboard</field>
        <field name="res_model">onedesk.dashboard.sales</field>
        <field name="view_mode">form,kanban,list,calendar,graph</field>
        <field name="context">{'default_user_id': uid, 'default_company_id': company_id}</field>
        <field name="domain">[('user_id', '=', uid)]</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                View your sales performance dashboard.
            </p>
        </field>
    </record>

</odoo>
