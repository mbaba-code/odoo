<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action pour voir les clients d'un plan (défini avant les vues pour référence) -->
    <record id="action_saas_client_from_plan" model="ir.actions.act_window">
        <field name="name">Clients</field>
        <field name="res_model">saas.client</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('plan_id', '=', active_id)]</field>
        <field name="context">{'default_plan_id': active_id}</field>
    </record>

    <!-- Vue Liste Plans SaaS -->
    <record id="view_saas_plan_tree" model="ir.ui.view">
        <field name="name">saas.plan.tree</field>
        <field name="model">saas.plan</field>
        <field name="arch" type="xml">
            <list string="Plans SaaS">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="max_users"/>
                <field name="max_storage_gb"/>
                <field name="price_monthly" widget="float" string="Prix Mensuel (€)"/>
                <field name="price_yearly" widget="float" string="Prix Annuel (€)"/>
                <field name="client_count"/>
                <field name="revenue_monthly" widget="float" sum="Total Mensuel" string="Revenu Mensuel (€)"/>
                <field name="revenue_yearly" widget="float" sum="Total Annuel" string="Revenu Annuel (€)"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Vue Formulaire Plans SaaS -->
    <record id="view_saas_plan_form" model="ir.ui.view">
        <field name="name">saas.plan.form</field>
        <field name="model">saas.plan</field>
        <field name="arch" type="xml">
            <form string="Plan SaaS" class="o_form_saas_wrapper">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_saas_client_from_plan)d"
                                type="action"
                                class="oe_stat_button"
                                icon="fa-users">
                            <field name="client_count" widget="statinfo" string="Clients"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="ex: Starter, Pro, Enterprise"/></h1>
                    </div>
                    <group>
                        <group string="Configuration">
                            <field name="sequence"/>
                            <field name="active"/>
                            <field name="trial_days"/>
                            <field name="support_level"/>
                        </group>
                        <group string="Tarification">
                            <field name="price_monthly" widget="float" string="Prix Mensuel (€)"/>
                            <field name="price_yearly" widget="float" string="Prix Annuel (€)"/>
                            <field name="revenue_monthly" widget="float" string="Revenu Mensuel (€)"/>
                            <field name="revenue_yearly" widget="float" string="Revenu Annuel (€)"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Limites Techniques">
                            <group>
                                <group string="Ressources">
                                    <field name="max_users"/>
                                    <field name="max_storage_gb"/>
                                    <field name="max_api_calls_per_day"/>
                                    <field name="max_databases"/>
                                </group>
                            </group>
                        </page>
                        <page string="Fonctionnalités">
                            <group>
                                <group string="Options Avancées">
                                    <field name="has_custom_domain"/>
                                    <field name="has_white_label"/>
                                    <field name="has_api_access"/>
                                    <field name="has_advanced_analytics"/>
                                    <field name="has_priority_support"/>
                                </group>
                            </group>
                        </page>
                        <page string="Modules Autorisés">
                            <field name="allowed_module_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="state"/>
                                    <field name="summary"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description">
                            <field name="description" placeholder="Description du plan pour les clients..."/>
                        </page>
                        <page string="Clients" invisible="client_count == 0">
                            <field name="client_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="company_name"/>
                                    <field name="subscription_state"/>
                                    <field name="database_state"/>
                                    <field name="url" widget="url"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vue Kanban Plans SaaS -->
    <record id="view_saas_plan_kanban" model="ir.ui.view">
        <field name="name">saas.plan.kanban</field>
        <field name="model">saas.plan</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="price_monthly"/>
                <field name="price_yearly"/>
                <field name="client_count"/>
                <field name="max_users"/>
                <field name="max_storage_gb"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title"><field name="name"/></strong>
                                </div>
                                <span class="float-end badge badge-pill badge-info">
                                    <field name="client_count"/> clients
                                </span>
                            </div>
                            <div class="o_kanban_record_body">
                                <div>
                                    <i class="fa fa-users" title="Utilisateurs"/> <field name="max_users"/> utilisateurs
                                </div>
                                <div>
                                    <i class="fa fa-database" title="Stockage"/> <field name="max_storage_gb"/> GB
                                </div>
                                <div class="text-muted">
                                    <i class="fa fa-eur" title="Prix"/> <field name="price_monthly"/>€/mois |
                                    <field name="price_yearly"/>€/an
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action Plans SaaS -->
    <!-- NOTE: action_saas_plan déplacée vers saas_menu.xml pour éviter problèmes de chargement -->

</odoo>
