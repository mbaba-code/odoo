<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Menu Principal SaaS Manager -->
    <menuitem id="menu_saas_root"
              name="SaaS Manager"
              sequence="5"
              web_icon="onedesk_core,static/description/icon.png"
              groups="base.group_system"/>

    <!-- Dashboard SaaS -->
    <menuitem id="menu_saas_dashboard"
              name="Dashboard"
              parent="menu_saas_root"
              action="action_saas_dashboard"
              sequence="1"/>

    <!-- Sous-menu Clients -->
    <menuitem id="menu_saas_clients"
              name="Clients"
              parent="menu_saas_root"
              sequence="10"/>

    <menuitem id="menu_saas_client_all"
              name="Tous les Clients"
              parent="menu_saas_clients"
              action="action_saas_client"
              sequence="1"/>

    <menuitem id="menu_saas_client_active"
              name="Clients Actifs"
              parent="menu_saas_clients"
              action="action_saas_client_active"
              sequence="2"/>

    <menuitem id="menu_saas_client_trial"
              name="En Essai"
              parent="menu_saas_clients"
              action="action_saas_client_trial"
              sequence="3"/>

    <menuitem id="menu_saas_client_error"
              name="En Erreur"
              parent="menu_saas_clients"
              action="action_saas_client_error"
              sequence="4"/>

    <!-- Sous-menu Configuration -->
    <menuitem id="menu_saas_config"
              name="Configuration"
              parent="menu_saas_root"
              sequence="20"/>

    <menuitem id="menu_saas_plan"
              name="Plans SaaS"
              parent="menu_saas_config"
              action="action_saas_plan"
              sequence="1"/>

    <menuitem id="menu_saas_database"
              name="Bases de Données"
              parent="menu_saas_config"
              action="action_saas_database"
              sequence="2"/>

    <!-- Sous-menu Monitoring -->
    <menuitem id="menu_saas_monitoring"
              name="Monitoring"
              parent="menu_saas_root"
              sequence="30"/>

    <menuitem id="menu_saas_metric"
              name="Métriques"
              parent="menu_saas_monitoring"
              action="action_saas_metric"
              sequence="1"/>

    <menuitem id="menu_saas_alert"
              name="Alertes"
              parent="menu_saas_monitoring"
              action="action_saas_alert"
              sequence="2"/>

    <!-- Actions supplémentaires pour les sous-menus -->
    <record id="action_saas_client_active" model="ir.actions.act_window">
        <field name="name">Clients Actifs</field>
        <field name="res_model">saas.client</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('database_state', '=', 'active'), ('subscription_state', '=', 'active')]</field>
    </record>

    <record id="action_saas_client_trial" model="ir.actions.act_window">
        <field name="name">Clients en Essai</field>
        <field name="res_model">saas.client</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('subscription_state', '=', 'trial')]</field>
    </record>

    <record id="action_saas_client_error" model="ir.actions.act_window">
        <field name="name">Clients en Erreur</field>
        <field name="res_model">saas.client</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('database_state', '=', 'error')]</field>
    </record>

</odoo>
