<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue Graphique Métriques SaaS -->
    <record id="view_saas_metric_graph" model="ir.ui.view">
        <field name="name">saas.metric.graph</field>
        <field name="model">saas.metric</field>
        <field name="arch" type="xml">
            <graph string="Métriques SaaS" type="line">
                <field name="recorded_at" interval="day"/>
                <field name="metric_type"/>
                <field name="value" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Vue Pivot Métriques SaaS -->
    <record id="view_saas_metric_pivot" model="ir.ui.view">
        <field name="name">saas.metric.pivot</field>
        <field name="model">saas.metric</field>
        <field name="arch" type="xml">
            <pivot string="Métriques SaaS">
                <field name="client_id" type="row"/>
                <field name="metric_type" type="col"/>
                <field name="value" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Vue Liste Métriques SaaS -->
    <record id="view_saas_metric_tree" model="ir.ui.view">
        <field name="name">saas.metric.tree</field>
        <field name="model">saas.metric</field>
        <field name="arch" type="xml">
            <list string="Métriques SaaS">
                <field name="recorded_at"/>
                <field name="client_id"/>
                <field name="database_id"/>
                <field name="metric_type"/>
                <field name="value"/>
                <field name="unit"/>
            </list>
        </field>
    </record>

    <!-- Vue Recherche Métriques -->
    <record id="view_saas_metric_search" model="ir.ui.view">
        <field name="name">saas.metric.search</field>
        <field name="model">saas.metric</field>
        <field name="arch" type="xml">
            <search string="Métriques">
                <field name="client_id"/>
                <field name="metric_type"/>
                <filter string="Utilisateurs Actifs" name="users_active" domain="[('metric_type', '=', 'users_active')]"/>
                <filter string="Stockage" name="storage" domain="[('metric_type', '=', 'storage_used')]"/>
                <filter string="API Calls" name="api" domain="[('metric_type', '=', 'api_calls')]"/>
                <separator/>
                <filter string="Aujourd'hui" name="today"
                        domain="[('recorded_at', '&gt;=', (context_today()).strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter string="Cette Semaine" name="this_week"
                        domain="[('recorded_at', '&gt;=', (context_today() - relativedelta(weeks=1)).strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter string="Ce Mois" name="this_month"
                        domain="[('recorded_at', '&gt;=', (context_today() - relativedelta(months=1)).strftime('%Y-%m-%d 00:00:00'))]"/>
                <group expand="0" string="Grouper par">
                    <filter string="Client" name="group_client" context="{'group_by': 'client_id'}"/>
                    <filter string="Type de Métrique" name="group_type" context="{'group_by': 'metric_type'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'recorded_at:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action Métriques SaaS -->
    <record id="action_saas_metric" model="ir.actions.act_window">
        <field name="name">Métriques</field>
        <field name="res_model">saas.metric</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="context">{'search_default_this_month': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">
                Aucune métrique enregistrée
            </p>
            <p>
                Les métriques sont collectées automatiquement toutes les 5 minutes par le cron.
            </p>
        </field>
    </record>

</odoo>
