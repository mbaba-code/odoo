    <!-- Timeline -->
    <record id="action_reservations_this_week" model="ir.actions.act_window">
        <field name="name">This Week</field>
        <field name="res_model">onedesk.reservation</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="context">{'search_default_week': 1}</field>
