<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- DASHBOARD ACTIONS -->
    <record id="action_onedesk_dashboard" model="ir.actions.act_window">
        <field name="name">Tableau de bord</field>
        <field name="res_model">onedesk.dashboard</field>
        <field name="view_mode">form,list,kanban,pivot</field>
        <field name="context">{'default_user_id': uid}</field>
        <field name="view_ids" eval="[
            (5, 0),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_onedesk_dashboard_form')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_onedesk_dashboard_list')}),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_onedesk_dashboard_kanban')}),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_onedesk_dashboard_pivot')})
        ]"/>
    </record>

    <!-- SUBSCRIPTION PLAN ACTION -->
    <record id="action_onedesk_subscription_plan" model="ir.actions.act_window">
        <field name="name">Subscription Plans</field>
        <field name="res_model">onedesk.subscription.plan</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ==================== PROPERTIES ACTIONS ==================== -->
    <record id="action_onedesk_property" model="ir.actions.act_window">
        <field name="name">All Properties</field>
        <field name="res_model">onedesk.property</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="action_properties_active" model="ir.actions.act_window">
        <field name="name">Active Properties</field>
        <field name="res_model">onedesk.property</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="domain">[('active', '=', True)]</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>

    <record id="action_properties_inactive" model="ir.actions.act_window">
        <field name="name">Inactive Properties</field>
        <field name="res_model">onedesk.property</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="domain">[('active', '=', False)]</field>
    </record>

    <!-- ==================== UNITS ACTIONS ==================== -->
    <record id="action_onedesk_unit" model="ir.actions.act_window">
        <field name="name">All Units</field>
        <field name="res_model">onedesk.unit</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="action_units_by_property" model="ir.actions.act_window">
        <field name="name">Units by Property</field>
        <field name="res_model">onedesk.unit</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="context">{'group_by': 'property_id'}</field>
    </record>

    <record id="action_units_active" model="ir.actions.act_window">
        <field name="name">Available Units</field>
        <field name="res_model">onedesk.unit</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="domain">[('active', '=', True)]</field>
    </record>

    <record id="action_units_inactive" model="ir.actions.act_window">
        <field name="name">Inactive Units</field>
        <field name="res_model">onedesk.unit</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="domain">[('active', '=', False)]</field>
    </record>

    <record id="action_units_maintenance" model="ir.actions.act_window">
        <field name="name">Units in Maintenance</field>
        <field name="res_model">onedesk.unit</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="domain">[('maintenance_mode', '=', True)]</field>
    </record>

    <!-- ==================== RESERVATIONS ACTIONS ==================== -->
    <record id="action_onedesk_reservation" model="ir.actions.act_window">
        <field name="name">All Reservations</field>
        <field name="res_model">onedesk.reservation</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <!-- By Status -->
    <record id="action_reservations_pending" model="ir.actions.act_window">
