<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- DASHBOARD ACTIONS -->

    <!-- Action Client pour Dashboard Principal ApexCharts -->
    <record id="action_onedesk_dashboard_main_apexcharts" model="ir.actions.client">
        <field name="name">Dashboard Principal</field>
        <field name="tag">onedesk_dashboard_main</field>
        <field name="target">current</field>
    </record>

    <!-- Action Client pour Dashboard Admin Master -->
    <record id="action_onedesk_dashboard_admin_master" model="ir.actions.client">
        <field name="name">Dashboard Admin Master</field>
        <field name="tag">onedesk_dashboard_admin_master</field>
        <field name="target">current</field>
    </record>

    <!-- Action ancienne (garde pour compatibilité) -->
    <record id="action_onedesk_dashboard" model="ir.actions.act_window">
        <field name="name">Tableau de bord (Ancien)</field>
        <field name="res_model">onedesk.dashboard</field>
        <field name="view_mode">form,list,kanban,pivot</field>
        <field name="context">{'default_user_id': uid}</field>
        <field name="domain">[('user_id', '=', uid)]</field>
        <field name="view_ids" eval="[
            (5, 0),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_onedesk_dashboard_form')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_onedesk_dashboard_list')}),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_onedesk_dashboard_kanban')}),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_onedesk_dashboard_pivot')})
        ]"/>
    </record>

    <!-- ========================================
         DASHBOARD ACTIONS (for Tableau de bord menu)
         ======================================== -->

    <!-- 1. Réservations Dashboard -->
    <record id="action_reservation_dashboard" model="ir.actions.act_window">
        <field name="name">Réservations</field>
        <field name="res_model">onedesk.reservation</field>
        <field name="view_mode">kanban,list,calendar,graph,pivot</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">Créez une nouvelle réservation</p>
        </field>
    </record>

    <!-- 2. Propriétés Dashboard -->
    <record id="action_property_dashboard" model="ir.actions.act_window">
        <field name="name">Propriétés</field>
        <field name="res_model">onedesk.property</field>
        <field name="view_mode">kanban,list,calendar,graph,pivot</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">Créez une nouvelle propriété</p>
        </field>
    </record>

    <!-- 3. Revenus Dashboard (basé sur réservations avec focus finances) -->
    <record id="action_revenue_dashboard" model="ir.actions.act_window">
        <field name="name">Revenus</field>
        <field name="res_model">onedesk.reservation</field>
        <field name="view_mode">graph,pivot,list,kanban,calendar</field>
        <field name="context">{'default_view': 'graph'}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent">Aucune donnée de revenus</p>
        </field>
    </record>

    <!-- 4. Planning Dashboard (basé sur réservations avec focus calendrier) -->
    <record id="action_planning_dashboard" model="ir.actions.act_window">
        <field name="name">Planning</field>
        <field name="res_model">onedesk.reservation</field>
        <field name="view_mode">calendar,list,kanban,graph,pivot</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent">Aucune réservation planifiée</p>
        </field>
    </record>

    <!-- 5. Opérations Dashboard -->
    <record id="action_operation_dashboard" model="ir.actions.act_window">
        <field name="name">Opérations</field>
        <field name="res_model">onedesk.task</field>
        <field name="view_mode">kanban,list,calendar,graph,pivot</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">Créez une nouvelle tâche</p>
        </field>
    </record>

    <!-- 6. Équipe Dashboard -->
    <record id="action_team_dashboard" model="ir.actions.act_window">
        <field name="name">Équipe</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">kanban,list,graph,pivot</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent">Aucun utilisateur OneDesk</p>
        </field>
    </record>

    <!-- SUBSCRIPTION PLAN ACTION -->
    <record id="action_onedesk_subscription_plan" model="ir.actions.act_window">
        <field name="name">Subscription Plans</field>
        <field name="res_model">onedesk.subscription.plan</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ==================== PROPERTIES ACTIONS ==================== -->
    <record id="action_onedesk_property" model="ir.actions.act_window">
        <field name="name">All Properties</field>
        <field name="res_model">onedesk.property</field>
        <field name="view_mode">kanban,list,form</field>
