        <field name="view_mode">list,form,kanban</field>
        <field name="domain">[('status', '=', 'draft')]</field>
    </record>

    <record id="action_reservations_confirmed" model="ir.actions.act_window">
        <field name="name">Confirmed Reservations</field>
        <field name="res_model">onedesk.reservation</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="domain">[('status', '=', 'confirmed')]</field>
    </record>

    <record id="action_reservations_checkedin" model="ir.actions.act_window">
        <field name="name">Checked In</field>
        <field name="res_model">onedesk.reservation</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="domain">[('status', '=', 'checked_in')]</field>
