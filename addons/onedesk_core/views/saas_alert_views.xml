<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue Liste Alertes SaaS -->
    <record id="view_saas_alert_tree" model="ir.ui.view">
        <field name="name">saas.alert.tree</field>
        <field name="model">saas.alert</field>
        <field name="arch" type="xml">
            <tree string="Alertes SaaS" decoration-muted="resolved==True"
                  decoration-warning="severity=='warning' and resolved==False"
                  decoration-danger="severity in ['error', 'critical'] and resolved==False">
                <field name="created_at"/>
                <field name="client_id"/>
                <field name="alert_type"/>
                <field name="severity" widget="badge"
                       decoration-success="severity=='info'"
                       decoration-warning="severity=='warning'"
                       decoration-danger="severity in ['error', 'critical']"/>
                <field name="message"/>
                <field name="resolved" widget="boolean_toggle"/>
                <field name="notification_sent" widget="boolean_toggle"/>
                <button name="action_resolve" type="object" string="Résoudre" icon="fa-check"
                        attrs="{'invisible': [('resolved', '=', True)]}"/>
                <button name="action_send_notification" type="object" string="Notifier" icon="fa-envelope"
                        attrs="{'invisible': [('notification_sent', '=', True)]}"/>
            </tree>
        </field>
    </record>

    <!-- Vue Formulaire Alertes SaaS -->
    <record id="view_saas_alert_form" model="ir.ui.view">
        <field name="name">saas.alert.form</field>
        <field name="model">saas.alert</field>
        <field name="arch" type="xml">
            <form string="Alerte SaaS">
                <header>
                    <button name="action_resolve" type="object" string="Marquer comme Résolu"
                            class="oe_highlight" attrs="{'invisible': [('resolved', '=', True)]}"/>
                    <button name="action_send_notification" type="object" string="Envoyer Notification"
                            attrs="{'invisible': [('notification_sent', '=', True)]}"/>
                    <field name="severity" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="alert_type" class="oe_edit_only"/>
                        <h1><field name="alert_type"/></h1>
                    </div>
                    <group>
                        <group string="Informations">
                            <field name="client_id"/>
                            <field name="created_at" readonly="1"/>
                            <field name="resolved" readonly="1"/>
                        </group>
                        <group string="Notification">
                            <field name="notification_sent" readonly="1"/>
                            <field name="notification_sent_at" readonly="1" attrs="{'invisible': [('notification_sent', '=', False)]}"/>
                        </group>
                    </group>
                    <group string="Message">
                        <field name="message" nolabel="1"/>
                    </group>
                    <group string="Détails">
                        <field name="details" nolabel="1"/>
                    </group>
                    <group attrs="{'invisible': [('resolved', '=', False)]}">
                        <group string="Résolution">
                            <field name="resolved_by" readonly="1"/>
                            <field name="resolved_at" readonly="1"/>
                        </group>
                    </group>
                    <field name="resolution_notes" placeholder="Notes sur la résolution de l'alerte..."/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Vue Kanban Alertes SaaS -->
    <record id="view_saas_alert_kanban" model="ir.ui.view">
        <field name="name">saas.alert.kanban</field>
        <field name="model">saas.alert</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="severity">
                <field name="alert_type"/>
                <field name="severity"/>
                <field name="message"/>
                <field name="resolved"/>
                <field name="client_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click"
                             t-att-class="record.resolved.raw_value ? 'text-muted' : ''">
                            <div class="o_kanban_record_top mb-2">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title"><field name="alert_type"/></strong>
                                    <div class="text-muted"><field name="client_id"/></div>
                                </div>
                                <span class="float-end">
                                    <t t-if="record.resolved.raw_value">
                                        <span class="badge badge-success">Résolu</span>
                                    </t>
                                </span>
                            </div>
                            <div class="o_kanban_record_body">
                                <field name="message"/>
                                <div class="text-muted mt-2">
                                    <i class="fa fa-clock-o"/> <field name="created_at"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom mt-2">
                                <div class="oe_kanban_bottom_left">
                                    <t t-if="!record.resolved.raw_value">
                                        <button name="action_resolve" type="object" class="btn btn-sm btn-primary">
                                            Résoudre
                                        </button>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Vue Recherche Alertes -->
    <record id="view_saas_alert_search" model="ir.ui.view">
        <field name="name">saas.alert.search</field>
        <field name="model">saas.alert</field>
        <field name="arch" type="xml">
            <search string="Alertes">
                <field name="client_id"/>
                <field name="alert_type"/>
                <filter string="Non Résolues" name="unresolved" domain="[('resolved', '=', False)]"/>
                <filter string="Résolues" name="resolved" domain="[('resolved', '=', True)]"/>
                <separator/>
                <filter string="Critique" name="critical" domain="[('severity', '=', 'critical')]"/>
                <filter string="Erreur" name="error" domain="[('severity', '=', 'error')]"/>
                <filter string="Avertissement" name="warning" domain="[('severity', '=', 'warning')]"/>
                <separator/>
                <filter string="Quotas" name="quota" domain="[('alert_type', 'in', ['quota_users_exceeded', 'quota_storage_exceeded', 'quota_api_exceeded'])]"/>
                <filter string="Essai" name="trial" domain="[('alert_type', 'in', ['trial_ending_soon', 'trial_expired'])]"/>
                <separator/>
                <filter string="Notification Envoyée" name="notified" domain="[('notification_sent', '=', True)]"/>
                <group expand="0" string="Grouper par">
                    <filter string="Client" name="group_client" context="{'group_by': 'client_id'}"/>
                    <filter string="Type d'Alerte" name="group_type" context="{'group_by': 'alert_type'}"/>
                    <filter string="Sévérité" name="group_severity" context="{'group_by': 'severity'}"/>
                    <filter string="État" name="group_resolved" context="{'group_by': 'resolved'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action Alertes SaaS -->
    <record id="action_saas_alert" model="ir.actions.act_window">
        <field name="name">Alertes</field>
        <field name="res_model">saas.alert</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_unresolved': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucune alerte pour le moment
            </p>
            <p>
                Les alertes sont générées automatiquement pour les quotas dépassés,
                les essais arrivant à expiration, etc.
            </p>
        </field>
    </record>

</odoo>
