<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue Liste Alertes SaaS -->
    <record id="view_saas_alert_tree" model="ir.ui.view">
        <field name="name">saas.alert.tree</field>
        <field name="model">saas.alert</field>
        <field name="arch" type="xml">
            <list string="Alertes SaaS" decoration-muted="resolved==True"
                  decoration-warning="severity=='warning' and resolved==False"
                  decoration-danger="severity in ['error', 'critical'] and resolved==False">
                <field name="created_at"/>
                <field name="client_id"/>
                <field name="alert_type"/>
                <field name="severity" widget="badge"
                       decoration-success="severity=='info'"
                       decoration-warning="severity=='warning'"
                       decoration-danger="severity in ['error', 'critical']"/>
                <field name="message"/>
                <field name="resolved" widget="boolean_toggle"/>
                <field name="notification_sent" widget="boolean_toggle"/>
                <button name="action_resolve" type="object" string="Résoudre" icon="fa-check"
                        invisible="resolved"/>
                <button name="action_send_notification" type="object" string="Notifier" icon="fa-envelope"
                        invisible="notification_sent"/>
            </list>
        </field>
    </record>

    <!-- Vue Formulaire Alertes SaaS -->
    <record id="view_saas_alert_form" model="ir.ui.view">
        <field name="name">saas.alert.form</field>
        <field name="model">saas.alert</field>
        <field name="arch" type="xml">
            <form string="Alerte SaaS" class="o_form_saas_wrapper">
                <header>
                    <button name="action_resolve" type="object" string="Marquer comme Résolu"
                            class="oe_highlight" invisible="resolved"/>
                    <button name="action_send_notification" type="object" string="Envoyer Notification"
                            invisible="notification_sent"/>
                    <field name="severity" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="alert_type" class="oe_edit_only"/>
                        <h1><field name="alert_type"/></h1>
                    </div>
                    <group>
                        <group string="Informations">
                            <field name="client_id"/>
                            <field name="created_at" readonly="1"/>
                            <field name="resolved" readonly="1"/>
                        </group>
                        <group string="Notification">
                            <field name="notification_sent" readonly="1"/>
                            <field name="notification_sent_at" readonly="1" invisible="not notification_sent"/>
                        </group>
                    </group>
                    <group string="Message">
                        <field name="message" nolabel="1"/>
                    </group>
                    <group string="Détails">
                        <field name="details" nolabel="1"/>
                    </group>
                    <group invisible="not resolved">
                        <group string="Résolution">
                            <field name="resolved_by" readonly="1"/>
                            <field name="resolved_at" readonly="1"/>
                        </group>
                    </group>
                    <field name="resolution_notes" placeholder="Notes sur la résolution de l'alerte..."/>

                    <!-- Chatter -->
                    <div class="oe_chatter o_chatter_bottom w-100" style="margin-top: 40px; border-top: 2px solid #ddd; padding-top: 20px;">
                        <field name="message_follower_ids"/>
                        <field name="message_ids"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vue Kanban Alertes SaaS -->
    <record id="view_saas_alert_kanban" model="ir.ui.view">
        <field name="name">saas.alert.kanban</field>
        <field name="model">saas.alert</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="severity">
                <field name="alert_type"/>
                <field name="severity"/>
                <field name="message"/>
                <field name="resolved"/>
                <field name="client_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click"
                             t-att-class="record.resolved.raw_value ? 'text-muted' : ''">
                            <div class="o_kanban_record_top mb-2">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title"><field name="alert_type"/></strong>
                                    <div class="text-muted"><field name="client_id"/></div>
                                </div>
                                <span class="float-end">
                                    <t t-if="record.resolved.raw_value">
                                        <span class="badge badge-success">Résolu</span>
                                    </t>
                                </span>
                            </div>
                            <div class="o_kanban_record_body">
                                <field name="message"/>
                                <div class="text-muted mt-2">
                                    <i class="fa fa-clock-o" title="Date"/> <field name="created_at"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom mt-2">
                                <div class="oe_kanban_bottom_left">
                                    <t t-if="!record.resolved.raw_value">
                                        <button name="action_resolve" type="object" class="btn btn-sm btn-primary">
                                            Résoudre
                                        </button>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Vue Recherche Alertes -->
    <record id="view_saas_alert_search" model="ir.ui.view">
        <field name="name">saas.alert.search</field>
        <field name="model">saas.alert</field>
        <field name="arch" type="xml">
            <search>
                <field name="client_id"/>
                <field name="alert_type"/>
                <filter string="Non Résolues" name="unresolved" domain="[('resolved', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Action Alertes SaaS -->
    <!-- NOTE: action_saas_alert déplacée vers saas_menu.xml pour éviter problèmes de chargement -->

</odoo>
