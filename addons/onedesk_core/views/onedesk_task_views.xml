<odoo>
    <!-- Search view for filtering tasks -->
    <record id="view_onedesk_task_search" model="ir.ui.view">
        <field name="name">onedesk.task.search</field>
        <field name="model">onedesk.task</field>
        <field name="arch" type="xml">
            <search string="Tâches">
                <field name="name" string="Tâche"/>
                <field name="assigned_to" string="Assigné à"/>
                <field name="task_type" string="Type"/>
                <field name="status" string="Statut"/>
                <separator/>
                <!-- Filtres par Statut -->
                <filter string="À Faire" name="todo" domain="[('status', '=', 'todo')]"/>
                <filter string="En Cours" name="in_progress" domain="[('status', '=', 'in_progress')]"/>
                <filter string="Terminées" name="done" domain="[('status', '=', 'done')]"/>
                <separator/>
                <!-- Filtres Chronologie -->
                <filter string="Cette Semaine" name="this_week"
                    domain="[('date_start', '&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d')),
                             ('date_start', '&lt;=', (context_today() + datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <filter string="Ce Mois" name="this_month"
                    domain="[('date_start', '&gt;=', (context_today() - datetime.timedelta(days=30)).strftime('%Y-%m-%d')),
                             ('date_start', '&lt;=', (context_today() + datetime.timedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <filter string="À Venir" name="upcoming"
                    domain="[('date_start', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <!-- Filtres par Priorité -->
                <filter string="Haute Priorité" name="high_priority" domain="[('priority', '=', 'high')]"/>
                <filter string="Urgentes" name="urgent" domain="[('priority', '=', 'urgent')]"/>
            </search>
        </field>
    </record>

    <!-- Liste des tâches -->
    <record id="view_onedesk_task_list" model="ir.ui.view">
        <field name="name">onedesk.task.list</field>
        <field name="model">onedesk.task</field>
        <field name="arch" type="xml">
            <list string="Tâches du personnel">
                <field name="name"/>
                <field name="task_type"/>
                <field name="assigned_to"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="status"/>
                <field name="reservation_id"/>
            </list>
        </field>
    </record>

    <!-- Formulaire des tâches -->
    <record id="view_onedesk_task_form" model="ir.ui.view">
        <field name="name">onedesk.task.form</field>
        <field name="model">onedesk.task</field>
        <field name="arch" type="xml">
            <form string="Tâche du personnel">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="task_type"/>
                        <field name="assigned_to"/>
                        <field name="date_start"/>
                        <field name="date_end"/>
                        <field name="status"/>
                        <field name="reservation_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action pour accéder aux tâches -->
    <record id="action_onedesk_task" model="ir.actions.act_window">
        <field name="name">Tâches</field>
        <field name="res_model">onedesk.task</field>
        <field name="view_mode">kanban,list,form,calendar,graph,pivot</field>
    </record>

    <!-- Sous-menu sous OneDesk -->
    <menuitem id="menu_onedesk_task"
              name="Tâches"
              parent="menu_onedesk_root"
              action="action_onedesk_task"/>

    <!-- Vue calendrier -->
    <record id="view_onedesk_task_calendar" model="ir.ui.view">
        <field name="name">onedesk.task.calendar</field>
        <field name="model">onedesk.task</field>
        <field name="arch" type="xml">
            <calendar string="Tâches du personnel" date_start="date_start" date_stop="date_end">
                <field name="name"/>
                <field name="assigned_to"/>
            </calendar>
        </field>
    </record>

    <!-- Kanban View for Task Management -->
    <record id="view_onedesk_task_kanban" model="ir.ui.view">
        <field name="name">onedesk.task.kanban</field>
        <field name="model">onedesk.task</field>
        <field name="arch" type="xml">
            <kanban string="Tâches" default_group_by="status">
                <field name="id"/>
                <field name="name"/>
                <field name="status"/>
                <field name="assigned_to"/>
                <field name="priority"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card">
                            <div class="oe_kanban_global_click">
                                <h4><field name="name"/></h4>
                                <div>Assigné à: <field name="assigned_to"/></div>
                                <div>Priorité: <field name="priority"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Graph View for Task Analytics -->
    <record id="view_onedesk_task_graph" model="ir.ui.view">
        <field name="name">onedesk.task.graph</field>
        <field name="model">onedesk.task</field>
        <field name="arch" type="xml">
            <graph string="Tâches" type="bar">
                <field name="status" type="row"/>
                <field name="id" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Pivot View for Task Analysis -->
    <record id="view_onedesk_task_pivot" model="ir.ui.view">
        <field name="name">onedesk.task.pivot</field>
        <field name="model">onedesk.task</field>
        <field name="arch" type="xml">
            <pivot string="Tâches">
                <field name="status" type="row"/>
                <field name="assigned_to" type="column"/>
                <field name="id" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- ==================== ACTIONS PAR STATUT ==================== -->

    <!-- Tâches À Faire -->
    <record id="action_tasks_todo" model="ir.actions.act_window">
        <field name="name">Tâches À Faire</field>
        <field name="res_model">onedesk.task</field>
        <field name="view_mode">kanban,list,form,calendar</field>
        <field name="domain">[('status', '=', 'todo')]</field>
        <field name="context">{'default_status': 'todo'}</field>
    </record>

    <!-- Tâches En Cours -->
    <record id="action_tasks_in_progress" model="ir.actions.act_window">
        <field name="name">Tâches En Cours</field>
        <field name="res_model">onedesk.task</field>
        <field name="view_mode">kanban,list,form,calendar</field>
        <field name="domain">[('status', '=', 'in_progress')]</field>
        <field name="context">{'default_status': 'in_progress'}</field>
    </record>

    <!-- Tâches Terminées -->
    <record id="action_tasks_done" model="ir.actions.act_window">
        <field name="name">Tâches Terminées</field>
        <field name="res_model">onedesk.task</field>
        <field name="view_mode">kanban,list,form,calendar</field>
        <field name="domain">[('status', '=', 'done')]</field>
        <field name="context">{'default_status': 'done'}</field>
    </record>

    <!-- Tâches Bloquées (basé sur priorité urgent ou date dépassée) -->
    <record id="action_tasks_blocked" model="ir.actions.act_window">
        <field name="name">Tâches Bloquées</field>
        <field name="res_model">onedesk.task</field>
        <field name="view_mode">kanban,list,form,calendar</field>
        <field name="domain">[
            ('status', '!=', 'done'),
            ('priority', '=', 'urgent')
        ]</field>
    </record>

    <!-- Tâches En Retard -->
    <record id="action_tasks_overdue" model="ir.actions.act_window">
        <field name="name">Tâches En Retard</field>
        <field name="res_model">onedesk.task</field>
        <field name="view_mode">kanban,list,form,calendar</field>
        <field name="domain">[
            ('status', '!=', 'done'),
            ('date_end', '&lt;', context_today().strftime('%Y-%m-%d'))
        ]</field>
    </record>

    <!-- ==================== ACTIONS PAR PRIORITÉ ==================== -->

    <!-- Tâches Urgentes -->
    <record id="action_tasks_urgent" model="ir.actions.act_window">
        <field name="name">Tâches Urgentes</field>
        <field name="res_model">onedesk.task</field>
        <field name="view_mode">kanban,list,form,calendar</field>
        <field name="domain">[('priority', '=', 'urgent')]</field>
        <field name="context">{'default_priority': 'urgent'}</field>
    </record>

    <!-- Tâches Haute Priorité -->
    <record id="action_tasks_high" model="ir.actions.act_window">
        <field name="name">Tâches Haute Priorité</field>
        <field name="res_model">onedesk.task</field>
        <field name="view_mode">kanban,list,form,calendar</field>
        <field name="domain">[('priority', '=', 'high')]</field>
        <field name="context">{'default_priority': 'high'}</field>
    </record>

    <!-- Tâches Moyenne Priorité -->
    <record id="action_tasks_medium" model="ir.actions.act_window">
        <field name="name">Tâches Moyenne Priorité</field>
        <field name="res_model">onedesk.task</field>
        <field name="view_mode">kanban,list,form,calendar</field>
        <field name="domain">[('priority', '=', 'medium')]</field>
        <field name="context">{'default_priority': 'medium'}</field>
    </record>

    <!-- Tâches Basse Priorité -->
    <record id="action_tasks_low" model="ir.actions.act_window">
        <field name="name">Tâches Basse Priorité</field>
        <field name="res_model">onedesk.task</field>
        <field name="view_mode">kanban,list,form,calendar</field>
        <field name="domain">[('priority', '=', 'low')]</field>
        <field name="context">{'default_priority': 'low'}</field>
    </record>

    <!-- ==================== ACTIONS CHRONOLOGIE ==================== -->

    <!-- Tâches Aujourd'hui -->
    <record id="action_tasks_due_today" model="ir.actions.act_window">
        <field name="name">Tâches Aujourd'hui</field>
        <field name="res_model">onedesk.task</field>
        <field name="view_mode">kanban,list,form,calendar</field>
        <field name="domain">[
            '|',
            '&amp;',
            ('date_start', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')),
            ('date_start', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59')),
            '&amp;',
            ('date_end', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')),
            ('date_end', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))
        ]</field>
    </record>

    <!-- Tâches Cette Semaine -->
    <record id="action_tasks_due_this_week" model="ir.actions.act_window">
        <field name="name">Tâches Cette Semaine</field>
        <field name="res_model">onedesk.task</field>
        <field name="view_mode">kanban,list,form,calendar</field>
        <field name="context">{'search_default_this_week': 1}</field>
    </record>

    <!-- Tâches Ce Mois -->
    <record id="action_tasks_due_this_month" model="ir.actions.act_window">
        <field name="name">Tâches Ce Mois</field>
        <field name="res_model">onedesk.task</field>
        <field name="view_mode">kanban,list,form,calendar</field>
        <field name="context">{'search_default_this_month': 1}</field>
    </record>

</odoo>
