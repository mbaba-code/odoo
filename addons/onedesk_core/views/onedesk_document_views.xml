<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ========== DOCUMENT FORM VIEW ========== -->
    <record id="view_document_form" model="ir.ui.view">
        <field name="name">onedesk.document.form</field>
        <field name="model">onedesk.document</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_send_signature" type="object" string="📤 Envoyer pour signature"
                            class="btn-primary" invisible="status != 'draft'"/>
                    <button name="action_archive" type="object" string="📦 Archiver"
                            invisible="status != 'signed'"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="draft,pending_signature,signed,archived"/>
                </header>

                <sheet class="o_form_sheet_mobile">
                    <!-- Infos principales -->
                    <div class="o_notebook">
                        <group>
                            <field name="name" class="w-100"/>
                            <field name="document_type"/>
                            <field name="status" invisible="1"/>
                        </group>

                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="created_by" readonly="1"/>
                            <field name="date_created" readonly="1"/>
                        </group>
                    </div>

                    <!-- Document PDF -->
                    <separator string="📄 Document PDF"/>
                    <group>
                        <field name="file" widget="binary" filename="filename" class="w-100"/>
                        <field name="filename"/>
                    </group>

                    <!-- Relations contexte -->
                    <separator string="📍 Contexte"/>
                    <group col="2">
                        <field name="property_id"/>
                        <field name="unit_id"/>
                        <field name="reservation_id"/>
                        <field name="task_id"/>
                    </group>

                    <!-- Notes -->
                    <separator string="📝 Notes et observations"/>
                    <group>
                        <field name="notes" nolabel="1" class="w-100"/>
                    </group>

                    <!-- Signataires -->
                    <separator string="🔐 Signataires"/>
                    <group>
                        <field name="recipient_ids" nolabel="1" class="w-100"
                               widget="many2many" mode="tree"
                               context="{'default_company_id': company_id}"/>
                    </group>

                    <field name="signaturit_request_id" invisible="1"/>

                    <!-- Suivi des signatures -->
                    <separator string="✅ Suivi des signatures" invisible="status == 'draft'"/>
                    <group invisible="status == 'draft'">
                        <field name="signature_ids" nolabel="1" class="w-100" readonly="1"/>
                    </group>

                    <div class="alert alert-info" role="alert">
                        <p>💡 <strong>Pour signer:</strong> Sélectionnez les signataires, puis cliquez "📤 Envoyer pour signature"</p>
                    </div>
                </sheet>

                <div class="oe_chatter">
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ========== DOCUMENT LIST VIEW ========== -->
    <record id="view_document_list" model="ir.ui.view">
        <field name="name">onedesk.document.list</field>
        <field name="model">onedesk.document</field>
        <field name="arch" type="xml">
            <list decoration-success="status=='signed'" decoration-warning="status=='pending_signature'">
                <field name="name"/>
                <field name="document_type"/>
                <field name="status" widget="badge"/>
                <field name="created_by"/>
                <field name="date_created"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <!-- ========== DOCUMENT SEARCH VIEW ========== -->
    <record id="view_document_search" model="ir.ui.view">
        <field name="name">onedesk.document.search</field>
        <field name="model">onedesk.document</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="document_type"/>
                <field name="status"/>
                <field name="property_id"/>
                <field name="reservation_id"/>

                <separator/>
                <filter name="filter_draft" string="Brouillon" domain="[('status', '=', 'draft')]"/>
                <filter name="filter_pending" string="En attente" domain="[('status', '=', 'pending_signature')]"/>
                <filter name="filter_signed" string="Signés" domain="[('status', '=', 'signed')]"/>
                <filter name="filter_archived" string="Archivés" domain="[('status', '=', 'archived')]"/>
            </search>
        </field>
    </record>

    <!-- ========== DOCUMENT ACTION ========== -->
    <record id="action_document" model="ir.actions.act_window">
        <field name="name">Documents &amp; Signatures</field>
        <field name="res_model">onedesk.document</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_draft': 1}</field>
    </record>

    <!-- ========== MENU ITEM ========== -->
    <menuitem id="menu_document" name="📄 Documents" parent="onedesk_core.menu_onedesk_root"
              action="action_document" sequence="50"/>

</odoo>
