<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ========== DOCUMENT FORM VIEW (Signer Document) ========== -->
    <record id="view_document_form_sign" model="ir.ui.view">
        <field name="name">onedesk.document.form.sign</field>
        <field name="model">onedesk.document</field>
        <field name="arch" type="xml">
            <form class="o_form_document_wrapper">
                <header>
                    <field name="status" widget="statusbar"
                           statusbar_visible="draft,pending_signature,signed,archived"/>
                </header>

                <sheet class="o_form_document_wrapper">
                    <!-- Row 1: Document Info -->
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <strong>📄 Titre</strong>
                            <field name="name" placeholder="Nom du document"/>
                        </div>
                        <div class="col-md-6">
                            <strong>📋 Type</strong>
                            <field name="document_type"/>
                        </div>
                    </div>

                    <!-- Row 2: PDF File -->
                    <div class="row mb-4">
                        <div class="col-md-12">
                            <strong>📁 Fichier PDF</strong>
                            <div class="alert alert-warning mb-2" style="margin-bottom: 10px;">
                                💾 Téléchargez le PDF, puis cliquez Enregistrer avant d'ajouter les signataires.
                            </div>
                            <field name="file" widget="binary" filename="filename" class="w-100"
                                   options="{'no_open': True}" accept="application/pdf"/>
                            <field name="filename" invisible="1"/>
                        </div>
                    </div>

                    <!-- Row 3: Signers -->
                    <div class="row mb-4">
                        <div class="col-md-12">
                            <strong>🔐 Signataires (Obligatoire)</strong>
                            <div class="alert alert-danger mb-2">⚠️ Au moins 1 signataire requis!</div>
                            <field name="partner_signer_ids" nolabel="1"
                                   widget="many2many_tags"
                                   placeholder="Sélectionnez les contacts..."/>
                        </div>
                    </div>

                    <!-- Row 4: Additional Signers -->
                    <div class="row mb-4">
                        <div class="col-md-12">
                            <strong>➕ Autres signataires</strong>
                            <field name="recipient_ids" nolabel="1"
                                   widget="many2many_tags"
                                   placeholder="Ajoutez d'autres signataires..."/>
                        </div>
                    </div>

                    <!-- Row 4.5: Action Buttons -->
                    <div class="row mb-4" invisible="status != 'draft'">
                        <div class="col-md-12">
                            <div class="d-flex gap-2">
                                <button name="action_send_signature" type="object"
                                        string="✍️ Envoyer pour signature"
                                        class="btn btn-primary btn-lg"/>
                                <button name="action_signaturit_beta" type="object"
                                        string="🌐 SignaturIT (Beta)"
                                        class="btn btn-secondary btn-lg" readonly="1"/>
                                <button name="action_download" type="object"
                                        string="⬇️ Voir/Télécharger PDF"
                                        invisible="not file"
                                        class="btn btn-info btn-lg"/>
                            </div>
                        </div>
                    </div>

                    <!-- Row 5: Signature Tracking -->
                    <div class="row" invisible="status == 'draft'">
                        <div class="col-md-12">
                            <strong>✅ Suivi des signatures</strong>
                            <field name="signature_ids" nolabel="1" readonly="1" widget="one2many" mode="list"/>
                        </div>
                    </div>

                    <!-- Chatter -->
                    <div class="oe_chatter o_chatter_bottom w-100" style="margin-top: 40px; border-top: 2px solid #ddd; padding-top: 20px;">
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ========== DOCUMENT FORM VIEW (Stocker Document) ========== -->
    <record id="view_document_form_store" model="ir.ui.view">
        <field name="name">onedesk.document.form.store</field>
        <field name="model">onedesk.document</field>
        <field name="arch" type="xml">
            <form class="o_form_document_wrapper">
                <header>
                    <button name="action_download" type="object" string="⬇️ Télécharger"
                            invisible="not file" class="btn-info"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="draft,pending_signature,signed,archived"/>
                </header>

                <sheet class="o_document_sheet">
                    <!-- Row 1: Document Info -->
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <strong>📄 Titre</strong>
                            <field name="name" placeholder="Nom du document"/>
                        </div>
                        <div class="col-md-6">
                            <strong>📋 Type</strong>
                            <field name="document_type"/>
                        </div>
                    </div>

                    <!-- Row 2: PDF File -->
                    <div class="row mb-4">
                        <div class="col-md-12">
                            <strong>📁 Fichier PDF</strong>
                            <div class="alert alert-warning mb-2">💾 Téléchargez le PDF et cliquez Enregistrer.</div>
                            <field name="file" widget="binary" filename="filename" class="w-100"
                                   options="{'no_open': True}" accept="application/pdf"/>
                            <field name="filename" invisible="1"/>
                        </div>
                    </div>

                    <!-- Row 2.5: PDF Signé (si disponible) -->
                    <div class="row mb-4" invisible="not signed_file">
                        <div class="col-md-12">
                            <strong>✅ Document Signé (avec signatures incrustées)</strong>
                            <div class="alert alert-success mb-2">
                                📄 Ce document contient toutes les signatures électroniques incrustées sur le PDF
                            </div>
                            <field name="signed_file" widget="binary" filename="signed_filename" class="w-100"
                                   options="{'no_open': True}"/>
                            <field name="signed_filename" invisible="1"/>
                        </div>
                    </div>

                    <!-- Row 3: Classification -->
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <strong>📂 Catégorie</strong>
                            <field name="document_category"/>
                        </div>
                        <div class="col-md-6">
                            <strong>📍 Localisation</strong>
                            <field name="storage_location" placeholder="Ex: Dossier Principal..."/>
                        </div>
                    </div>

                    <!-- Row 4: Tags -->
                    <div class="row mb-4">
                        <div class="col-md-12">
                            <strong>🏷️ Étiquettes</strong>
                            <field name="document_tags" nolabel="1" widget="many2many_tags"/>
                        </div>
                    </div>

                    <!-- Row 5: Notes -->
                    <div class="row mb-4">
                        <div class="col-md-12">
                            <strong>📝 Notes</strong>
                            <field name="notes" nolabel="1" placeholder="Observations..." class="w-100"/>
                        </div>
                    </div>

                    <!-- Chatter -->
                    <div class="oe_chatter o_chatter_bottom w-100" style="margin-top: 40px; border-top: 2px solid #ddd; padding-top: 20px;">
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ========== DOCUMENT LIST VIEW (Signer) ========== -->
    <record id="view_document_list_sign" model="ir.ui.view">
        <field name="name">onedesk.document.list.sign</field>
        <field name="model">onedesk.document</field>
        <field name="arch" type="xml">
            <list decoration-success="status=='signed'" decoration-warning="status=='pending_signature'">
                <field name="name" string="📄 Document"/>
                <field name="document_type" string="📋 Type"/>
                <field name="status" widget="badge" string="📍 Statut"/>
                <field name="date_created" string="📅 Date"/>
            </list>
        </field>
    </record>

    <!-- ========== DOCUMENT LIST VIEW (Stocker) ========== -->
    <record id="view_document_list_store" model="ir.ui.view">
        <field name="name">onedesk.document.list.store</field>
        <field name="model">onedesk.document</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" string="📄 Document"/>
                <field name="document_type" string="📋 Type"/>
                <field name="date_created" string="📅 Date"/>
            </list>
        </field>
    </record>

    <!-- ========== DOCUMENT KANBAN VIEW (Signer) ========== -->
    <record id="view_document_kanban_sign" model="ir.ui.view">
        <field name="name">onedesk.document.kanban.sign</field>
        <field name="model">onedesk.document</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" class="o_kanban_small_column">
                <field name="id"/>
                <field name="name"/>
                <field name="status"/>
                <field name="document_type"/>
                <field name="date_created"/>

                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_headings mb-3">
                                <strong class="o_kanban_record_title"><t t-esc="record.name.value"/></strong>
                            </div>
                            <div class="o_kanban_record_body">
                                <div class="mb-2">
                                    <span class="badge badge-primary"><t t-esc="record.document_type.value"/></span>
                                </div>
                                <div class="small text-muted">
                                    📅 <t t-esc="record.date_created.value"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ========== DOCUMENT KANBAN VIEW (Stocker) ========== -->
    <record id="view_document_kanban_store" model="ir.ui.view">
        <field name="name">onedesk.document.kanban.store</field>
        <field name="model">onedesk.document</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column">
                <field name="id"/>
                <field name="name"/>
                <field name="document_type"/>
                <field name="date_created"/>

                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_headings mb-3">
                                <strong class="o_kanban_record_title"><t t-esc="record.name.value"/></strong>
                            </div>
                            <div class="o_kanban_record_body">
                                <div class="mb-2">
                                    <span class="badge badge-primary"><t t-esc="record.document_type.value"/></span>
                                </div>
                                <div class="small text-muted">
                                    📅 <t t-esc="record.date_created.value"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ========== DOCUMENT SEARCH VIEW ========== -->
    <record id="view_document_search" model="ir.ui.view">
        <field name="name">onedesk.document.search</field>
        <field name="model">onedesk.document</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="document_type"/>
                <field name="status"/>
                <field name="document_category"/>
                <field name="property_id"/>
                <field name="reservation_id"/>

                <separator/>
                <filter name="filter_draft" string="Brouillon" domain="[('status', '=', 'draft')]"/>
                <filter name="filter_pending" string="En attente" domain="[('status', '=', 'pending_signature')]"/>
                <filter name="filter_signed" string="Signés" domain="[('status', '=', 'signed')]"/>
                <filter name="filter_archived" string="Archivés" domain="[('status', '=', 'archived')]"/>
            </search>
        </field>
    </record>

    <!-- ========== DOCUMENT ALL ACTION ========== -->
    <record id="action_document_all" model="ir.actions.act_window">
        <field name="name">📄 Tous les documents</field>
        <field name="res_model">onedesk.document</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <!-- ========== ACTION: Signer Document ========== -->
    <record id="action_document_sign" model="ir.actions.act_window">
        <field name="name">✍️ Signer Document</field>
        <field name="res_model">onedesk.document</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_document_list_sign')}),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_document_kanban_sign')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_document_form_sign')}),
        ]"/>
        <field name="domain">[('document_category', '=', False)]</field>
    </record>

    <!-- ========== ACTION: Stocker Document ========== -->
    <record id="action_document_store" model="ir.actions.act_window">
        <field name="name">📦 Stocker Document</field>
        <field name="res_model">onedesk.document</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_document_list_store')}),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_document_kanban_store')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_document_form_store')}),
        ]"/>
        <field name="context">{'default_document_category': 'other'}</field>
    </record>

    <!-- ========== MENU: Parent ========== -->
    <menuitem id="menu_document" name="📄 Documents" parent="onedesk_core.menu_onedesk_root"
              action="onedesk_core.action_document_all" sequence="50"/>

    <!-- ========== MENU: Signer Document ========== -->
    <menuitem id="menu_document_sign" name="✍️ Signer Document" parent="menu_document"
              action="onedesk_core.action_document_sign" sequence="1"/>

    <!-- ========== MENU: Stocker Document ========== -->
    <menuitem id="menu_document_store" name="📦 Stocker Document" parent="menu_document"
              action="onedesk_core.action_document_store" sequence="2"/>

    <!-- ========== TAG FORM VIEW ========== -->
    <record id="view_document_tag_form" model="ir.ui.view">
        <field name="name">onedesk.document.tag.form</field>
        <field name="model">onedesk.document.tag</field>
        <field name="arch" type="xml">
            <form class="o_form_document_tag_wrapper">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nom de l'étiquette..."/></h1>
                    </div>
                    <group col="2">
                        <field name="color"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ========== TAG LIST VIEW ========== -->
    <record id="view_document_tag_list" model="ir.ui.view">
        <field name="name">onedesk.document.tag.list</field>
        <field name="model">onedesk.document.tag</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="color"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- ========== TAG SEARCH VIEW ========== -->
    <record id="view_document_tag_search" model="ir.ui.view">
        <field name="name">onedesk.document.tag.search</field>
        <field name="model">onedesk.document.tag</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <separator/>
                <filter name="filter_active" string="Actif" domain="[('active', '=', True)]"/>
                <filter name="filter_inactive" string="Inactif" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- ========== TAG ACTION ========== -->
    <record id="action_document_tag" model="ir.actions.act_window">
        <field name="name">Tags/Étiquettes</field>
        <field name="res_model">onedesk.document.tag</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ========== TAG MENU ========== -->
    <menuitem id="menu_document_tag" name="🏷️ Tags" parent="menu_document"
              action="onedesk_core.action_document_tag" sequence="10"/>

</odoo>
