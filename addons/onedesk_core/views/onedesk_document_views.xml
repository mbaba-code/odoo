<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ========== DOCUMENT FORM VIEW ========== -->
    <record id="view_document_form" model="ir.ui.view">
        <field name="name">onedesk.document.form</field>
        <field name="model">onedesk.document</field>
        <field name="arch" type="xml">
            <form class="o_form_document_wrapper">
                <header>
                    <button name="action_send_signature" type="object" string="📤 Envoyer pour signature"
                            class="btn-primary" invisible="status != 'draft'"/>
                    <button name="action_archive" type="object" string="📦 Archiver"
                            invisible="status != 'signed'"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="draft,pending_signature,signed,archived"/>
                </header>

                <sheet class="o_document_sheet">
                    <!-- Infos principales -->
                    <h3 class="mb-2">📄 Infos du document</h3>
                    <group col="2" class="mb-4">
                        <field name="name"/>
                        <field name="document_type"/>
                        <field name="signing_method" invisible="status != 'draft'"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="created_by" readonly="1"/>
                    </group>

                    <!-- PDF Upload -->
                    <h3 class="mt-4 mb-2">📁 Fichier PDF</h3>
                    <group col="2" class="mb-4">
                        <field name="file" widget="binary" filename="filename"/>
                        <field name="filename"/>
                    </group>

                    <!-- Notes -->
                    <h3 class="mt-4 mb-2">📝 Notes</h3>
                    <group col="1" class="mb-4">
                        <field name="notes" nolabel="1" placeholder="Observations ou instructions..." class="w-100"/>
                    </group>

                    <!-- Context -->
                    <h3 class="mt-4 mb-2">📍 Contexte</h3>
                    <group col="2" class="mb-4">
                        <field name="property_id"/>
                        <field name="unit_id"/>
                        <field name="reservation_id"/>
                        <field name="task_id"/>
                    </group>

                    <!-- Signataires -->
                    <h3 class="mt-4 mb-2">🔐 Signataires</h3>

                    <!-- Source 1: Contacts Odoo -->
                    <group col="1" class="mb-3">
                        <label for="partner_signer_ids" string="👥 Contacts Odoo" class="d-block"/>
                        <field name="partner_signer_ids" nolabel="1"
                               widget="many2many_tags"
                               placeholder="Recherchez et sélectionnez les contacts..."/>
                    </group>

                    <!-- Source 2: Autres signataires -->
                    <group col="1" class="mb-3">
                        <label for="recipient_ids" string="✏️ Autres signataires" class="d-block"/>
                        <field name="recipient_ids" nolabel="1"
                               widget="many2many_tags"
                               placeholder="Ou ajoutez d'autres signataires..."/>
                    </group>

                    <div class="alert alert-info mb-4" role="alert">
                        <p class="mb-1"><strong>📋 Comment ça marche:</strong></p>
                        <ul style="margin-bottom: 0;">
                            <li>✅ Sélectionnez les signataires ci-dessus</li>
                            <li>✅ Cliquez "📤 Envoyer pour signature" en haut</li>
                            <li>✅ Les signataires reçoivent un email</li>
                            <li>✅ Le statut se met à jour automatiquement</li>
                        </ul>
                    </div>

                    <!-- Suivi des signatures -->
                    <div invisible="status == 'draft'" class="mt-4">
                        <h3 class="mb-2">✅ Suivi des signatures</h3>
                        <group col="1">
                            <field name="signature_ids" nolabel="1"
                                   readonly="1" widget="one2many" mode="list"/>
                        </group>
                    </div>

                    <!-- Chatter/Messages - INSIDE sheet to stay below content -->
                    <div class="oe_chatter o_chatter_bottom w-100" style="margin-top: 40px; border-top: 2px solid #ddd; padding-top: 20px;">
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>


    <!-- ========== DOCUMENT KANBAN VIEW ========== -->
    <record id="view_document_kanban" model="ir.ui.view">
        <field name="name">onedesk.document.kanban</field>
        <field name="model">onedesk.document</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" class="o_kanban_small_column">
                <field name="id"/>
                <field name="name"/>
                <field name="status"/>
                <field name="document_type"/>
                <field name="created_by"/>
                <field name="date_created"/>
                <field name="company_id"/>
                <field name="partner_signer_ids"/>
                <field name="recipient_ids"/>

                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <!-- Card Header -->
                            <div class="o_kanban_record_headings">
                                <strong class="o_kanban_record_title">
                                    <t t-esc="record.name.value"/>
                                </strong>
                            </div>

                            <!-- Document Type Badge -->
                            <div class="o_kanban_record_body">
                                <div class="mb-2">
                                    <span class="badge badge-primary">
                                        <t t-esc="record.document_type.value"/>
                                    </span>
                                </div>

                                <!-- Signers Count -->
                                <div class="mb-2 small">
                                    <i class="fa fa-users"/>
                                    <t t-set="signer_count" t-value="(record.partner_signer_ids.value || []).length + (record.recipient_ids.value || []).length"/>
                                    <span><t t-esc="signer_count"/> signataire(s)</span>
                                </div>

                                <!-- Created info -->
                                <div class="mb-2 small text-muted">
                                    <i class="fa fa-user-circle"/>
                                    <t t-esc="record.created_by.value"/>
                                </div>

                                <!-- Date -->
                                <div class="small text-muted">
                                    <i class="fa fa-calendar"/>
                                    <t t-esc="record.date_created.value"/>
                                </div>
                            </div>

                            <!-- Footer with Company -->
                            <div class="o_kanban_record_footer mt-2">
                                <small class="text-muted">
                                    <t t-esc="record.company_id.value"/>
                                </small>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ========== DOCUMENT LIST VIEW ========== -->
    <record id="view_document_list" model="ir.ui.view">
        <field name="name">onedesk.document.list</field>
        <field name="model">onedesk.document</field>
        <field name="arch" type="xml">
            <list decoration-success="status=='signed'" decoration-warning="status=='pending_signature'">
                <field name="name"/>
                <field name="document_type"/>
                <field name="status" widget="badge"/>
                <field name="created_by"/>
                <field name="date_created"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <!-- ========== DOCUMENT SEARCH VIEW ========== -->
    <record id="view_document_search" model="ir.ui.view">
        <field name="name">onedesk.document.search</field>
        <field name="model">onedesk.document</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="document_type"/>
                <field name="status"/>
                <field name="property_id"/>
                <field name="reservation_id"/>

                <separator/>
                <filter name="filter_draft" string="Brouillon" domain="[('status', '=', 'draft')]"/>
                <filter name="filter_pending" string="En attente" domain="[('status', '=', 'pending_signature')]"/>
                <filter name="filter_signed" string="Signés" domain="[('status', '=', 'signed')]"/>
                <filter name="filter_archived" string="Archivés" domain="[('status', '=', 'archived')]"/>
            </search>
        </field>
    </record>

    <!-- ========== DOCUMENT ACTION ========== -->
    <record id="action_document" model="ir.actions.act_window">
        <field name="name">Documents &amp; Signatures</field>
        <field name="res_model">onedesk.document</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_filter_draft': 1}</field>
    </record>

    <!-- ========== MENU ITEM ========== -->
    <menuitem id="menu_document" name="📄 Documents" parent="onedesk_core.menu_onedesk_root"
              action="action_document" sequence="50"/>

</odoo>
