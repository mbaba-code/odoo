<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        VUES SAAS RATE LIMITING

        Monitoring des tentatives de provisioning et protection DoS
        Accessible uniquement aux SaaS Managers et System Admins
    -->

    <!-- Tree View: Liste des Rate Limits -->
    <record id="view_saas_rate_limit_tree" model="ir.ui.view">
        <field name="name">saas.rate_limit.tree</field>
        <field name="model">saas.rate_limit</field>
        <field name="arch" type="xml">
            <tree string="Rate Limiting" default_order="window_start desc" decoration-danger="is_blocked">
                <field name="window_start"/>
                <field name="ip_address"/>
                <field name="user_id"/>
                <field name="request_count"/>
                <field name="is_blocked"/>
                <field name="blocked_until" optional="show"/>
                <field name="attempts_blocked" optional="hide"/>
                <field name="last_attempt"/>
            </tree>
        </field>
    </record>

    <!-- Form View: Détails d'un Rate Limit -->
    <record id="view_saas_rate_limit_form" model="ir.ui.view">
        <field name="name">saas.rate_limit.form</field>
        <field name="model">saas.rate_limit</field>
        <field name="arch" type="xml">
            <form string="Rate Limit Details" create="false" edit="false">
                <header>
                    <field name="is_blocked" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="ip_address" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group name="identification" string="Identification">
                            <field name="ip_address" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                        </group>
                        <group name="counters" string="Compteurs">
                            <field name="request_count" readonly="1"/>
                            <field name="attempts_blocked" readonly="1"/>
                            <field name="window_start" readonly="1"/>
                            <field name="last_attempt" readonly="1"/>
                        </group>
                    </group>

                    <group name="blocking" string="Blocage" attrs="{'invisible': [('is_blocked', '=', False)]}">
                        <field name="is_blocked" readonly="1"/>
                        <field name="blocked_until" readonly="1"/>
                        <field name="blocked_reason" readonly="1"/>
                    </group>

                    <notebook>
                        <page string="Informations de Sécurité">
                            <group>
                                <p class="alert alert-info" role="alert">
                                    <strong>Rate Limiting Configuration:</strong><br/>
                                    • Maximum: 5 provisionings par heure par IP<br/>
                                    • Blocage: 1 heure après dépassement<br/>
                                    • Blocage étendu: 24h après 3 dépassements en 24h<br/>
                                    • Conservation: 7 jours (records normaux), 30 jours (bloqués)
                                </p>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View: Filtres et recherches -->
    <record id="view_saas_rate_limit_search" model="ir.ui.view">
        <field name="name">saas.rate_limit.search</field>
        <field name="model">saas.rate_limit</field>
        <field name="arch" type="xml">
            <search string="Rechercher Rate Limits">
                <field name="ip_address"/>
                <field name="user_id"/>

                <filter string="Actuellement Bloqués" name="filter_blocked"
                        domain="[('is_blocked', '=', True), ('blocked_until', '>', context_today())]"/>
                <filter string="Historique Bloqués" name="filter_was_blocked"
                        domain="[('is_blocked', '=', True)]"/>
                <filter string="Non Bloqués" name="filter_not_blocked"
                        domain="[('is_blocked', '=', False)]"/>

                <separator/>
                <filter string="Dernière Heure" name="filter_last_hour"
                        domain="[('window_start', '&gt;=', (datetime.datetime.now() - datetime.timedelta(hours=1)))]"/>
                <filter string="Dernières 24h" name="filter_last_day"
                        domain="[('window_start', '&gt;=', (datetime.datetime.now() - datetime.timedelta(days=1)))]"/>
                <filter string="Derniers 7 jours" name="filter_last_week"
                        domain="[('window_start', '&gt;=', (datetime.datetime.now() - datetime.timedelta(days=7)))]"/>

                <group expand="0" string="Grouper par">
                    <filter string="IP" name="group_ip" context="{'group_by': 'ip_address'}"/>
                    <filter string="Utilisateur" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Bloqué" name="group_blocked" context="{'group_by': 'is_blocked'}"/>
                    <filter string="Fenêtre" name="group_window" context="{'group_by': 'window_start'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action: Ouvrir la liste des Rate Limits -->
    <record id="action_saas_rate_limit" model="ir.actions.act_window">
        <field name="name">Rate Limiting</field>
        <field name="res_model">saas.rate_limit</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_filter_last_day': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucun enregistrement de rate limiting
            </p>
            <p>
                Le système de rate limiting protège contre les attaques DoS en limitant
                le nombre de provisionings par IP/heure.
            </p>
            <p>
                Les enregistrements apparaîtront ici lorsque des clients seront provisionnés.
            </p>
        </field>
    </record>

    <!-- Menu: Rate Limiting (dans le menu SaaS Manager) -->
    <menuitem id="menu_saas_rate_limit"
              name="Rate Limiting"
              parent="onedesk_core.menu_saas_root"
              action="action_saas_rate_limit"
              sequence="60"
              groups="base.group_system,onedesk_core.group_saas_manager"/>

</odoo>
