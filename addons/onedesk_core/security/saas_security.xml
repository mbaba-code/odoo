<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        RECORD RULES POUR MODÈLES SAAS

        SÉCURITÉ CRITIQUE: Ces modèles gèrent l'infrastructure SaaS multi-tenant.
        Seuls les SaaS Managers (admins du système principal) doivent y avoir accès.
        Les clients dans leurs bases isolées ne doivent JAMAIS accéder à ces modèles.
    -->

    <!-- ================== SAAS CLIENT ACCESS ================== -->

    <!-- System Admin: Full access to all SaaS clients -->
    <record id="rule_system_admin_saas_client" model="ir.rule">
        <field name="name">System Admin - All SaaS Clients</field>
        <field name="model_id" ref="model_saas_client"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        <field name="perm_read">True</field>
        <field name="perm_write">True</field>
        <field name="perm_create">True</field>
        <field name="perm_unlink">True</field>
    </record>

    <!-- SaaS Manager: Full access to all SaaS clients -->
    <record id="rule_saas_manager_saas_client" model="ir.rule">
        <field name="name">SaaS Manager - All SaaS Clients</field>
        <field name="model_id" ref="model_saas_client"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_saas_manager'))]"/>
        <field name="perm_read">True</field>
        <field name="perm_write">True</field>
        <field name="perm_create">True</field>
        <field name="perm_unlink">False</field>
    </record>

